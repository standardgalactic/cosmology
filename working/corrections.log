": 3140.3999999999996, "end": 3141.16, "text": " highly warranted", "tokens": [51574, 5405, 16354, 292, 51612], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1043, "seek": 311622, "start": 3141.16, "end": 3142.16, "text": " skeptical response.", "tokens": [51612, 28601, 4134, 13, 51662], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1044, "seek": 311622, "start": 3142.7999999999997, "end": 3143.66, "text": " But here's why", "tokens": [51694, 583, 510, 311, 983, 51737], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1045, "seek": 311622, "start": 3143.66, "end": 3144.56, "text": " this is so profound.", "tokens": [51737, 341, 307, 370, 14382, 13, 51782], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1046, "seek": 314456, "start": 3144.56, "end": 3146.7799999999997, "text": " There are no dials to tune.", "tokens": [50365, 821, 366, 572, 5502, 82, 281, 10864, 13, 50476], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1047, "seek": 314456, "start": 3147.42, "end": 3149.14, "text": " In order for the dimension zero scalars", "tokens": [50508, 682, 1668, 337, 264, 10139, 4018, 15664, 685, 50594], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1048, "seek": 314456, "start": 3149.14, "end": 3149.86, "text": " to leave behind", "tokens": [50594, 281, 1856, 2261, 50630], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1049, "seek": 314456, "start": 3149.86, "end": 3151.16, "text": " a perfectly stable vacuum,", "tokens": [50630, 257, 6239, 8351, 14224, 11, 50695], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1050, "seek": 314456, "start": 3151.64, "end": 3152.7, "text": " their gauge symmetries", "tokens": [50719, 641, 17924, 14232, 302, 2244, 50772], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1051, "seek": 314456, "start": 3152.7, "end": 3154.2999999999997, "text": " must be mathematically exact.", "tokens": [50772, 1633, 312, 44003, 1900, 13, 50852], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1052, "seek": 314456, "start": 3154.98, "end": 3155.98, "text": " And for the vacuum energy", "tokens": [50886, 400, 337, 264, 14224, 2281, 50936], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1053, "seek": 314456, "start": 3155.98, "end": 3157.04, "text": " and the whale anomaly", "tokens": [50936, 293, 264, 25370, 42737, 50989], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1054, "seek": 314456, "start": 3157.04, "end": 3158.72, "text": " to perfectly cancel out to zero", "tokens": [50989, 281, 6239, 10373, 484, 281, 4018, 51073], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1055, "seek": 314456, "start": 3158.72, "end": 3159.96, "text": " at the origin of the universe,", "tokens": [51073, 412, 264, 4957, 295, 264, 6445, 11, 51135], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1056, "seek": 314456, "start": 3160.44, "end": 3161.7, "text": " the topological requirements", "tokens": [51159, 264, 1192, 4383, 7728, 51222], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1057, "seek": 314456, "start": 3161.7, "end": 3162.34, "text": " of the mathematics", "tokens": [51222, 295, 264, 18666, 51254], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1058, "seek": 314456, "start": 3162.34, "end": 3163.56, "text": " are incredibly rigid.", "tokens": [51254, 366, 6252, 22195, 13, 51315], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1059, "seek": 314456, "start": 3164.0, "end": 3165.2599999999998, "text": " The coefficients of the anomaly", "tokens": [51337, 440, 31994, 295, 264, 42737, 51400], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1060, "seek": 314456, "start": 3165.2599999999998, "end": 3166.16, "text": " are determined strictly", "tokens": [51400, 366, 9540, 20792, 51445], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1061, "seek": 314456, "start": 3166.16, "end": 3166.82, "text": " by the spin", "tokens": [51445, 538, 264, 6060, 51478], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1062, "seek": 314456, "start": 3166.82, "end": 3168.32, "text": " and number of the fields involved.", "tokens": [51478, 293, 1230, 295, 264, 7909, 3288, 13, 51553], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1063, "seek": 314456, "start": 3168.7999999999997, "end": 3170.22, "text": " It is an algebraic lock.", "tokens": [51577, 467, 307, 364, 21989, 299, 4017, 13, 51648], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1064, "seek": 314456, "start": 3170.96, "end": 3172.04, "text": " When you set the equations", "tokens": [51685, 1133, 291, 992, 264, 11787, 51739], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1065, "seek": 314456, "start": 3172.04, "end": 3174.2599999999998, "text": " to demand total anomaly cancellation,", "tokens": [51739, 281, 4733, 3217, 42737, 45867, 11, 51850], "temperature": 0.0, "avg_logprob": -0.15047903855641684, "compression_ratio": 1.749185667752443, "no_speech_prob": 2.060289655894665e-12}, {"id": 1066, "seek": 317456, "start": 3174.56, "end": 3176.02, "text": " the algebra spits out", "tokens": [50365, 264, 21989, 637, 1208, 484, 50438], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1067, "seek": 317456, "start": 3176.02, "end": 3176.88, "text": " a strict requirement.", "tokens": [50438, 257, 10910, 11695, 13, 50481], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1068, "seek": 317456, "start": 3177.4, "end": 3178.34, "text": " The universe must contain", "tokens": [50507, 440, 6445, 1633, 5304, 50554], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1069, "seek": 317456, "start": 3178.34, "end": 3179.66, "text": " exactly three generations", "tokens": [50554, 2293, 1045, 10593, 50620], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1070, "seek": 317456, "start": 3179.66, "end": 3181.2599999999998, "text": " of standard model fermions.", "tokens": [50620, 295, 3832, 2316, 26558, 626, 13, 50700], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1071, "seek": 317456, "start": 3181.54, "end": 3182.34, "text": " Meaning if there were", "tokens": [50714, 19948, 498, 456, 645, 50754], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1072, "seek": 317456, "start": 3182.34, "end": 3183.32, "text": " four generations", "tokens": [50754, 1451, 10593, 50803], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1073, "seek": 317456, "start": 3183.32, "end": 3184.44, "text": " or two generations,", "tokens": [50803, 420, 732, 10593, 11, 50859], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1074, "seek": 317456, "start": 3184.7599999999998, "end": 3185.96, "text": " the anomaly wouldn't cancel,", "tokens": [50875, 264, 42737, 2759, 380, 10373, 11, 50935], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1075, "seek": 317456, "start": 3186.18, "end": 3187.2599999999998, "text": " the interface would fail,", "tokens": [50946, 264, 9226, 576, 3061, 11, 51000], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1076, "seek": 317456, "start": 3187.38, "end": 3188.6, "text": " and the universe wouldn't exist.", "tokens": [51006, 293, 264, 6445, 2759, 380, 2514, 13, 51067], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1077, "seek": 317456, "start": 3188.86, "end": 3189.36, "text": " It's exactly.", "tokens": [51080, 467, 311, 2293, 13, 51105], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1078, "seek": 317456, "start": 3189.58, "end": 3190.1, "text": " For decades,", "tokens": [51116, 1171, 7878, 11, 51142], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1079, "seek": 317456, "start": 3190.2, "end": 3190.96, "text": " the standard model", "tokens": [51147, 264, 3832, 2316, 51185], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1080, "seek": 317456, "start": 3190.96, "end": 3192.46, "text": " has had these three generations", "tokens": [51185, 575, 632, 613, 1045, 10593, 51260], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1081, "seek": 317456, "start": 3192.46, "end": 3194.6, "text": " making 48 fermions in total.", "tokens": [51260, 1455, 11174, 26558, 626, 294, 3217, 13, 51367], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1082, "seek": 317456, "start": 3195.2599999999998, "end": 3197.52, "text": " And physicists have agonizingly wondered", "tokens": [51400, 400, 48716, 362, 623, 266, 3319, 356, 17055, 51513], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1083, "seek": 317456, "start": 3197.52, "end": 3198.2999999999997, "text": " why there are three.", "tokens": [51513, 983, 456, 366, 1045, 13, 51552], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1084, "seek": 317456, "start": 3198.7999999999997, "end": 3200.02, "text": " Who ordered the muon?", "tokens": [51577, 2102, 8866, 264, 2992, 266, 30, 51638], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1085, "seek": 317456, "start": 3200.46, "end": 3201.24, "text": " Why does the matter", "tokens": [51660, 1545, 775, 264, 1871, 51699], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1086, "seek": 317456, "start": 3201.24, "end": 3202.4, "text": " repeat itself three times", "tokens": [51699, 7149, 2564, 1045, 1413, 51757], "temperature": 0.0, "avg_logprob": -0.18541916267021552, "compression_ratio": 1.7727272727272727, "no_speech_prob": 1.7144781688099853e-12}, {"id": 1087, "seek": 320240, "start": 3202.4, "end": 3203.32, "text": " and then abruptly stop?", "tokens": [50365, 293, 550, 49642, 1590, 30, 50411], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1088, "seek": 320240, "start": 3203.7200000000003, "end": 3204.52, "text": " In the standard model,", "tokens": [50431, 682, 264, 3832, 2316, 11, 50471], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1089, "seek": 320240, "start": 3204.64, "end": 3206.46, "text": " it's just an arbitrary parameter,", "tokens": [50477, 309, 311, 445, 364, 23211, 13075, 11, 50568], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1090, "seek": 320240, "start": 3206.7400000000002, "end": 3207.28, "text": " an accident.", "tokens": [50582, 364, 6398, 13, 50609], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1091, "seek": 320240, "start": 3207.84, "end": 3209.32, "text": " But in the Boyle-Torok model,", "tokens": [50637, 583, 294, 264, 9486, 306, 12, 51, 284, 453, 2316, 11, 50711], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1092, "seek": 320240, "start": 3209.8, "end": 3210.58, "text": " it isn't arbitrary.", "tokens": [50735, 309, 1943, 380, 23211, 13, 50774], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1093, "seek": 320240, "start": 3211.1800000000003, "end": 3212.76, "text": " The theory genuinely predicts", "tokens": [50804, 440, 5261, 17839, 6069, 82, 50883], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1094, "seek": 320240, "start": 3212.76, "end": 3213.8, "text": " the structure of matter", "tokens": [50883, 264, 3877, 295, 1871, 50935], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1095, "seek": 320240, "start": 3213.8, "end": 3215.02, "text": " because anything else", "tokens": [50935, 570, 1340, 1646, 50996], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1096, "seek": 320240, "start": 3215.02, "end": 3215.94, "text": " would fail to cancel", "tokens": [50996, 576, 3061, 281, 10373, 51042], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1097, "seek": 320240, "start": 3215.94, "end": 3217.34, "text": " the gravitational anomalies", "tokens": [51042, 264, 28538, 24769, 48872, 51112], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1098, "seek": 320240, "start": 3217.34, "end": 3218.7200000000003, "text": " of the invisibility manifold.", "tokens": [51112, 295, 264, 13308, 2841, 47138, 13, 51181], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1099, "seek": 320240, "start": 3219.1800000000003, "end": 3219.58, "text": " That is...", "tokens": [51204, 663, 307, 485, 51224], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1100, "seek": 320240, "start": 3219.58, "end": 3219.88, "text": " Wow.", "tokens": [51224, 3153, 13, 51239], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1101, "seek": 320240, "start": 3220.06, "end": 3220.94, "text": " I concede the point.", "tokens": [51248, 286, 416, 29815, 264, 935, 13, 51292], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1102, "seek": 320240, "start": 3221.14, "end": 3222.08, "text": " That isn't dial tuning.", "tokens": [51302, 663, 1943, 380, 5502, 15164, 13, 51349], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1103, "seek": 320240, "start": 3222.2400000000002, "end": 3223.08, "text": " That is discovering", "tokens": [51357, 663, 307, 24773, 51399], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1104, "seek": 320240, "start": 3223.08, "end": 3224.0, "text": " structural architecture.", "tokens": [51399, 15067, 9482, 13, 51445], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1105, "seek": 320240, "start": 3224.44, "end": 3225.06, "text": " It's like finding", "tokens": [51467, 467, 311, 411, 5006, 51498], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1106, "seek": 320240, "start": 3225.06, "end": 3226.5, "text": " a mysterious gear in a clock", "tokens": [51498, 257, 13831, 7394, 294, 257, 7830, 51570], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1107, "seek": 320240, "start": 3226.5, "end": 3227.76, "text": " and then discovering that", "tokens": [51570, 293, 550, 24773, 300, 51633], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1108, "seek": 320240, "start": 3227.76, "end": 3229.76, "text": " if that gear had one fewer tooth,", "tokens": [51633, 498, 300, 7394, 632, 472, 13366, 11680, 11, 51733], "temperature": 0.0, "avg_logprob": -0.23126347859700522, "compression_ratio": 1.697674418604651, "no_speech_prob": 2.2851902661824575e-12}, {"id": 1109, "seek": 322976, "start": 3229.76, "end": 3231.2000000000003, "text": " the whole clock would shatter.", "tokens": [50365, 264, 1379, 7830, 576, 402, 1161, 13, 50437], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1110, "seek": 322976, "start": 3231.44, "end": 3233.28, "text": " It predicts the exact structure of matter,", "tokens": [50449, 467, 6069, 82, 264, 1900, 3877, 295, 1871, 11, 50541], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1111, "seek": 322976, "start": 3233.38, "end": 3234.34, "text": " but it goes even further, right?", "tokens": [50546, 457, 309, 1709, 754, 3052, 11, 558, 30, 50594], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1112, "seek": 322976, "start": 3234.7000000000003, "end": 3236.34, "text": " Let's talk about the Big Bang itself.", "tokens": [50612, 961, 311, 751, 466, 264, 5429, 11538, 2564, 13, 50694], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1113, "seek": 322976, "start": 3236.7000000000003, "end": 3237.6200000000003, "text": " The paper discusses", "tokens": [50712, 440, 3035, 2248, 279, 50758], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1114, "seek": 322976, "start": 3237.6200000000003, "end": 3239.1000000000004, "text": " the CPT symmetric universe.", "tokens": [50758, 264, 22431, 51, 32330, 6445, 13, 50832], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1115, "seek": 322976, "start": 3239.2200000000003, "end": 3240.26, "text": " What does CPT mean?", "tokens": [50838, 708, 775, 22431, 51, 914, 30, 50890], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1116, "seek": 322976, "start": 3240.5800000000004, "end": 3242.0, "text": " CPT is an acronym", "tokens": [50906, 22431, 51, 307, 364, 39195, 50977], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1117, "seek": 322976, "start": 3242.0, "end": 3243.1800000000003, "text": " for charge conjugation,", "tokens": [50977, 337, 4602, 29456, 399, 11, 51036], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1118, "seek": 322976, "start": 3243.7000000000003, "end": 3244.3, "text": " parity inversion,", "tokens": [51062, 44747, 43576, 11, 51092], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1119, "seek": 322976, "start": 3244.48, "end": 3245.0800000000004, "text": " and time reversal.", "tokens": [51101, 293, 565, 42778, 13, 51131], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1120, "seek": 322976, "start": 3245.5, "end": 3247.1400000000003, "text": " It is the most fundamental symmetry", "tokens": [51152, 467, 307, 264, 881, 8088, 25440, 51234], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1121, "seek": 322976, "start": 3247.1400000000003, "end": 3248.5800000000004, "text": " in all of quantum mechanics.", "tokens": [51234, 294, 439, 295, 13018, 12939, 13, 51306], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1122, "seek": 322976, "start": 3249.38, "end": 3250.5600000000004, "text": " Charge conjugation swaps", "tokens": [51346, 40546, 29456, 399, 1693, 2382, 51405], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1123, "seek": 322976, "start": 3250.5600000000004, "end": 3251.76, "text": " matter with antimatter.", "tokens": [51405, 1871, 365, 46141, 1161, 13, 51465], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1124, "seek": 322976, "start": 3252.36, "end": 3254.1400000000003, "text": " Parity inversion flips left and right", "tokens": [51495, 3457, 507, 43576, 40249, 1411, 293, 558, 51584], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1125, "seek": 322976, "start": 3254.1400000000003, "end": 3254.7200000000003, "text": " like a mirror.", "tokens": [51584, 411, 257, 8013, 13, 51613], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1126, "seek": 322976, "start": 3255.4, "end": 3256.28, "text": " Time reversal runs", "tokens": [51647, 6161, 42778, 6676, 51691], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1127, "seek": 322976, "start": 3256.28, "end": 3257.0, "text": " the clock backward.", "tokens": [51691, 264, 7830, 23897, 13, 51727], "temperature": 0.0, "avg_logprob": -0.17698890215730015, "compression_ratio": 1.6622073578595318, "no_speech_prob": 1.8396412865273604e-12}, {"id": 1128, "seek": 325700, "start": 3257.62, "end": 3259.04, "text": " The CPT theorem dictates", "tokens": [50396, 440, 22431, 51, 20904, 12569, 1024, 50467], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1129, "seek": 325700, "start": 3259.04, "end": 3260.54, "text": " that if you take any physical system,", "tokens": [50467, 300, 498, 291, 747, 604, 4001, 1185, 11, 50542], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1130, "seek": 325700, "start": 3261.02, "end": 3261.72, "text": " flip its charge,", "tokens": [50566, 7929, 1080, 4602, 11, 50601], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1131, "seek": 325700, "start": 3261.96, "end": 3262.7, "text": " flip it in a mirror,", "tokens": [50613, 7929, 309, 294, 257, 8013, 11, 50650], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1132, "seek": 325700, "start": 3262.8, "end": 3263.86, "text": " or run it backward in time,", "tokens": [50655, 420, 1190, 309, 23897, 294, 565, 11, 50708], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1133, "seek": 325700, "start": 3264.06, "end": 3264.74, "text": " it must obey", "tokens": [50718, 309, 1633, 19297, 50752], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1134, "seek": 325700, "start": 3264.74, "end": 3266.4, "text": " the exact same laws of physics.", "tokens": [50752, 264, 1900, 912, 6064, 295, 10649, 13, 50835], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1135, "seek": 325700, "start": 3266.74, "end": 3267.02, "text": " Okay.", "tokens": [50852, 1033, 13, 50866], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1136, "seek": 325700, "start": 3267.28, "end": 3268.06, "text": " But what does that have to do", "tokens": [50879, 583, 437, 775, 300, 362, 281, 360, 50918], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1137, "seek": 325700, "start": 3268.06, "end": 3268.74, "text": " with the Big Bang?", "tokens": [50918, 365, 264, 5429, 11538, 30, 50952], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1138, "seek": 325700, "start": 3269.04, "end": 3270.2, "text": " In standard cosmology,", "tokens": [50967, 682, 3832, 22207, 1793, 11, 51025], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1139, "seek": 325700, "start": 3270.56, "end": 3272.28, "text": " the Big Bang is a singularity,", "tokens": [51043, 264, 5429, 11538, 307, 257, 20010, 507, 11, 51129], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1140, "seek": 325700, "start": 3272.5, "end": 3273.3, "text": " an edge of time", "tokens": [51140, 364, 4691, 295, 565, 51180], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1141, "seek": 325700, "start": 3273.3, "end": 3275.02, "text": " where physics completely breaks down.", "tokens": [51180, 689, 10649, 2584, 9857, 760, 13, 51266], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_speech_prob": 2.4183422191875747e-12}, {"id": 1142, "seek": 325700, "start": 3275.6, "end": 3277.16, "text": " And standard cosmology assumes", "tokens": [51295, 400, 3832, 22207, 1793, 37808, 51373], "temperature": 0.0, "avg_logprob": -0.1989149484575165, "compression_ratio": 1.6446540880503144, "no_s