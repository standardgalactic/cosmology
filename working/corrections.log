"end": 3095.94, "text": " They perfectly cancel", "tokens": [50583, 814, 6239, 10373, 50630], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1010, "seek": 309064, "start": 3095.94, "end": 3096.74, "text": " the Boyle anomaly", "tokens": [50630, 264, 9486, 306, 42737, 50670], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1011, "seek": 309064, "start": 3096.74, "end": 3097.64, "text": " without needing", "tokens": [50670, 1553, 18006, 50715], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1012, "seek": 309064, "start": 3097.64, "end": 3099.16, "text": " a single new physical particle.", "tokens": [50715, 257, 2167, 777, 4001, 12359, 13, 50791], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1013, "seek": 309064, "start": 3099.4, "end": 3100.7, "text": " Okay, that is clever math.", "tokens": [50803, 1033, 11, 300, 307, 13494, 5221, 13, 50868], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1014, "seek": 309064, "start": 3100.7799999999997, "end": 3101.7599999999998, "text": " But here's where", "tokens": [50872, 583, 510, 311, 689, 50921], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1015, "seek": 309064, "start": 3101.7599999999998, "end": 3102.66, "text": " I'm going to push back again", "tokens": [50921, 286, 478, 516, 281, 2944, 646, 797, 50966], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1016, "seek": 309064, "start": 3102.66, "end": 3103.46, "text": " because the paper makes", "tokens": [50966, 570, 264, 3035, 1669, 51006], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1017, "seek": 309064, "start": 3103.46, "end": 3104.56, "text": " a jaw-dropping claim", "tokens": [51006, 257, 18162, 12, 45869, 3759, 3932, 51061], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1018, "seek": 309064, "start": 3104.56, "end": 3106.3599999999997, "text": " about predicting the exact number", "tokens": [51061, 466, 32884, 264, 1900, 1230, 51151], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1019, "seek": 309064, "start": 3106.3599999999997, "end": 3107.56, "text": " of particles in the universe.", "tokens": [51151, 295, 10007, 294, 264, 6445, 13, 51211], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1020, "seek": 309064, "start": 3108.06, "end": 3109.4, "text": " It says the math demands", "tokens": [51236, 467, 1619, 264, 5221, 15107, 51303], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1021, "seek": 309064, "start": 3109.4, "end": 3110.9, "text": " exactly three generations", "tokens": [51303, 2293, 1045, 10593, 51378], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1022, "seek": 309064, "start": 3110.9, "end": 3112.6, "text": " of standard model fermions.", "tokens": [51378, 295, 3832, 2316, 26558, 626, 13, 51463], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1023, "seek": 309064, "start": 3112.74, "end": 3113.2799999999997, "text": " So an electron,", "tokens": [51470, 407, 364, 6084, 11, 51497], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1024, "seek": 309064, "start": 3113.54, "end": 3114.6, "text": " a muon, and a tau.", "tokens": [51510, 257, 2992, 266, 11, 293, 257, 17842, 13, 51563], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1025, "seek": 309064, "start": 3114.8799999999997, "end": 3116.22, "text": " That's three generations.", "tokens": [51577, 663, 311, 1045, 10593, 13, 51644], "temperature": 0.0, "avg_logprob": -0.18190939882968335, "compression_ratio": 1.6838487972508591, "no_speech_prob": 1.9970971491117817e-12}, {"id": 1026, "seek": 311622, "start": 3116.22, "end": 3118.74, "text": " And we happen to actually have", "tokens": [50365, 400, 321, 1051, 281, 767, 362, 50491], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1027, "seek": 311622, "start": 3118.74, "end": 3120.04, "text": " exactly three generations", "tokens": [50491, 2293, 1045, 10593, 50556], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1028, "seek": 311622, "start": 3120.04, "end": 3121.3399999999997, "text": " of matter in reality.", "tokens": [50556, 295, 1871, 294, 4103, 13, 50621], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1029, "seek": 311622, "start": 3122.08, "end": 3123.62, "text": " But whenever a theoretical physicist", "tokens": [50658, 583, 5699, 257, 20864, 42466, 50735], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1030, "seek": 311622, "start": 3123.62, "end": 3124.8199999999997, "text": " tells me their new model", "tokens": [50735, 5112, 385, 641, 777, 2316, 50795], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1031, "seek": 311622, "start": 3124.8199999999997, "end": 3125.8199999999997, "text": " perfectly predicts", "tokens": [50795, 6239, 6069, 82, 50845], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1032, "seek": 311622, "start": 3125.8199999999997, "end": 3126.9599999999996, "text": " a number we already knew,", "tokens": [50845, 257, 1230, 321, 1217, 2586, 11, 50902], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1033, "seek": 311622, "start": 3127.14, "end": 3128.3599999999997, "text": " I immediately get suspicious.", "tokens": [50911, 286, 4258, 483, 17931, 13, 50972], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1034, "seek": 311622, "start": 3128.8399999999997, "end": 3130.06, "text": " That's called post-addiction.", "tokens": [50996, 663, 311, 1219, 2183, 12, 25224, 4105, 13, 51057], "temperature": 0.0, "avg_logprob": -0.18685114975516678, "compression_ratio": 1.5833333333333333, "no_speech_prob": 2.0204272282997593e-12}, {"id": 1035, "seek": 311622, "start": 3130.9399999999996, "end": 3131.9599999999996, "text": " Did Boyle and Turok", "tokens": [51101, 2589, 9486, 306, 293, 314, 7052, 74, 51152], "temperature": 0.0, "avg_logprob": -0.186851