2200000000003, "end": 3565.38, "text": " But as a journalist,", "tokens": [51237, 583, 382, 257, 17277, 11, 51295], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1368, "seek": 354678, "start": 3565.6000000000004, "end": 3566.96, "text": " I have to step out of the awe", "tokens": [51306, 286, 362, 281, 1823, 484, 295, 264, 30912, 51374], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1369, "seek": 354678, "start": 3566.96, "end": 3568.38, "text": " and ask the critical question.", "tokens": [51374, 293, 1029, 264, 4924, 1168, 13, 51445], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1370, "seek": 354678, "start": 3568.8, "end": 3570.0600000000004, "text": " Does everyone agree with this?", "tokens": [51466, 4402, 1518, 3986, 365, 341, 30, 51529], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1371, "seek": 354678, "start": 3570.42, "end": 3571.48, "text": " Is the physics community", "tokens": [51547, 1119, 264, 10649, 1768, 51600], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1372, "seek": 354678, "start": 3571.48, "end": 3572.3, "text": " just packing up", "tokens": [51600, 445, 20815, 493, 51641], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1373, "seek": 354678, "start": 3572.3, "end": 3573.52, "text": " their string theory bags,", "tokens": [51641, 641, 6798, 5261, 10405, 11, 51702], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1374, "seek": 354678, "start": 3573.94, "end": 3574.7200000000003, "text": " admitting defeat,", "tokens": [51723, 44056, 11785, 11, 51762], "temperature": 0.0, "avg_logprob": -0.2035017422267369, "compression_ratio": 1.6321070234113713, "no_speech_prob": 1.9354652429359742e-12}, {"id": 1375, "seek": 357472, "start": 3574.72, "end": 3575.9599999999996, "text": " and crowning this", "tokens": [50365, 293, 11841, 278, 341, 50427], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1376, "seek": 357472, "start": 3575.9599999999996, "end": 3577.3399999999997, "text": " the final theory of everything?", "tokens": [50427, 264, 2572, 5261, 295, 1203, 30, 50496], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1377, "seek": 357472, "start": 3577.3399999999997, "end": 3578.02, "text": " Not at all.", "tokens": [50496, 1726, 412, 439, 13, 50530], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1378, "seek": 357472, "start": 3578.14, "end": 3578.8199999999997, "text": " And it's vital", "tokens": [50536, 400, 309, 311, 11707, 50570], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1379, "seek": 357472, "start": 3578.8199999999997, "end": 3580.64, "text": " we maintain an impartial context here", "tokens": [50570, 321, 6909, 364, 32177, 831, 4319, 510, 50661], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1380, "seek": 357472, "start": 3580.64, "end": 3582.2599999999998, "text": " because the paper itself", "tokens": [50661, 570, 264, 3035, 2564, 50742], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1381, "seek": 357472, "start": 3582.2599999999998, "end": 3583.64, "text": " explicitly includes", "tokens": [50742, 20803, 5974, 50811], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1382, "seek": 357472, "start": 3583.64, "end": 3584.66, "text": " the ongoing debate.", "tokens": [50811, 264, 10452, 7958, 13, 50862], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1383, "seek": 357472, "start": 3585.16, "end": 3586.06, "text": " There is a fierce,", "tokens": [50887, 821, 307, 257, 25341, 11, 50932], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1384, "seek": 357472, "start": 3586.4599999999996, "end": 3587.72, "text": " highly technical pushback", "tokens": [50952, 5405, 6191, 2944, 3207, 51015], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1385, "seek": 357472, "start": 3587.72, "end": 3588.4399999999996, "text": " from the establishment.", "tokens": [51015, 490, 264, 20971, 13, 51051], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1386, "seek": 357472, "start": 3588.98, "end": 3589.3399999999997, "text": " Specifically,", "tokens": [51078, 26058, 11, 51096], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1387, "seek": 357472, "start": 3589.7, "end": 3590.66, "text": " there's a strong criticism", "toke