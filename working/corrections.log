72, "start": 3598.9199999999996, "end": 3599.7599999999998, "text": " scalar program.", "tokens": [51575, 39684, 1461, 13, 51617], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1395, "seek": 357472, "start": 3599.9599999999996, "end": 3601.04, "text": " What is their argument?", "tokens": [51627, 708, 307, 641, 6770, 30, 51681], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1396, "seek": 357472, "start": 3601.24, "end": 3602.62, "text": " If the anomaly cancels out,", "tokens": [51691, 759, 264, 42737, 393, 66, 1625, 484, 11, 51760], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1397, "seek": 357472, "start": 3602.7, "end": 3603.3199999999997, "text": " what's the problem?", "tokens": [51764, 437, 311, 264, 1154, 30, 51795], "temperature": 0.0, "avg_logprob": -0.1748922451122387, "compression_ratio": 1.5718562874251496, "no_speech_prob": 1.8396365160378014e-12}, {"id": 1398, "seek": 360332, "start": 3603.32, "end": 3604.94, "text": " Their argument focuses", "tokens": [50365, 6710, 6770, 16109, 50446], "temperature": 0.0, "avg_logprob": -0.23277082522053363, "compression_ratio": 1.5927272727272728, "no_speech_prob": 2.4756741795473047e-12}, {"id": 1399, "seek": 360332, "start": 3604.94, "end": 3606.6400000000003, "text": " on the projection operator pi", "tokens": [50446, 322, 264, 22743, 12973, 3895, 50531], "temperature": 0.0, "avg_logprob": -0.23277082522053363, "compression_ratio": 1.5927272727272728, "no_speech_prob": 2.4756741795473047e-12}, {"id": 1400, "seek": 360332, "start": 3606.6400000000003, "end": 3607.7000000000003, "text": " and whether it actually", "tokens": [50531, 293, 1968, 309, 767, 50584], "temperature": 0.0, "avg_logprob": -0.23277082522053363, 