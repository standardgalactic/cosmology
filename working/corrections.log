42, 30, 51841], "temperature": 0.0, "avg_logprob": -0.07538419503432053, "compression_ratio": 1.6348122866894197, "no_speech_prob": 6.715620355819685e-13}, {"id": 3, "seek": 2952, "start": 29.52, "end": 34.64, "text": " Yeah. It is a profound, almost uncomfortable question to ask.", "tokens": [50365, 865, 13, 467, 307, 257, 14382, 11, 1920, 10532, 1168, 281, 1029, 13, 50621], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 4, "seek": 2952, "start": 34.8, "end": 34.9, "text": " Yeah.", "tokens": [50629, 865, 13, 50634], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 5, "seek": 2952, "start": 34.96, "end": 43.86, "text": " We're talking about questioning the absolute bedrock of the theoretical architecture that, you know, tens of thousands of physicists have spent their entire careers building.", "tokens": [50637, 492, 434, 1417, 466, 21257, 264, 8236, 2901, 17799, 295, 264, 20864, 9482, 300, 11, 291, 458, 11, 10688, 295, 5383, 295, 48716, 362, 4418, 641, 2302, 16409, 2390, 13, 51082], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 6, "seek": 2952, "start": 44.1, "end": 46.239999999999995, "text": " But that is exactly what we are questioning today.", "tokens": [51094, 583, 300, 307, 2293, 437, 321, 366, 21257, 965, 13, 51201], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 7, "seek": 2952, "start": 46.480000000000004, "end": 51.96, "text": " We are looking at a new theoretical framework that suggests the universe isn't fundamentally broken.", "tokens": [51213, 492, 366, 1237, 412, 257, 777, 20864, 8388, 300, 13409, 264, 6445, 1943, 380, 17879, 5463, 13, 51487], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 8, "seek": 2952, "start": 52.480000000000004, "end": 57.5, "text": " It suggests we just refused to let our mathematical ledgers dip into the negative.", "tokens": [51513, 467, 13409, 321, 445, 14654, 281, 718, 527, 18894, 4684, 9458, 10460, 666, 264, 3671, 13, 51764], "temperature": 0.0, "avg_logprob": -0.1007538028791839, "compression_ratio": 1.667832167832168, "no_speech_prob": 9.2875371022344e-13}, {"id": 9, "seek": 5750, "start": 57.5, "end": 66.36, "text": " So we're unpacking an incredibly dense, genuinely revolutionary theoretical physics paper published today, June 23, 2026.", "tokens": [50365, 407, 321, 434, 26699, 278, 364, 6252, 18011, 11, 17839, 22687, 20864, 10649, 3035, 6572, 965, 11, 6928, 6673, 11, 945, 10880, 13, 50808], "temperature": 0.0, "avg_logprob": -0.09571259110062211, "compression_ratio": 1.3038674033149171, "no_speech_prob": 1.5074969267683813e-12}, {"id": 10, "seek": 5750, "start": 66.6, "end": 73.66, "text": " It's by an independent researcher named Fliction, and it's titled Quadratic Gravity as a Derived Interface Theory.", "tokens": [50820, 467, 311, 538, 364, 6695, 21751, 4926, 3235, 4105, 11, 293, 309, 311, 19841, 29619, 25198, 49478, 382, 257, 5618, 3194, 5751, 2868, 29009, 13, 51173], "temperature": 0.0, "avg_logprob": -0.09571259110062211, "compression_ratio": 1.3038674033149171, "no_speech_prob": 1.5074969267683813e-12}, {"id": 11, "seek": 7366, "start": 73.66, "end": 86.86, "text": " And our mission for this deep dive is to explore whether a single, unchecked, largely unspoken mathematical assumption has been holding back the unification of quantum mechanics and gravity for half a century.", "tokens": [50365, 400, 527, 4447, 337, 341, 2452, 9192, 307, 281, 6839, 1968, 257, 2167, 11, 46672, 292, 11, 11611, 2693, 79, 8406, 18894, 15302, 575, 668, 5061, 646, 264, 517, 3774, 295, 13018, 12939, 293, 12110, 337, 1922, 257, 4901, 13, 51025], "temperature": 0.0, "avg_logprob": -0.0771430026401173, "compression_ratio": 1.3841059602649006, "no_speech_prob": 1.5612981827534123e-12}, {"id": 12, "seek": 8686, "start": 86.86, "end": 95.46, "text": " And for you, listening to this right now, I just want to acknowledge up front, we're going to be diving deep into the actual machinery of quantum gravity today.", "tokens": [50365, 400, 337, 291, 11, 4764, 281, 341, 558, 586, 11, 286, 445, 528, 281, 10692, 493, 1868, 11, 321, 434, 516, 281, 312, 20241, 2452, 666, 264, 3539, 27302, 295, 13018, 12110, 965, 13, 50795], "temperature": 0.0, "avg_logprob": -0.09689752445664516, "compression_ratio": 1.5911330049261083, "no_speech_prob": 1.935487794341162e-12}, {"id": 13, "seek": 8686, "start": 95.53999999999999, "end": 98.48, "text": " We aren't just going to give you the, you know, the surface level metaphors.", "tokens": [50799, 492, 3212, 380, 445, 516, 281, 976, 291, 264, 11, 291, 458, 11, 264, 3753, 1496, 30946, 830, 13, 50946], "temperature": 0.0, "avg_logprob": -0.09689752445664516, "compression_ratio": 1.5911330049261083, "no_speech_prob": 1.935487794341162e-12}, {"id": 14, "seek": 8686, "start": 98.64, "end": 100.4, "text": " We are really going to look under the hood.", "tokens": [50954, 492, 366, 534, 516, 281, 574, 833, 264, 13376, 13, 51042], "temperature": 0.0, "avg_logprob": -0.09689752445664516, "compression_ratio": 1.5911330049261083, "no_speech_prob": 1.935487794341162e-12}, {"id": 15, "seek": 8686, "start": 100.52, "end": 101.8, "text": " Yeah, we're getting into the math.", "tokens": [51048, 865, 11, 321, 434, 1242, 666, 264, 5221, 13, 51112], "temperature": 0.0, "avg_logprob": -0.09689752445664516, "compression_ratio": 1.5911330049261083, "no_speech_prob": 1.935487794341162e-12}, {"id": 16, "seek": 8686, "start": 101.96, "end": 102.2, "text": " Right.", "tokens": [51120, 1779, 13, 51132], "temperature": 0.0, "avg_logprob": -0.09689752445664516, "compression_ratio": 1.5911330049261083, "no_speech_prob": 1.935487794341162e-12}, {"id": 17, "seek": 10220, "start": 102.2, "end": 107.54, "text": " But the ultimate takeaway here is a profound lesson on how we interpret reality itself.", "tokens": [50365, 583, 264, 9705, 30681, 510, 307, 257, 14382, 6898, 322, 577, 321, 7302, 4103, 2564, 13, 50632], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 18, "seek": 10220, "start": 108.0, "end": 112.42, "text": " It's about recognizing the difference between the map we draw and the actual territory we live in.", "tokens": [50655, 467, 311, 466, 18538, 264, 2649, 1296, 264, 4471, 321, 2642, 293, 264, 3539, 11360, 321, 1621, 294, 13, 50876], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 19, "seek": 10220, "start": 112.5, "end": 115.62, "text": " You know, it reminds me of like a medical diagnosis.", "tokens": [50880, 509, 458, 11, 309, 12025, 385, 295, 411, 257, 4625, 15217, 13, 51036], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 20, "seek": 10220, "start": 115.88, "end": 119.58, "text": " Usually when we talk about a diagnosis, there's this expectation of pure precision.", "tokens": [51049, 11419, 562, 321, 751, 466, 257, 15217, 11, 456, 311, 341, 14334, 295, 6075, 18356, 13, 51234], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 21, "seek": 10220, "start": 120.0, "end": 121.56, "text": " It feels like engineering, right?", "tokens": [51255, 467, 3417, 411, 7043, 11, 558, 30, 51333], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 22, "seek": 10220, "start": 121.66, "end": 122.7, "text": " You break your arm.", "tokens": [51338, 509, 1821, 428, 3726, 13, 51390], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 23, "seek": 10220, "start": 122.78, "end": 125.0, "text": " The x-ray shows that jagged white line.", "tokens": [51394, 440, 2031, 12, 3458, 3110, 300, 6368, 3004, 2418, 1622, 13, 51505], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 24, "seek": 10220, "start": 125.10000000000001, "end": 127.18, "text": " And the doctor just points and says, there it is.", "tokens": [51510, 400, 264, 4631, 445, 2793, 293, 1619, 11, 456, 309, 307, 13, 51614], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 25, "seek": 10220, "start": 127.22, "end": 127.82000000000001, "text": " It's binary.", "tokens": [51616, 467, 311, 17434, 13, 51646], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 26, "seek": 10220, "start": 128.06, "end": 128.72, "text": " It's clean.", "tokens": [51658, 467, 311, 2541, 13, 51691], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 27, "seek": 10220, "start": 129.1, "end": 129.92000000000002, "text": " Broken or not broken.", "tokens": [51710, 46624, 420, 406, 5463, 13, 51751], "temperature": 0.0, "avg_logprob": -0.13003294203016494, "compression_ratio": 1.6163522012578617, "no_speech_prob": 1.6947751795698407e-12}, {"id": 28, "seek": 12992, "start": 129.92, "end": 130.7, "text": " Right, right.", "tokens": [50365, 1779, 11, 558, 13, 50404], "temperature": 0.0, "avg_logprob": -0.09992155056555295, "compression_ratio": 1.5613382899628252, "no_speech_prob": 1.4783870742191008e-12}, {"id": 29, "seek": 12992, "start": 130.82, "end": 133.51999999999998, "text": " And as humans, we are deeply comforted by that.", "tokens": [50410, 400, 382, 6255, 11, 321, 366, 8760, 3400, 292, 538, 300, 13, 50545], "temperature": 0.0, "avg_logprob": -0.09992155056555295, "compression_ratio": 1.5613382899628252, "no_speech_prob": 1.4783870742191008e-12}, {"id": 30, "seek": 12992, "start": 134.1, "end": 143.61999999999998, "text": " We like things to be visible, to be strictly categorized, and to have a one-to-one relationship with the physical world we can actually touch.", "tokens": [50574, 492, 411, 721, 281, 312, 8974, 11, 281, 312, 20792, 19250, 1602, 11, 293, 281, 362, 257, 472, 12, 1353, 12, 546, 2480, 365, 264, 4001, 1002, 321, 393, 767, 2557, 13, 51050], "temperature": 0.0, "avg_logprob": -0.09992155056555295, "compression_ratio": 1.5613382899628252, "no_speech_prob": 1.4783870742191008e-12}, {"id": 31, "seek": 12992, "start": 143.82, "end": 152.35999999999999, "text": " But then you step into the world of complex systems like neurodevelopment or autoimmune diseases, and suddenly that x-ray machine is totally useless.", "tokens": [51060, 583, 550, 291, 1823, 666, 264, 1002, 295, 3997, 3652, 411, 16499, 35464, 518, 420, 8399, 49031, 11044, 11, 293, 5800, 300, 2031, 12, 3458, 3479, 307, 3879, 14115, 13, 51487], "temperature": 0.0, "avg_logprob": -0.09992155056555295, "compression_ratio": 1.5613382899628252, "no_speech_prob": 1.4783870742191008e-12}, {"id": 32, "seek": 12992, "start": 153.06, "end": 156.44, "text": " We're looking at a diagnostic landscape that is incredibly murky.", "tokens": [51522, 492, 434, 1237, 412, 257, 27897, 9661, 300, 307, 6252, 5257, 4133, 13, 51691], "temperature": 0.0, "avg_logprob": -0.09992155056555295, "compression_ratio": 1.5613382899628252, "no_speech_prob": 1.4783870742191008e-12}, {"id": 33, "seek": 15644, "start": 156.44, "end": 164.1, "text": " You get test results that show antibodies or elevated proteins, but those numbers don't necessarily equate to a specific disease.", "tokens": [50365, 509, 483, 1500, 3542, 300, 855, 28356, 420, 23457, 15577, 11, 457, 729, 3547, 500, 380, 4725, 1267, 473, 281, 257, 2685, 4752, 13, 50748], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 34, "seek": 15644, "start": 164.22, "end": 164.68, "text": " Exactly.", "tokens": [50754, 7587, 13, 50777], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 35, "seek": 15644, "start": 164.92, "end": 165.57999999999998, "text": " They are markers.", "tokens": [50789, 814, 366, 19175, 13, 50822], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 36, "seek": 15644, "start": 165.78, "end": 166.3, "text": " They are hints.", "tokens": [50832, 814, 366, 27271, 13, 50858], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 37, "seek": 15644, "start": 166.48, "end": 166.64, "text": " Right.", "tokens": [50867, 1779, 13, 50875], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 38, "seek": 15644, "start": 166.88, "end": 172.16, "text": " They're shadows of a deeper underlying process that we just can't capture in a single clean snapshot.", "tokens": [50887, 814, 434, 14740, 295, 257, 7731, 14217, 1399, 300, 321, 445, 393, 380, 7983, 294, 257, 2167, 2541, 30163, 13, 51151], "temperature": 0.0, "avg_logprob": -0.16369965417044505, "compression_ratio": 1.4635416666666667, "no_speech_prob": 1.5983085081133774e-12}, {"id": 39, "seek": 17216, "start": 172.16, "end": 182.76, "text": " And that unsettling realization that our diagnostic tools might be showing us shadows instead of the actual bone is the precise paradigm shift this paper is applying to the very fabric of the universe.", "tokens": [50365, 400, 300, 43964, 1688, 25138, 300, 527, 27897, 3873, 1062, 312, 4099, 505, 14740, 2602, 295, 264, 3539, 9026, 307, 264, 13600, 24709, 5513, 341, 3035, 307, 9275, 281, 264, 588, 7253, 295, 264, 6445, 13, 50895], "temperature": 0.0, "avg_logprob": -0.06872076614230287, "compression_ratio": 1.6875, "no_speech_prob": 1.9733275343630785e-12}, {"id": 40, "seek": 17216, "start": 183.18, "end": 189.7, "text": " For the last century, physicists have demanded that their mathematical blueprints look exactly like the observable universe.", "tokens": [50916, 1171, 264, 1036, 4901, 11, 48716, 362, 28276, 300, 641, 18894, 888, 23547, 47523, 574, 2293, 411, 264, 9951, 712, 6445, 13, 51242], "temperature": 0.0, "avg_logprob": -0.06872076614230287, "compression_ratio": 1.6875, "no_speech_prob": 1.9733275343630785e-12}, {"id": 41, "seek": 17216, "start": 190.3, "end": 200.18, "text": " If the math spits out something weird, something we can't touch or see, the immediate instinct has been to just, well, to throw the entire theory in the trash.", "tokens": [51272, 759, 264, 5221, 637, 1208, 484, 746, 3657, 11, 746, 321, 393, 380, 2557, 420, 536, 11, 264, 11629, 16556, 575, 668, 281, 445, 11, 731, 11, 281, 3507, 264, 2302, 5261, 294, 264, 11321, 13, 51766], "temperature": 0.0, "avg_logprob": -0.06872076614230287, "compression_ratio": 1.6875, "no_speech_prob": 1.9733275343630785e-12}, {"id": 42, "seek": 20018, "start": 200.18, "end": 207.78, "text": " And the foundational rule of standard quantum mechanics, the very first thing this paper targets, is something called the Hilbert Assumption.", "tokens": [50365, 400, 264, 32195, 4978, 295, 3832, 13018, 12939, 11, 264, 588, 700, 551, 341, 3035, 12911, 11, 307, 746, 1219, 264, 19914, 4290, 6281, 449, 1695, 13, 50745], "temperature": 0.0, "avg_logprob": -0.1357482842036656, "compression_ratio": 1.6307053941908713, "no_speech_prob": 2.3251112406946772e-12}, {"id": 43, "seek": 20018, "start": 208.58, "end": 214.8, "text": " Before we even talk about gravity, we need to establish the ground rules of how quantum physicists do their daily accounting.", "tokens": [50785, 4546, 321, 754, 751, 466, 12110, 11, 321, 643, 281, 8327, 264, 2727, 4474, 295, 577, 13018, 48716, 360, 641, 5212, 19163, 13, 51096], "temperature": 0.0, "avg_logprob": -0.1357482842036656, "compression_ratio": 1.6307053941908713, "no_speech_prob": 2.3251112406946772e-12}, {"id": 44, "seek": 20018, "start": 215.06, "end": 215.16, "text": " Right.", "tokens": [51109, 1779, 13, 51114], "temperature": 0.0, "avg_logprob": -0.1357482842036656, "compression_ratio": 1.6307053941908713, "no_speech_prob": 2.3251112406946772e-12}, {"id": 45, "seek": 20018, "start": 215.4, "end": 222.48000000000002, "text": " The paper states that standard physics demands the state space of any physical system must be a complex Hilbert space.", "tokens": [51126, 440, 3035, 4368, 300, 3832, 10649, 15107, 264, 1785, 1901, 295, 604, 4001, 1185, 1633, 312, 257, 3997, 19914, 4290, 1901, 13, 51480], "temperature": 0.0, "avg_logprob": -0.1357482842036656, "compression_ratio": 1.6307053941908713, "no_speech_prob": 2.3251112406946772e-12}, {"id": 46, "seek": 22248, "start": 222.48, "end": 224.38, "text": " So let's define the terms here.", "tokens": [50365, 407, 718, 311, 6964, 264, 2115, 510, 13, 50460], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 47, "seek": 22248, "start": 224.92, "end": 227.67999999999998, "text": " What exactly makes a mathematical space a Hilbert space?", "tokens": [50487, 708, 2293, 1669, 257, 18894, 1901, 257, 19914, 4290, 1901, 30, 50625], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 48, "seek": 22248, "start": 227.78, "end": 230.6, "text": " And why is standard physics so fiercely protective of it?", "tokens": [50630, 400, 983, 307, 3832, 10649, 370, 16334, 42879, 16314, 295, 309, 30, 50771], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 49, "seek": 22248, "start": 230.7, "end": 230.94, "text": " Okay.", "tokens": [50776, 1033, 13, 50788], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 50, "seek": 22248, "start": 231.06, "end": 235.88, "text": " To really grasp this, we need to go back to the 1920s to a mathematician named David Hilbert.", "tokens": [50794, 1407, 534, 21743, 341, 11, 321, 643, 281, 352, 646, 281, 264, 22003, 82, 281, 257, 48281, 4926, 4389, 19914, 4290, 13, 51035], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 51, "seek": 22248, "start": 236.26, "end": 240.98, "text": " When quantum mechanics was first being formalized by people like Heisenberg and Schr\u00f6dinger,", "tokens": [51054, 1133, 13018, 12939, 390, 700, 885, 9860, 1602, 538, 561, 411, 634, 11106, 6873, 293, 46191, 973, 3584, 260, 11, 51290], "temperature": 0.0, "avg_logprob": -0.168842894307683, "compression_ratio": 1.4225941422594142, "no_speech_prob": 1.4552912911205973e-12}, {"id": 52, "seek": 24098, "start": 240.98, "end": 248.23999999999998, "text": " they realized that classical math, just tracking a particle's position and momentum with regular numbers, wasn't enough.", "tokens": [50365, 436, 5334, 300, 13735, 5221, 11, 445, 11603, 257, 12359, 311, 2535, 293, 11244, 365, 3890, 3547, 11, 2067, 380, 1547, 13, 50728], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 53, "seek": 24098, "start": 248.32, "end": 250.04, "text": " Because things are super weird down there.", "tokens": [50732, 1436, 721, 366, 1687, 3657, 760, 456, 13, 50818], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 54, "seek": 24098, "start": 250.33999999999997, "end": 250.72, "text": " Exactly.", "tokens": [50833, 7587, 13, 50852], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 55, "seek": 24098, "start": 251.16, "end": 254.14, "text": " Quantum particles don't exist in single definite states.", "tokens": [50874, 44964, 10007, 500, 380, 2514, 294, 2167, 25131, 4368, 13, 51023], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 56, "seek": 24098, "start": 254.44, "end": 254.67999999999998, "text": " No.", "tokens": [51038, 883, 13, 51050], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 57, "seek": 24098, "start": 254.78, "end": 256.3, "text": " They exist in superpositions.", "tokens": [51055, 814, 2514, 294, 1687, 30010, 2451, 13, 51131], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 58, "seek": 24098, "start": 256.42, "end": 259.42, "text": " They have a probability of being in many different states all at once.", "tokens": [51137, 814, 362, 257, 8482, 295, 885, 294, 867, 819, 4368, 439, 412, 1564, 13, 51287], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 59, "seek": 24098, "start": 259.7, "end": 261.02, "text": " Right, like Schr\u00f6dinger's cat.", "tokens": [51301, 1779, 11, 411, 46191, 973, 3584, 260, 311, 3857, 13, 51367], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 60, "seek": 24098, "start": 261.12, "end": 263.34, "text": " It's not alive or dead until you look.", "tokens": [51372, 467, 311, 406, 5465, 420, 3116, 1826, 291, 574, 13, 51483], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 61, "seek": 24098, "start": 263.44, "end": 264.92, "text": " It's a weird combination of both.", "tokens": [51488, 467, 311, 257, 3657, 6562, 295, 1293, 13, 51562], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 62, "seek": 24098, "start": 265.06, "end": 265.53999999999996, "text": " Precisely.", "tokens": [51569, 48746, 736, 13, 51593], "temperature": 0.0, "avg_logprob": -0.11935320695241293, "compression_ratio": 1.5517241379310345, "no_speech_prob": 1.89063500098674e-12}, {"id": 63, "seek": 26554, "start": 265.54, "end": 271.92, "text": " So to describe a system that is a combination of many possible states, mathematicians realized", "tokens": [50365, 407, 281, 6786, 257, 1185, 300, 307, 257, 6562, 295, 867, 1944, 4368, 11, 32811, 2567, 5334, 50684], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 64, "seek": 26554, "start": 271.92, "end": 275.68, "text": " they needed an infinite dimensional linear vector space.", "tokens": [50684, 436, 2978, 364, 13785, 18795, 8213, 8062, 1901, 13, 50872], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 65, "seek": 26554, "start": 276.3, "end": 277.78000000000003, "text": " Okay, that sounds intense.", "tokens": [50903, 1033, 11, 300, 3263, 9447, 13, 50977], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 66, "seek": 26554, "start": 277.92, "end": 279.84000000000003, "text": " Think of it like a three-dimensional grid, right?", "tokens": [50984, 6557, 295, 309, 411, 257, 1045, 12, 18759, 10748, 11, 558, 30, 51080], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 67, "seek": 26554, "start": 279.88, "end": 281.38, "text": " The x, y, and z axes.", "tokens": [51082, 440, 2031, 11, 288, 11, 293, 710, 35387, 13, 51157], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 68, "seek": 26554, "start": 281.92, "end": 284.68, "text": " But extend it out to an infinite number of axes.", "tokens": [51184, 583, 10101, 309, 484, 281, 364, 13785, 1230, 295, 35387, 13, 51322], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 69, "seek": 26554, "start": 285.12, "end": 290.36, "text": " Every possible state a quantum system could be in gets its own axis, its own coordinate direction", "tokens": [51344, 2048, 1944, 1785, 257, 13018, 1185, 727, 312, 294, 2170, 1080, 1065, 10298, 11, 1080, 1065, 15670, 3513, 51606], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 70, "seek": 26554, "start": 290.36, "end": 291.8, "text": " in this massive space.", "tokens": [51606, 294, 341, 5994, 1901, 13, 51678], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 71, "seek": 26554, "start": 291.92, "end": 292.1, "text": " Yeah.", "tokens": [51684, 865, 13, 51693], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 72, "seek": 26554, "start": 292.28000000000003, "end": 294.22, "text": " This mathematical arena is the Hilbert space.", "tokens": [51702, 639, 18894, 18451, 307, 264, 19914, 4290, 1901, 13, 51799], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 73, "seek": 26554, "start": 294.3, "end": 294.56, "text": " Okay.", "tokens": [51803, 1033, 13, 51816], "temperature": 0.0, "avg_logprob": -0.18261758742793913, "compression_ratio": 1.6890459363957597, "no_speech_prob": 1.942742841598566e-12}, {"id": 74, "seek": 29456, "start": 294.56, "end": 296.5, "text": " But it's not just a blank grid.", "tokens": [50365, 583, 309, 311, 406, 445, 257, 8247, 10748, 13, 50462], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 75, "seek": 29456, "start": 296.9, "end": 301.82, "text": " It comes equipped with a very specific, highly rigid rule about how you measure things inside", "tokens": [50482, 467, 1487, 15218, 365, 257, 588, 2685, 11, 5405, 22195, 4978, 466, 577, 291, 3481, 721, 1854, 50728], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 76, "seek": 29456, "start": 301.82, "end": 301.96, "text": " it.", "tokens": [50728, 309, 13, 50735], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 77, "seek": 29456, "start": 302.04, "end": 304.56, "text": " It has what's called a positive definite inner product.", "tokens": [50739, 467, 575, 437, 311, 1219, 257, 3353, 25131, 7284, 1674, 13, 50865], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 78, "seek": 29456, "start": 304.78000000000003, "end": 305.76, "text": " Okay, an inner product.", "tokens": [50876, 1033, 11, 364, 7284, 1674, 13, 50925], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 79, "seek": 29456, "start": 305.86, "end": 307.26, "text": " Let me make sure I'm mapping this correctly.", "tokens": [50930, 961, 385, 652, 988, 286, 478, 18350, 341, 8944, 13, 51000], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 80, "seek": 29456, "start": 307.42, "end": 313.82, "text": " In standard geometry, if I have two vectors, like two arrows pointing in space, an inner product", "tokens": [51008, 682, 3832, 18426, 11, 498, 286, 362, 732, 18875, 11, 411, 732, 19669, 12166, 294, 1901, 11, 364, 7284, 1674, 51328], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 81, "seek": 29456, "start": 313.82, "end": 317.66, "text": " or a dot product is a way of multiplying them together to see how much they overlap.", "tokens": [51328, 420, 257, 5893, 1674, 307, 257, 636, 295, 30955, 552, 1214, 281, 536, 577, 709, 436, 19959, 13, 51520], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 82, "seek": 29456, "start": 318.28, "end": 323.66, "text": " If it's a vector times itself, the inner product gives you the length of that arrow squared.", "tokens": [51551, 759, 309, 311, 257, 8062, 1413, 2564, 11, 264, 7284, 1674, 2709, 291, 264, 4641, 295, 300, 11610, 8889, 13, 51820], "temperature": 0.0, "avg_logprob": -0.12532456476885573, "compression_ratio": 1.706451612903226, "no_speech_prob": 1.4440985299929432e-12}, {"id": 83, "seek": 32366, "start": 323.66, "end": 325.14000000000004, "text": " That is exactly right.", "tokens": [50365, 663, 307, 2293, 558, 13, 50439], "temperature": 0.0, "avg_logprob": -0.22724695558901187, "compression_ratio": 1.403973509933775, "no_speech_prob": 1.3940880784837906e-12}, {"id": 84, "seek": 32366, "start": 325.38000000000005, "end": 329.26000000000005, "text": " Now, in quantum mechanics, the vectors aren't pointing in physical space.", "tokens": [50451, 823, 11, 294, 13018, 12939, 11, 264, 18875, 3212, 380, 12166, 294, 4001, 1901, 13, 50645], "temperature": 0.0, "avg_logprob": -0.22724695558901187, "compression_ratio": 1.403973509933775, "no_speech_prob": 1.3940880784837906e-12}, {"id": 85, "seek": 32366, "start": 329.38000000000005, "end": 330.98, "text": " They represent the state of the system.", "tokens": [50651, 814, 2906, 264, 1785, 295, 264, 1185, 13, 50731], "temperature": 0.0, "avg_logprob": -0.22724695558901187, "compression_ratio": 1.403973509933775, "no_speech_prob": 1.3940880784837906e-12}, {"id": 86, "seek": 32366, "start": 331.34000000000003, "end": 335.52000000000004, "text": " And the length squared of that state vector represents probability.", "tokens": [50749, 400, 264, 4641, 8889, 295, 300, 1785, 8062, 8855, 8482, 13, 50958], "temperature": 0.0, "avg_logprob": -0.22724695558901187, "compression_ratio": 1.403973509933775, "no_speech_prob": 1.3940880784837906e-12}, {"id": 87, "seek": 32366, "start": 335.76000000000005, "end": 336.26000000000005, "text": " Got it.", "tokens": [50970, 5803, 309, 13, 50995], "temperature": 0.0, "avg_logprob": -0.22724695558901187, "compression_ratio": 1.403973509933775, "no_speech_prob": 1.3940880784837906e-12}, {"id": 88, "seek": 33626, "start": 336.26, "end": 342.36, "text": " The inner product is the mathematical engine that takes the abstract quantum state and spits", "tokens": [50365, 440, 7284, 1674, 307, 264, 18894, 2848, 300, 2516, 264, 12649, 13018, 1785, 293, 637, 1208, 50670], "temperature": 0.0, "avg_logprob": -0.10960883252760943, "compression_ratio": 1.6789473684210525, "no_speech_prob": 1.711144572390244e-12}, {"id": 89, "seek": 33626, "start": 342.36, "end": 345.98, "text": " out the probability that you will actually observe that state in a laboratory.", "tokens": [50670, 484, 264, 8482, 300, 291, 486, 767, 11441, 300, 1785, 294, 257, 16523, 13, 50851], "temperature": 0.0, "avg_logprob": -0.10960883252760943, "compression_ratio": 1.6789473684210525, "no_speech_prob": 1.711144572390244e-12}, {"id": 90, "seek": 33626, "start": 346.36, "end": 348.59999999999997, "text": " And because it's a positive definite inner product?", "tokens": [50870, 400, 570, 309, 311, 257, 3353, 25131, 7284, 1674, 30, 50982], "temperature": 0.0, "avg_logprob": -0.10960883252760943, "compression_ratio": 1.6789473684210525, "no_speech_prob": 1.711144572390244e-12}, {"id": 91, "seek": 33626, "start": 348.59999999999997, "end": 352.59999999999997, "text": " Because it is positive definite, it guarantees that no matter what vector you choose, no matter", "tokens": [50982, 1436, 309, 307, 3353, 25131, 11, 309, 32567, 300, 572, 1871, 437, 8062, 291, 2826, 11, 572, 1871, 51182], "temperature": 0.0, "avg_logprob": -0.10960883252760943, "compression_ratio": 1.6789473684210525, "no_speech_prob": 1.711144572390244e-12}, {"id": 92, "seek": 35260, "start": 352.6, "end": 358.42, "text": " what crazy quantum state you calculate, the inner product, the probability, will always", "tokens": [50365, 437, 3219, 13018, 1785, 291, 8873, 11, 264, 7284, 1674, 11, 264, 8482, 11, 486, 1009, 50656], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 93, "seek": 35260, "start": 358.42, "end": 360.6, "text": " be a positive number or zero.", "tokens": [50656, 312, 257, 3353, 1230, 420, 4018, 13, 50765], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 94, "seek": 35260, "start": 361.1, "end": 363.08000000000004, "text": " But it can never, ever be negative.", "tokens": [50790, 583, 309, 393, 1128, 11, 1562, 312, 3671, 13, 50889], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 95, "seek": 35260, "start": 363.36, "end": 365.74, "text": " Which intuitively makes total sense.", "tokens": [50903, 3013, 46506, 1669, 3217, 2020, 13, 51022], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 96, "seek": 35260, "start": 365.88, "end": 371.26000000000005, "text": " I mean, if I flip a coin, I can have a 50% chance of getting heads or a 0% chance if the", "tokens": [51029, 286, 914, 11, 498, 286, 7929, 257, 11464, 11, 286, 393, 362, 257, 2625, 4, 2931, 295, 1242, 8050, 420, 257, 1958, 4, 2931, 498, 264, 51298], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 97, "seek": 35260, "start": 371.26000000000005, "end": 372.40000000000003, "text": " coin is totally rigged.", "tokens": [51298, 11464, 307, 3879, 8329, 3004, 13, 51355], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 98, "seek": 35260, "start": 372.5, "end": 376.76000000000005, "text": " But I cannot possibly have a negative 50% chance of getting heads.", "tokens": [51360, 583, 286, 2644, 6264, 362, 257, 3671, 2625, 4, 2931, 295, 1242, 8050, 13, 51573], "temperature": 0.0, "avg_logprob": -0.15162076950073242, "compression_ratio": 1.6444444444444444, "no_speech_prob": 1.4724509589045254e-12}, {"id": 99, "seek": 37676, "start": 376.76, "end": 380.21999999999997, "text": " A negative probability is a physical absurdity.", "tokens": [50365, 316, 3671, 8482, 307, 257, 4001, 19774, 507, 13, 50538], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 100, "seek": 37676, "start": 380.36, "end": 381.98, "text": " It is a complete physical absurdity.", "tokens": [50545, 467, 307, 257, 3566, 4001, 19774, 507, 13, 50626], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 101, "seek": 37676, "start": 382.36, "end": 386.65999999999997, "text": " And because it's absurd, the founders of quantum mechanics made a philosophical commitment.", "tokens": [50645, 400, 570, 309, 311, 19774, 11, 264, 25608, 295, 13018, 12939, 1027, 257, 25066, 8371, 13, 50860], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 102, "seek": 37676, "start": 387.36, "end": 389.0, "text": " It wasn't just a mathematical choice.", "tokens": [50895, 467, 2067, 380, 445, 257, 18894, 3922, 13, 50977], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 103, "seek": 37676, "start": 389.2, "end": 392.4, "text": " It was a deeply ingrained ontological belief.", "tokens": [50987, 467, 390, 257, 8760, 3957, 31774, 6592, 4383, 7107, 13, 51147], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 104, "seek": 37676, "start": 393.02, "end": 395.44, "text": " This is what Flixson calls the Hilbert Assumption.", "tokens": [51178, 639, 307, 437, 3235, 970, 3015, 5498, 264, 19914, 4290, 6281, 449, 1695, 13, 51299], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 105, "seek": 37676, "start": 395.5, "end": 396.62, "text": " The Hilbert Assumption.", "tokens": [51302, 440, 19914, 4290, 6281, 449, 1695, 13, 51358], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 106, "seek": 37676, "start": 396.65999999999997, "end": 396.84, "text": " Right.", "tokens": [51360, 1779, 13, 51369], "temperature": 0.0, "avg_logprob": -0.1866522042647652, "compression_ratio": 1.6363636363636365, "no_speech_prob": 1.868613336980518e-12}, {"id": 107, "seek": 39684, "start": 396.84, "end": 402.7, "text": " It is the unspoken foundational dogma that the entire internal mathematical state space,", "tokens": [50365, 467, 307, 264, 2693, 79, 8406, 32195, 3000, 1696, 300, 264, 2302, 6920, 18894, 1785, 1901, 11, 50658], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 108, "seek": 39684, "start": 403.17999999999995, "end": 408.97999999999996, "text": " every single gear, pulley, and vector inside the equations, must perfectly equal the observable", "tokens": [50682, 633, 2167, 7394, 11, 48399, 11, 293, 8062, 1854, 264, 11787, 11, 1633, 6239, 2681, 264, 9951, 712, 50972], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 109, "seek": 39684, "start": 408.97999999999996, "end": 409.88, "text": " physical reality.", "tokens": [50972, 4001, 4103, 13, 51017], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 110, "seek": 39684, "start": 410.06, "end": 414.65999999999997, "text": " So the rule is, if I can't hold it in my hand, or at least measure it on a Geiger counter", "tokens": [51026, 407, 264, 4978, 307, 11, 498, 286, 393, 380, 1797, 309, 294, 452, 1011, 11, 420, 412, 1935, 3481, 309, 322, 257, 2876, 4810, 5682, 51256], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 111, "seek": 39684, "start": 414.65999999999997, "end": 419.34, "text": " as a positive probability, it is absolutely not allowed to exist anywhere in the mathematics.", "tokens": [51256, 382, 257, 3353, 8482, 11, 309, 307, 3122, 406, 4350, 281, 2514, 4992, 294, 264, 18666, 13, 51490], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 112, "seek": 39684, "start": 419.76, "end": 420.08, "text": " Yes.", "tokens": [51511, 1079, 13, 51527], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 113, "seek": 39684, "start": 420.76, "end": 423.55999999999995, "text": " The Hilbert Assumption declares a strict one-to-one mapping.", "tokens": [51561, 440, 19914, 4290, 6281, 449, 1695, 979, 19415, 257, 10910, 472, 12, 1353, 12, 546, 18350, 13, 51701], "temperature": 0.0, "avg_logprob": -0.10780953117038893, "compression_ratio": 1.5971731448763251, "no_speech_prob": 1.7901684908755433e-12}, {"id": 114, "seek": 42356, "start": 424.22, "end": 426.96, "text": " Observable physics equals the entire state space.", "tokens": [50398, 42547, 712, 10649, 6915, 264, 2302, 1785, 1901, 13, 50535], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 115, "seek": 42356, "start": 427.4, "end": 431.12, "text": " Every element of the math must be a candidate physical state.", "tokens": [50557, 2048, 4478, 295, 264, 5221, 1633, 312, 257, 11532, 4001, 1785, 13, 50743], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 116, "seek": 42356, "start": 431.46, "end": 433.62, "text": " And this brings us to Flixson's core premise.", "tokens": [50760, 400, 341, 5607, 505, 281, 3235, 970, 3015, 311, 4965, 22045, 13, 50868], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 117, "seek": 42356, "start": 434.72, "end": 436.22, "text": " What if we break that mapping?", "tokens": [50923, 708, 498, 321, 1821, 300, 18350, 30, 50998], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 118, "seek": 42356, "start": 436.32, "end": 438.34000000000003, "text": " What if we don't force them to be identical?", "tokens": [51003, 708, 498, 321, 500, 380, 3464, 552, 281, 312, 14800, 30, 51104], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 119, "seek": 42356, "start": 438.76, "end": 439.14, "text": " Exactly.", "tokens": [51125, 7587, 13, 51144], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 120, "seek": 42356, "start": 439.32, "end": 442.5, "text": " What if we separate the internal map from the external territory?", "tokens": [51153, 708, 498, 321, 4994, 264, 6920, 4471, 490, 264, 8320, 11360, 30, 51312], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 121, "seek": 42356, "start": 443.08, "end": 448.42, "text": " Flixson proposes that the internal mathematical representation, which the paper calls the admissibility", "tokens": [51341, 3235, 970, 3015, 2365, 4201, 300, 264, 6920, 18894, 10290, 11, 597, 264, 3035, 5498, 264, 5910, 891, 2841, 51608], "temperature": 0.0, "avg_logprob": -0.1778893564261642, "compression_ratio": 1.6680161943319838, "no_speech_prob": 1.7214483961566773e-12}, {"id": 122, "seek": 44842, "start": 448.42, "end": 456.56, "text": " manifold, or MM, can be vastly larger, wilder, and mathematically weirder than what we actually", "tokens": [50365, 47138, 11, 420, 34191, 11, 393, 312, 41426, 4833, 11, 4868, 260, 11, 293, 44003, 321, 347, 1068, 813, 437, 321, 767, 50772], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 123, "seek": 44842, "start": 456.56, "end": 459.54, "text": " observe, which is the observable manifold, or MOBs.", "tokens": [50772, 11441, 11, 597, 307, 264, 9951, 712, 47138, 11, 420, 19290, 33, 82, 13, 50921], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 124, "seek": 44842, "start": 459.54, "end": 464.20000000000005, "text": " The paper introduces a really great piece of terminology for this specific error in physics.", "tokens": [50921, 440, 3035, 31472, 257, 534, 869, 2522, 295, 27575, 337, 341, 2685, 6713, 294, 10649, 13, 51154], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 125, "seek": 44842, "start": 464.20000000000005, "end": 466.56, "text": " It calls it latent fundamentalism.", "tokens": [51154, 467, 5498, 309, 48994, 8088, 1434, 13, 51272], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 126, "seek": 44842, "start": 466.64, "end": 469.34000000000003, "text": " And I want to linger on this because it's not just a physics problem.", "tokens": [51276, 400, 286, 528, 281, 45657, 322, 341, 570, 309, 311, 406, 445, 257, 10649, 1154, 13, 51411], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 127, "seek": 44842, "start": 469.46000000000004, "end": 471.64, "text": " It's a profound philosophical trap.", "tokens": [51417, 467, 311, 257, 14382, 25066, 11487, 13, 51526], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 128, "seek": 44842, "start": 471.76, "end": 472.32, "text": " It really is.", "tokens": [51532, 467, 534, 307, 13, 51560], "temperature": 0.0, "avg_logprob": -0.1267122474371218, "compression_ratio": 1.58, "no_speech_prob": 1.803412996194409e-12}, {"id": 129, "seek": 47232, "start": 472.32, "end": 477.42, "text": " Latent fundamentalism is the error of granting ontological status, meaning believing something", "tokens": [50365, 7354, 317, 8088, 1434, 307, 264, 6713, 295, 50204, 6592, 4383, 6558, 11, 3620, 16594, 746, 50620], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 130, "seek": 47232, "start": 477.42, "end": 482.08, "text": " is physically, tangibly real to an internal coordinate just because it happens to appear", "tokens": [50620, 307, 9762, 11, 10266, 3545, 957, 281, 364, 6920, 15670, 445, 570, 309, 2314, 281, 4204, 50853], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 131, "seek": 47232, "start": 482.08, "end": 483.84, "text": " in a successful mathematical model.", "tokens": [50853, 294, 257, 4406, 18894, 2316, 13, 50941], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 132, "seek": 47232, "start": 484.09999999999997, "end": 485.12, "text": " It's a brilliant term.", "tokens": [50954, 467, 311, 257, 10248, 1433, 13, 51005], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 133, "seek": 47232, "start": 485.44, "end": 490.8, "text": " It perfectly diagnoses a cognitive bias that has plagued theoretical physics for a century.", "tokens": [51021, 467, 6239, 7234, 4201, 257, 15605, 12577, 300, 575, 33756, 5827, 20864, 10649, 337, 257, 4901, 13, 51289], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 134, "seek": 47232, "start": 491.44, "end": 493.0, "text": " Think about how science usually works.", "tokens": [51321, 6557, 466, 577, 3497, 2673, 1985, 13, 51399], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 135, "seek": 47232, "start": 493.64, "end": 498.24, "text": " You build a mathematical machine that successfully predicts the outcome of a complex experiment.", "tokens": [51431, 509, 1322, 257, 18894, 3479, 300, 10727, 6069, 82, 264, 9700, 295, 257, 3997, 5120, 13, 51661], "temperature": 0.0, "avg_logprob": -0.11394183158874512, "compression_ratio": 1.6319444444444444, "no_speech_prob": 1.4324997351516933e-12}, {"id": 136, "seek": 49824, "start": 498.24, "end": 498.8, "text": " Right.", "tokens": [50365, 1779, 13, 50393], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 137, "seek": 49824, "start": 499.16, "end": 502.76, "text": " You run the numbers, and the machine tells you the electron will hit the screen exactly", "tokens": [50411, 509, 1190, 264, 3547, 11, 293, 264, 3479, 5112, 291, 264, 6084, 486, 2045, 264, 2568, 2293, 50591], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 138, "seek": 49824, "start": 502.76, "end": 503.34000000000003, "text": " right there.", "tokens": [50591, 558, 456, 13, 50620], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 139, "seek": 49824, "start": 503.48, "end": 505.78000000000003, "text": " You run the experiment, and it hits exactly there.", "tokens": [50627, 509, 1190, 264, 5120, 11, 293, 309, 8664, 2293, 456, 13, 50742], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 140, "seek": 49824, "start": 506.42, "end": 511.6, "text": " The natural human instinct is to look inside your mathematical machine, point to a specific", "tokens": [50774, 440, 3303, 1952, 16556, 307, 281, 574, 1854, 428, 18894, 3479, 11, 935, 281, 257, 2685, 51033], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 141, "seek": 49824, "start": 511.6, "end": 518.2, "text": " variable or a specific term in the equation, and say, because my machine correctly predicted", "tokens": [51033, 7006, 420, 257, 2685, 1433, 294, 264, 5367, 11, 293, 584, 11, 570, 452, 3479, 8944, 19147, 51363], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 142, "seek": 49824, "start": 518.2, "end": 524.3, "text": " reality, this specific gear inside the machine must literally exist in the physical universe.", "tokens": [51363, 4103, 11, 341, 2685, 7394, 1854, 264, 3479, 1633, 3736, 2514, 294, 264, 4001, 6445, 13, 51668], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 143, "seek": 49824, "start": 524.46, "end": 527.22, "text": " But Flixson argues that is a massive logical leap.", "tokens": [51676, 583, 3235, 970, 3015, 38218, 300, 307, 257, 5994, 14978, 19438, 13, 51814], "temperature": 0.0, "avg_logprob": -0.11715421506336757, "compression_ratio": 1.7681159420289856, "no_speech_prob": 1.7967584885203447e-12}, {"id": 144, "seek": 52722, "start": 527.22, "end": 532.0400000000001, "text": " The internal machinery, the admissibility manifold, is just a space of histories, coordinates,", "tokens": [50365, 440, 6920, 27302, 11, 264, 5910, 891, 2841, 47138, 11, 307, 445, 257, 1901, 295, 30631, 11, 21056, 11, 50606], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 145, "seek": 52722, "start": 532.24, "end": 532.78, "text": " and constraints.", "tokens": [50616, 293, 18491, 13, 50643], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 146, "seek": 52722, "start": 533.28, "end": 536.38, "text": " It doesn't have to map one-to-one with the observable outcomes.", "tokens": [50668, 467, 1177, 380, 362, 281, 4471, 472, 12, 1353, 12, 546, 365, 264, 9951, 712, 10070, 13, 50823], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 147, "seek": 52722, "start": 537.32, "end": 541.82, "text": " Let me ground this with a financial analogy, because I think this maps perfectly to how human", "tokens": [50870, 961, 385, 2727, 341, 365, 257, 4669, 21663, 11, 570, 286, 519, 341, 11317, 6239, 281, 577, 1952, 51095], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 148, "seek": 52722, "start": 541.82, "end": 543.76, "text": " beings actually run complex systems.", "tokens": [51095, 8958, 767, 1190, 3997, 3652, 13, 51192], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 149, "seek": 52722, "start": 543.82, "end": 544.4200000000001, "text": " I like this.", "tokens": [51195, 286, 411, 341, 13, 51225], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 150, "seek": 52722, "start": 544.52, "end": 544.74, "text": " Go ahead.", "tokens": [51230, 1037, 2286, 13, 51241], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 151, "seek": 52722, "start": 545.02, "end": 546.72, "text": " Think of an accountant's corporate ledger.", "tokens": [51255, 6557, 295, 364, 43898, 311, 10896, 4684, 1321, 13, 51340], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 152, "seek": 52722, "start": 547.14, "end": 552.5600000000001, "text": " The internal ledger of a massive multinational corporation uses negative numbers all the time.", "tokens": [51361, 440, 6920, 4684, 1321, 295, 257, 5994, 45872, 1478, 22197, 4960, 3671, 3547, 439, 264, 565, 13, 51632], "temperature": 0.0, "avg_logprob": -0.13397442061325598, "compression_ratio": 1.610344827586207, "no_speech_prob": 1.708059258268002e-12}, {"id": 153, "seek": 55256, "start": 552.56, "end": 557.3, "text": " It uses debts, liabilities, phantom placeholder accounts, depreciation curves.", "tokens": [50365, 467, 4960, 32528, 11, 375, 6167, 11, 903, 25796, 1081, 20480, 9402, 11, 40609, 399, 19490, 13, 50602], "temperature": 0.0, "avg_logprob": -0.1725776272435342, "compression_ratio": 1.4508670520231215, "no_speech_prob": 1.543105053458671e-12}, {"id": 154, "seek": 55256, "start": 558.1199999999999, "end": 561.4, "text": " That internal ledger is the admissibility manifold.", "tokens": [50643, 663, 6920, 4684, 1321, 307, 264, 5910, 891, 2841, 47138, 13, 50807], "temperature": 0.0, "avg_logprob": -0.1725776272435342, "compression_ratio": 1.4508670520231215, "no_speech_prob": 1.543105053458671e-12}, {"id": 155, "seek": 55256, "start": 562.16, "end": 566.1199999999999, "text": " An accountant has to use negative numbers to balance the books and make the financial", "tokens": [50845, 1107, 43898, 575, 281, 764, 3671, 3547, 281, 4772, 264, 3642, 293, 652, 264, 4669, 51043], "temperature": 0.0, "avg_logprob": -0.1725776272435342, "compression_ratio": 1.4508670520231215, "no_speech_prob": 1.543105053458671e-12}, {"id": 156, "seek": 55256, "start": 566.1199999999999, "end": 567.64, "text": " reality function over time.", "tokens": [51043, 4103, 2445, 670, 565, 13, 51119], "temperature": 0.0, "avg_logprob": -0.1725776272435342, "compression_ratio": 1.4508670520231215, "no_speech_prob": 1.543105053458671e-12}, {"id": 157, "seek": 55256, "start": 567.88, "end": 567.9599999999999, "text": " Right.", "tokens": [51131, 1779, 13, 51135], "temperature": 0.0, "avg_logprob": -0.1725776272435342, "compression_ratio": 1.4508670520231215, "no_speech_prob": 1.543105053458671e-12}, {"id": 158, "seek": 56796, "start": 567.96, "end": 573.9200000000001, "text": " But the actual money a customer can withdraw from the ATM, the observable manifold, must", "tokens": [50365, 583, 264, 3539, 1460, 257, 5474, 393, 14999, 490, 264, 46455, 11, 264, 9951, 712, 47138, 11, 1633, 50663], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 159, "seek": 56796, "start": 573.9200000000001, "end": 575.5, "text": " always be a positive number.", "tokens": [50663, 1009, 312, 257, 3353, 1230, 13, 50742], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 160, "seek": 56796, "start": 575.7800000000001, "end": 578.7800000000001, "text": " You can't physically hold a negative $20 bill in your hand.", "tokens": [50756, 509, 393, 380, 9762, 1797, 257, 3671, 1848, 2009, 2961, 294, 428, 1011, 13, 50906], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 161, "seek": 56796, "start": 578.88, "end": 581.12, "text": " That is an exceptionally precise analogy.", "tokens": [50911, 663, 307, 364, 37807, 13600, 21663, 13, 51023], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 162, "seek": 56796, "start": 581.6800000000001, "end": 586.08, "text": " The internal accounting absolutely requires negative numbers to function efficiently and", "tokens": [51051, 440, 6920, 19163, 3122, 7029, 3671, 3547, 281, 2445, 19621, 293, 51271], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 163, "seek": 56796, "start": 586.08, "end": 589.12, "text": " to capture the full dynamical picture of the corporation's finances.", "tokens": [51271, 281, 7983, 264, 1577, 5999, 804, 3036, 295, 264, 22197, 311, 25123, 13, 51423], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 164, "seek": 56796, "start": 589.6, "end": 591.76, "text": " The negative numbers are mathematically indispensable.", "tokens": [51447, 440, 3671, 3547, 366, 44003, 47940, 13, 51555], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 165, "seek": 56796, "start": 591.98, "end": 592.2, "text": " Yeah.", "tokens": [51566, 865, 13, 51577], "temperature": 0.0, "avg_logprob": -0.1175757348537445, "compression_ratio": 1.6043956043956045, "no_speech_prob": 1.6617317331185655e-12}, {"id": 166, "seek": 59220, "start": 592.2, "end": 597.1600000000001, "text": " But the observable output, the cash that interacts with the physical world, is strictly positive.", "tokens": [50365, 583, 264, 9951, 712, 5598, 11, 264, 6388, 300, 43582, 365, 264, 4001, 1002, 11, 307, 20792, 3353, 13, 50613], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 167, "seek": 59220, "start": 597.7800000000001, "end": 601.9200000000001, "text": " The accountant doesn't panic when they write a negative number in column B, because they", "tokens": [50644, 440, 43898, 1177, 380, 14783, 562, 436, 2464, 257, 3671, 1230, 294, 7738, 363, 11, 570, 436, 50851], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 168, "seek": 59220, "start": 601.9200000000001, "end": 603.94, "text": " understand the difference between the ledger and the ATM.", "tokens": [50851, 1223, 264, 2649, 1296, 264, 4684, 1321, 293, 264, 46455, 13, 50952], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 169, "seek": 59220, "start": 604.36, "end": 608.1600000000001, "text": " So if accountants understand this, why don't physicists?", "tokens": [50973, 407, 498, 2696, 1719, 1223, 341, 11, 983, 500, 380, 48716, 30, 51163], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 170, "seek": 59220, "start": 608.7800000000001, "end": 613.36, "text": " Why do the physics community suddenly demand that their internal ledger only have positive", "tokens": [51194, 1545, 360, 264, 10649, 1768, 5800, 4733, 300, 641, 6920, 4684, 1321, 787, 362, 3353, 51423], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 171, "seek": 59220, "start": 613.36, "end": 613.76, "text": " numbers?", "tokens": [51423, 3547, 30, 51443], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 172, "seek": 59220, "start": 614.08, "end": 617.6800000000001, "text": " Well, here is the incredible irony that Flickshina highlights in the paper.", "tokens": [51459, 1042, 11, 510, 307, 264, 4651, 35365, 300, 3235, 618, 2716, 1426, 14254, 294, 264, 3035, 13, 51639], "temperature": 0.0, "avg_logprob": -0.15385888475890552, "compression_ratio": 1.6914893617021276, "no_speech_prob": 1.7971858810167385e-12}, {"id": 173, "seek": 61768, "start": 617.68, "end": 623.06, "text": " However, physicists actually do understand this, and they already use larger state spaces with", "tokens": [50365, 2908, 11, 48716, 767, 360, 1223, 341, 11, 293, 436, 1217, 764, 4833, 1785, 7673, 365, 50634], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 174, "seek": 61768, "start": 623.06, "end": 625.06, "text": " negative numbers in other areas of physics.", "tokens": [50634, 3671, 3547, 294, 661, 3179, 295, 10649, 13, 50734], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 175, "seek": 61768, "start": 625.5799999999999, "end": 630.8, "text": " They just developed a bizarre, highly specific amnesia when it came to gravity.", "tokens": [50760, 814, 445, 4743, 257, 18265, 11, 5405, 2685, 669, 4081, 654, 562, 309, 1361, 281, 12110, 13, 51021], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 176, "seek": 61768, "start": 631.02, "end": 631.4, "text": " Wait, really?", "tokens": [51032, 3802, 11, 534, 30, 51051], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 177, "seek": 61768, "start": 631.54, "end": 632.12, "text": " Give me an example.", "tokens": [51058, 5303, 385, 364, 1365, 13, 51087], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 178, "seek": 61768, "start": 632.38, "end": 635.62, "text": " Where is the negative money in the standard physics ledger right now?", "tokens": [51100, 2305, 307, 264, 3671, 1460, 294, 264, 3832, 10649, 4684, 1321, 558, 586, 30, 51262], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 179, "seek": 61768, "start": 635.76, "end": 640.2199999999999, "text": " Take quantum electrodynamics, QED, which is the quantum theory of light and electrons.", "tokens": [51269, 3664, 13018, 44216, 5216, 1167, 11, 1249, 4731, 11, 597, 307, 264, 13018, 5261, 295, 1442, 293, 14265, 13, 51492], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 180, "seek": 61768, "start": 640.7399999999999, "end": 644.64, "text": " It is arguably the most precisely tested theory in the history of science.", "tokens": [51518, 467, 307, 26771, 264, 881, 13402, 8246, 5261, 294, 264, 2503, 295, 3497, 13, 51713], "temperature": 0.0, "avg_logprob": -0.13682609226392664, "compression_ratio": 1.6406779661016948, "no_speech_prob": 1.6621421036408512e-12}, {"id": 181, "seek": 64464, "start": 644.64, "end": 650.34, "text": " When physicists formulate QED using what is called the Lorentz gauge, which is a mathematical", "tokens": [50365, 1133, 48716, 47881, 1249, 4731, 1228, 437, 307, 1219, 264, 36994, 580, 89, 17924, 11, 597, 307, 257, 18894, 50650], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 182, "seek": 64464, "start": 650.34, "end": 654.9399999999999, "text": " framework that ensures the equations respects Einstein's speed of light, the math actually", "tokens": [50650, 8388, 300, 28111, 264, 11787, 24126, 23486, 311, 3073, 295, 1442, 11, 264, 5221, 767, 50880], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 183, "seek": 64464, "start": 654.9399999999999, "end": 658.04, "text": " forces them to use an indefinite metric state space.", "tokens": [50880, 5874, 552, 281, 764, 364, 24162, 5194, 642, 20678, 1785, 1901, 13, 51035], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 184, "seek": 64464, "start": 658.56, "end": 659.6, "text": " What does that mean, practically?", "tokens": [51061, 708, 775, 300, 914, 11, 15667, 30, 51113], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 185, "seek": 64464, "start": 660.0, "end": 663.42, "text": " This space literally contains negative norm photon states.", "tokens": [51133, 639, 1901, 3736, 8306, 3671, 2026, 37443, 4368, 13, 51304], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 186, "seek": 64464, "start": 663.84, "end": 666.04, "text": " They're called longitudinal and scalar photons.", "tokens": [51325, 814, 434, 1219, 48250, 293, 39684, 40209, 13, 51435], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 187, "seek": 64464, "start": 666.4399999999999, "end": 670.98, "text": " If you try to calculate the probability of one of these photons existing, the math spits out", "tokens": [51455, 759, 291, 853, 281, 8873, 264, 8482, 295, 472, 295, 613, 40209, 6741, 11, 264, 5221, 637, 1208, 484, 51682], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 188, "seek": 64464, "start": 670.98, "end": 671.92, "text": " a negative probability.", "tokens": [51682, 257, 3671, 8482, 13, 51729], "temperature": 0.0, "avg_logprob": -0.13123866244479343, "compression_ratio": 1.65, "no_speech_prob": 1.7351043562000013e-12}, {"id": 189, "seek": 67192, "start": 671.92, "end": 677.0999999999999, "text": " Wait, wait, so we literally have negative probability photons hiding in the standard", "tokens": [50365, 3802, 11, 1699, 11, 370, 321, 3736, 362, 3671, 8482, 40209, 10596, 294, 264, 3832, 50624], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 190, "seek": 67192, "start": 677.0999999999999, "end": 678.04, "text": " equations of light?", "tokens": [50624, 11787, 295, 1442, 30, 50671], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 191, "seek": 67192, "start": 678.1999999999999, "end": 679.06, "text": " We absolutely do.", "tokens": [50679, 492, 3122, 360, 13, 50722], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 192, "seek": 67192, "start": 679.4, "end": 684.0999999999999, "text": " They exist in the math to ensure the equations remain symmetric and respect the laws of relativity.", "tokens": [50739, 814, 2514, 294, 264, 5221, 281, 5586, 264, 11787, 6222, 32330, 293, 3104, 264, 6064, 295, 45675, 13, 50974], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 193, "seek": 67192, "start": 685.24, "end": 691.3, "text": " But, especially before we get to the observable physical predictions, before we go to the ATM,", "tokens": [51031, 583, 11, 2318, 949, 321, 483, 281, 264, 9951, 712, 4001, 21264, 11, 949, 321, 352, 281, 264, 46455, 11, 51334], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 194, "seek": 67192, "start": 691.68, "end": 697.06, "text": " as you said, a subsidiary condition known as the Gupta-Bluler condition is applied.", "tokens": [51353, 382, 291, 848, 11, 257, 48296, 822, 4188, 2570, 382, 264, 2694, 47366, 12, 14520, 26318, 4188, 307, 6456, 13, 51622], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 195, "seek": 67192, "start": 697.14, "end": 697.86, "text": " Okay, what does that do?", "tokens": [51626, 1033, 11, 437, 775, 300, 360, 30, 51662], "temperature": 0.0, "avg_logprob": -0.13746058023892915, "compression_ratio": 1.6197718631178708, "no_speech_prob": 1.790023966725951e-12}, {"id": 196, "seek": 69786, "start": 697.86, "end": 701.2, "text": " This mathematical operation effectively projects them out.", "tokens": [50365, 639, 18894, 6916, 8659, 4455, 552, 484, 13, 50532], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 197, "seek": 69786, "start": 702.14, "end": 706.24, "text": " The negative norm photons perfectly cancel each other out in the physical sector.", "tokens": [50579, 440, 3671, 2026, 40209, 6239, 10373, 1184, 661, 484, 294, 264, 4001, 6977, 13, 50784], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 198, "seek": 69786, "start": 706.76, "end": 709.6, "text": " The weird stuff never actually reaches the observable world.", "tokens": [50810, 440, 3657, 1507, 1128, 767, 14235, 264, 9951, 712, 1002, 13, 50952], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 199, "seek": 69786, "start": 709.76, "end": 712.3000000000001, "text": " Okay, so QED uses the negative ledger.", "tokens": [50960, 1033, 11, 370, 1249, 4731, 4960, 264, 3671, 4684, 1321, 13, 51087], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 200, "seek": 69786, "start": 712.74, "end": 713.82, "text": " Are there any other examples?", "tokens": [51109, 2014, 456, 604, 661, 5110, 30, 51163], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 201, "seek": 69786, "start": 713.98, "end": 714.4, "text": " Oh, definitely.", "tokens": [51171, 876, 11, 2138, 13, 51192], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 202, "seek": 69786, "start": 714.82, "end": 716.26, "text": " The strong nuclear force.", "tokens": [51213, 440, 2068, 8179, 3464, 13, 51285], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 203, "seek": 69786, "start": 716.64, "end": 719.86, "text": " The force that holds the quarks together inside protons and neutrons.", "tokens": [51304, 440, 3464, 300, 9190, 264, 421, 20851, 1214, 1854, 40270, 293, 7989, 13270, 13, 51465], "temperature": 0.0, "avg_logprob": -0.17527820251800202, "compression_ratio": 1.5916666666666666, "no_speech_prob": 1.3778461878388715e-12}, {"id": 204, "seek": 71986, "start": 719.86, "end": 723.58, "text": " The math underlying this is called a Yang-Mills gauge theory.", "tokens": [50365, 440, 5221, 14217, 341, 307, 1219, 257, 11978, 12, 44, 2565, 17924, 5261, 13, 50551], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 205, "seek": 71986, "start": 724.08, "end": 728.74, "text": " To make the quantum calculations work, to cancel out mathematical redundancies in the path integral,", "tokens": [50576, 1407, 652, 264, 13018, 20448, 589, 11, 281, 10373, 484, 18894, 27830, 32286, 294, 264, 3100, 11573, 11, 50809], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 206, "seek": 71986, "start": 729.3000000000001, "end": 731.78, "text": " physicists introduce something called Fadiv Popov ghosts.", "tokens": [50837, 48716, 5366, 746, 1219, 479, 345, 592, 10215, 5179, 21744, 13, 50961], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 207, "seek": 71986, "start": 732.0, "end": 732.48, "text": " Ghosts.", "tokens": [50972, 16323, 82, 13, 50996], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 208, "seek": 71986, "start": 732.54, "end": 733.94, "text": " Literally calling them ghosts.", "tokens": [50999, 23768, 5141, 552, 21744, 13, 51069], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 209, "seek": 71986, "start": 734.1800000000001, "end": 734.42, "text": " Yes.", "tokens": [51081, 1079, 13, 51093], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 210, "seek": 71986, "start": 734.72, "end": 735.48, "text": " Literally ghosts.", "tokens": [51108, 23768, 21744, 13, 51146], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 211, "seek": 71986, "start": 736.14, "end": 741.66, "text": " They're entirely fictitious, unphysical fields that obey the wrong quantum statistics.", "tokens": [51179, 814, 434, 7696, 283, 985, 16401, 11, 517, 950, 36280, 7909, 300, 19297, 264, 2085, 13018, 12523, 13, 51455], "temperature": 0.0, "avg_logprob": -0.18483916572902515, "compression_ratio": 1.5905172413793103, "no_speech_prob": 1.661376440066642e-12}, {"id": 212, "seek": 74166, "start": 741.66, "end": 750.36, "text": " In particle physics, particles are either bosons, which like to clump together, or fermions, which violently refuse to occupy the same state.", "tokens": [50365, 682, 12359, 10649, 11, 10007, 366, 2139, 30641, 892, 11, 597, 411, 281, 596, 1420, 1214, 11, 420, 26558, 626, 11, 597, 46728, 16791, 281, 30645, 264, 912, 1785, 13, 50800], "temperature": 0.0, "avg_logprob": -0.1425163122323843, "compression_ratio": 1.473053892215569, "no_speech_prob": 1.889944797883736e-12}, {"id": 213, "seek": 74166, "start": 750.4399999999999, "end": 750.56, "text": " Right.", "tokens": [50804, 1779, 13, 50810], "temperature": 0.0, "avg_logprob": -0.1425163122323843, "compression_ratio": 1.473053892215569, "no_speech_prob": 1.889944797883736e-12}, {"id": 214, "seek": 74166, "start": 751.1, "end": 757.28, "text": " A Fadiv Popov ghost is mathematically treated as a fermion, but it has integer spin like a boson.", "tokens": [50837, 316, 479, 345, 592, 10215, 5179, 8359, 307, 44003, 8668, 382, 257, 26558, 313, 11, 457, 309, 575, 24922, 6060, 411, 257, 30641, 266, 13, 51146], "temperature": 0.0, "avg_logprob": -0.1425163122323843, "compression_ratio": 1.473053892215569, "no_speech_prob": 1.889944797883736e-12}, {"id": 215, "seek": 75728, "start": 757.28, "end": 765.26, "text": " It is a complete fundamental mathematical contradiction, but it exists in the admissibility manifold to balance the books.", "tokens": [50365, 467, 307, 257, 3566, 8088, 18894, 34937, 11, 457, 309, 8198, 294, 264, 5910, 891, 2841, 47138, 281, 4772, 264, 3642, 13, 50764], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 216, "seek": 75728, "start": 765.66, "end": 772.66, "text": " And again, through something called BRST symmetry, these ghosts are completely restricted from ever appearing in the observable manifold.", "tokens": [50784, 400, 797, 11, 807, 746, 1219, 10262, 6840, 25440, 11, 613, 21744, 366, 2584, 20608, 490, 1562, 19870, 294, 264, 9951, 712, 47138, 13, 51134], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 217, "seek": 75728, "start": 773.16, "end": 773.8199999999999, "text": " Let me get this straight.", "tokens": [51159, 961, 385, 483, 341, 2997, 13, 51192], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 218, "seek": 75728, "start": 774.16, "end": 776.78, "text": " The theory of light uses negative probabilities.", "tokens": [51209, 440, 5261, 295, 1442, 4960, 3671, 33783, 13, 51340], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 219, "seek": 75728, "start": 777.42, "end": 783.12, "text": " The theory of the strong nuclear force uses literal mathematical ghosts that violate the laws of quantum statistics.", "tokens": [51372, 440, 5261, 295, 264, 2068, 8179, 3464, 4960, 20411, 18894, 21744, 300, 37478, 264, 6064, 295, 13018, 12523, 13, 51657], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 220, "seek": 75728, "start": 783.54, "end": 785.6, "text": " And the physics community is perfectly fine with this.", "tokens": [51678, 400, 264, 10649, 1768, 307, 6239, 2489, 365, 341, 13, 51781], "temperature": 0.0, "avg_logprob": -0.11208256471504285, "compression_ratio": 1.7013422818791946, "no_speech_prob": 1.6555035337387225e-12}, {"id": 221, "seek": 78560, "start": 785.6, "end": 787.86, "text": " They accept it. They give out Nobel Prizes for it.", "tokens": [50365, 814, 3241, 309, 13, 814, 976, 484, 24611, 8087, 12214, 337, 309, 13, 50478], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 222, "seek": 78560, "start": 787.88, "end": 788.9, "text": " They teach it in grad school.", "tokens": [50479, 814, 2924, 309, 294, 2771, 1395, 13, 50530], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 223, "seek": 78560, "start": 789.14, "end": 789.24, "text": " Yep.", "tokens": [50542, 7010, 13, 50547], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 224, "seek": 78560, "start": 789.4200000000001, "end": 794.72, "text": " So why, when it came to gravity, did everyone suddenly decide that the ledger had to be entirely positive?", "tokens": [50556, 407, 983, 11, 562, 309, 1361, 281, 12110, 11, 630, 1518, 5800, 4536, 300, 264, 4684, 1321, 632, 281, 312, 7696, 3353, 30, 50821], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 225, "seek": 78560, "start": 795.22, "end": 799.66, "text": " Because the ghosts in QED and the strong force are essentially bookkeeping tricks.", "tokens": [50846, 1436, 264, 21744, 294, 1249, 4731, 293, 264, 2068, 3464, 366, 4476, 1446, 25769, 11733, 13, 51068], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 226, "seek": 78560, "start": 800.12, "end": 802.7, "text": " They are artifacts of how we choose to write the equations.", "tokens": [51091, 814, 366, 24617, 295, 577, 321, 2826, 281, 2464, 264, 11787, 13, 51220], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 227, "seek": 78560, "start": 802.7, "end": 807.6, "text": " You can actually rewrite those theories in ways that don't use ghosts.", "tokens": [51220, 509, 393, 767, 28132, 729, 13667, 294, 2098, 300, 500, 380, 764, 21744, 13, 51465], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 228, "seek": 78560, "start": 807.72, "end": 810.2, "text": " It just makes the math agonizingly difficult.", "tokens": [51471, 467, 445, 1669, 264, 5221, 623, 266, 3319, 356, 2252, 13, 51595], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 229, "seek": 78560, "start": 810.82, "end": 814.0600000000001, "text": " But with gravity, the ghost wasn't just a bookkeeping trick.", "tokens": [51626, 583, 365, 12110, 11, 264, 8359, 2067, 380, 445, 257, 1446, 25769, 4282, 13, 51788], "temperature": 0.0, "avg_logprob": -0.17643029762036871, "compression_ratio": 1.6655844155844155, "no_speech_prob": 1.7691695547786268e-12}, {"id": 230, "seek": 81406, "start": 814.06, "end": 818.2199999999999, "text": " The ghost was fundamentally baked into the dynamics of the theory itself.", "tokens": [50365, 440, 8359, 390, 17879, 19453, 666, 264, 15679, 295, 264, 5261, 2564, 13, 50573], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 231, "seek": 81406, "start": 818.7399999999999, "end": 819.78, "text": " And that terrified them.", "tokens": [50599, 400, 300, 23051, 552, 13, 50651], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 232, "seek": 81406, "start": 820.02, "end": 822.56, "text": " This brings us to the Great Crisis of 1977.", "tokens": [50663, 639, 5607, 505, 281, 264, 3769, 42846, 295, 35092, 13, 50790], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 233, "seek": 81406, "start": 823.28, "end": 827.6199999999999, "text": " Let's talk about the discovery that should have changed physics, but instead got thrown in the trash.", "tokens": [50826, 961, 311, 751, 466, 264, 12114, 300, 820, 362, 3105, 10649, 11, 457, 2602, 658, 11732, 294, 264, 11321, 13, 51043], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 234, "seek": 81406, "start": 828.06, "end": 830.1999999999999, "text": " Who is K.S. Stel and what did he find?", "tokens": [51065, 2102, 307, 591, 13, 50, 13, 745, 338, 293, 437, 630, 415, 915, 30, 51172], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 235, "seek": 81406, "start": 830.3199999999999, "end": 836.6199999999999, "text": " K.S. Stel was a theoretical physicist who was tackling the biggest problem in modern science, quantum gravity.", "tokens": [51178, 591, 13, 50, 13, 745, 338, 390, 257, 20864, 42466, 567, 390, 34415, 264, 3880, 1154, 294, 4363, 3497, 11, 13018, 12110, 13, 51493], "temperature": 0.0, "avg_logprob": -0.15132226847638988, "compression_ratio": 1.5095785440613028, "no_speech_prob": 1.573542077887291e-12}, {"id": 236, "seek": 83662, "start": 836.62, "end": 844.62, "text": " The problem with standard Einstein gravity general relativity is that when you try to apply the rules of quantum mechanics to it, the math simply explodes.", "tokens": [50365, 440, 1154, 365, 3832, 23486, 12110, 2674, 45675, 307, 300, 562, 291, 853, 281, 3079, 264, 4474, 295, 13018, 12939, 281, 309, 11, 264, 5221, 2935, 42610, 13, 50765], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 237, "seek": 83662, "start": 845.42, "end": 846.04, "text": " It breaks down.", "tokens": [50805, 467, 9857, 760, 13, 50836], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 238, "seek": 83662, "start": 846.18, "end": 846.52, "text": " Completely.", "tokens": [50843, 39978, 13, 50860], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 239, "seek": 83662, "start": 847.0600000000001, "end": 852.66, "text": " When you try to calculate the interaction of gravitons at incredibly small distances, the equations spit out infinities.", "tokens": [50887, 1133, 291, 853, 281, 8873, 264, 9285, 295, 26048, 892, 412, 6252, 1359, 22182, 11, 264, 11787, 22127, 484, 7193, 1088, 13, 51167], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 240, "seek": 83662, "start": 853.1, "end": 855.3, "text": " Infinite energy, infinite probability.", "tokens": [51189, 43368, 2281, 11, 13785, 8482, 13, 51299], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 241, "seek": 83662, "start": 855.84, "end": 857.84, "text": " The theory is what we call non-renormalizable.", "tokens": [51326, 440, 5261, 307, 437, 321, 818, 2107, 12, 1095, 24440, 22395, 13, 51426], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 242, "seek": 83662, "start": 858.26, "end": 859.0, "text": " It just breaks.", "tokens": [51447, 467, 445, 9857, 13, 51484], "temperature": 0.0, "avg_logprob": -0.1518410418895965, "compression_ratio": 1.624, "no_speech_prob": 1.6047230818466707e-12}, {"id": 243, "seek": 85900, "start": 859.0, "end": 861.68, "text": " It's like trying to divide by zero on a calculator.", "tokens": [50365, 467, 311, 411, 1382, 281, 9845, 538, 4018, 322, 257, 24993, 13, 50499], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 244, "seek": 85900, "start": 862.06, "end": 863.62, "text": " You just get a big error message.", "tokens": [50518, 509, 445, 483, 257, 955, 6713, 3636, 13, 50596], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 245, "seek": 85900, "start": 864.1, "end": 864.38, "text": " Exactly.", "tokens": [50620, 7587, 13, 50634], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 246, "seek": 85900, "start": 864.78, "end": 867.26, "text": " And for decades, physicists tried to fix this and failed.", "tokens": [50654, 400, 337, 7878, 11, 48716, 3031, 281, 3191, 341, 293, 7612, 13, 50778], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 247, "seek": 85900, "start": 867.84, "end": 872.3, "text": " But in 1977, Stel made a monumental mathematical discovery.", "tokens": [50807, 583, 294, 35092, 11, 745, 338, 1027, 257, 43105, 18894, 12114, 13, 51030], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 248, "seek": 85900, "start": 873.16, "end": 879.66, "text": " He found that if you modify Einstein's equations, specifically if you add quadratic curvature terms to the action.", "tokens": [51073, 634, 1352, 300, 498, 291, 16927, 23486, 311, 11787, 11, 4682, 498, 291, 909, 37262, 37638, 2115, 281, 264, 3069, 13, 51398], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 249, "seek": 85900, "start": 879.86, "end": 880.16, "text": " Hang on.", "tokens": [51408, 14070, 322, 13, 51423], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 250, "seek": 85900, "start": 880.22, "end": 880.92, "text": " Let's define that.", "tokens": [51426, 961, 311, 6964, 300, 13, 51461], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 251, "seek": 85900, "start": 881.04, "end": 882.94, "text": " What is a quadratic curvature term?", "tokens": [51467, 708, 307, 257, 37262, 37638, 1433, 30, 51562], "temperature": 0.0, "avg_logprob": -0.158720614863377, "compression_ratio": 1.5155038759689923, "no_speech_prob": 1.2641915509217783e-12}, {"id": 252, "seek": 88294, "start": 882.94, "end": 883.3000000000001, "text": " Sure.", "tokens": [50365, 4894, 13, 50383], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 253, "seek": 88294, "start": 883.6400000000001, "end": 889.4000000000001, "text": " General relativity is based on space-time curvature, represented by the Ricci scalar, which is a linear term.", "tokens": [50400, 6996, 45675, 307, 2361, 322, 1901, 12, 3766, 37638, 11, 10379, 538, 264, 21215, 537, 39684, 11, 597, 307, 257, 8213, 1433, 13, 50688], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 254, "seek": 88294, "start": 889.84, "end": 892.0200000000001, "text": " It's essentially the first derivative of the metric.", "tokens": [50710, 467, 311, 4476, 264, 700, 13760, 295, 264, 20678, 13, 50819], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 255, "seek": 88294, "start": 892.86, "end": 898.36, "text": " Stel decided to add terms that are squared, the square of the Ricci scalar and the square of something called the whale tensor.", "tokens": [50861, 745, 338, 3047, 281, 909, 2115, 300, 366, 8889, 11, 264, 3732, 295, 264, 21215, 537, 39684, 293, 264, 3732, 295, 746, 1219, 264, 25370, 40863, 13, 51136], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 256, "seek": 88294, "start": 898.8000000000001, "end": 902.5400000000001, "text": " He introduced higher order derivatives into the fundamental equations of gravity.", "tokens": [51158, 634, 7268, 2946, 1668, 33733, 666, 264, 8088, 11787, 295, 12110, 13, 51345], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 257, "seek": 88294, "start": 902.74, "end": 904.1400000000001, "text": " Okay, so he squared some stuff.", "tokens": [51355, 1033, 11, 370, 415, 8889, 512, 1507, 13, 51425], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 258, "seek": 88294, "start": 904.2600000000001, "end": 904.46, "text": " Right.", "tokens": [51431, 1779, 13, 51441], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 259, "seek": 88294, "start": 904.6, "end": 909.22, "text": " And when he ran the calculations for this new quadratic gravity, a miracle happened.", "tokens": [51448, 400, 562, 415, 5872, 264, 20448, 337, 341, 777, 37262, 12110, 11, 257, 14660, 2011, 13, 51679], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 260, "seek": 88294, "start": 909.4200000000001, "end": 911.34, "text": " The equation stopped spinning out infinities.", "tokens": [51689, 440, 5367, 5936, 15640, 484, 7193, 1088, 13, 51785], "temperature": 0.0, "avg_logprob": -0.1545746624469757, "compression_ratio": 1.7178683385579938, "no_speech_prob": 1.3671196336453861e-12}, {"id": 261, "seek": 91134, "start": 911.34, "end": 913.86, "text": " The theory became perfectly renormalizable.", "tokens": [50365, 440, 5261, 3062, 6239, 8124, 24440, 22395, 13, 50491], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 262, "seek": 91134, "start": 914.1, "end": 915.7, "text": " The infinities were entirely cured.", "tokens": [50503, 440, 7193, 1088, 645, 7696, 29617, 13, 50583], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 263, "seek": 91134, "start": 915.9, "end": 924.2800000000001, "text": " Okay, so a guy in 1977 completely solved the infinity problem of quantum gravity by just squaring some of the curvature terms.", "tokens": [50593, 1033, 11, 370, 257, 2146, 294, 35092, 2584, 13041, 264, 13202, 1154, 295, 13018, 12110, 538, 445, 2339, 1921, 512, 295, 264, 37638, 2115, 13, 51012], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 264, "seek": 91134, "start": 924.44, "end": 926.14, "text": " That sounds like the Holy Grail.", "tokens": [51020, 663, 3263, 411, 264, 6295, 8985, 388, 13, 51105], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 265, "seek": 91134, "start": 926.52, "end": 928.32, "text": " That should be Einstein-level famous.", "tokens": [51124, 663, 820, 312, 23486, 12, 12418, 4618, 13, 51214], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 266, "seek": 91134, "start": 928.7, "end": 932.2, "text": " Why aren't we all taught Stel's quadratic gravity in high school?", "tokens": [51233, 1545, 3212, 380, 321, 439, 5928, 745, 338, 311, 37262, 12110, 294, 1090, 1395, 30, 51408], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 267, "seek": 91134, "start": 932.52, "end": 933.82, "text": " Because of the fatal flaw.", "tokens": [51424, 1436, 295, 264, 24069, 13717, 13, 51489], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 268, "seek": 91134, "start": 934.58, "end": 940.1, "text": " When you add those higher derivative terms, you fundamentally change the particle spectrum of the theory.", "tokens": [51527, 1133, 291, 909, 729, 2946, 13760, 2115, 11, 291, 17879, 1319, 264, 12359, 11143, 295, 264, 5261, 13, 51803], "temperature": 0.0, "avg_logprob": -0.15757729521894878, "compression_ratio": 1.576158940397351, "no_speech_prob": 1.4724409842445385e-12}, {"id": 269, "seek": 94010, "start": 940.1, "end": 947.14, "text": " In standard Einstein gravity, you have the graviton, a massless spin-to particle that carries the gravitational force.", "tokens": [50365, 682, 3832, 23486, 12110, 11, 291, 362, 264, 26048, 266, 11, 257, 2758, 1832, 6060, 12, 1353, 12359, 300, 16402, 264, 28538, 3464, 13, 50717], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 270, "seek": 94010, "start": 947.66, "end": 953.0400000000001, "text": " When Stel added the quadratic terms, the math still produced the massless graviton, which was great.", "tokens": [50743, 1133, 745, 338, 3869, 264, 37262, 2115, 11, 264, 5221, 920, 7126, 264, 2758, 1832, 26048, 266, 11, 597, 390, 869, 13, 51012], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 271, "seek": 94010, "start": 953.12, "end": 953.34, "text": " What?", "tokens": [51016, 708, 30, 51027], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 272, "seek": 94010, "start": 953.84, "end": 955.26, "text": " But it also birthed a monster.", "tokens": [51052, 583, 309, 611, 3965, 292, 257, 10090, 13, 51123], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 273, "seek": 94010, "start": 955.84, "end": 959.32, "text": " It created a massive spin-to propagating degree of freedom.", "tokens": [51152, 467, 2942, 257, 5994, 6060, 12, 1353, 12425, 990, 4314, 295, 5645, 13, 51326], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 274, "seek": 94010, "start": 960.02, "end": 967.3000000000001, "text": " And when you look at the kinetic energy term for this new massive particle in the equations, it has a massive negative sign in front of it.", "tokens": [51361, 400, 562, 291, 574, 412, 264, 27135, 2281, 1433, 337, 341, 777, 5994, 12359, 294, 264, 11787, 11, 309, 575, 257, 5994, 3671, 1465, 294, 1868, 295, 309, 13, 51725], "temperature": 0.0, "avg_logprob": -0.1265119825090681, "compression_ratio": 1.7207547169811321, "no_speech_prob": 1.5432489270869598e-12}, {"id": 275, "seek": 96730, "start": 967.3, "end": 969.92, "text": " The negative kinetic energy, meaning what physically?", "tokens": [50365, 440, 3671, 27135, 2281, 11, 3620, 437, 9762, 30, 50496], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 276, "seek": 96730, "start": 970.16, "end": 971.66, "text": " Think about a ball rolling down a hill.", "tokens": [50508, 6557, 466, 257, 2594, 9439, 760, 257, 10997, 13, 50583], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 277, "seek": 96730, "start": 972.38, "end": 976.8, "text": " Positive kinetic energy means if you push the ball, it speeds up in the direction you pushed it.", "tokens": [50619, 46326, 27135, 2281, 1355, 498, 291, 2944, 264, 2594, 11, 309, 16411, 493, 294, 264, 3513, 291, 9152, 309, 13, 50840], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 278, "seek": 96730, "start": 977.4, "end": 981.3199999999999, "text": " A particle with a negative kinetic term, a ghost, behaves inversely.", "tokens": [50870, 316, 12359, 365, 257, 3671, 27135, 1433, 11, 257, 8359, 11, 36896, 21378, 736, 13, 51066], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 279, "seek": 96730, "start": 981.42, "end": 983.62, "text": " If you push it forward, it accelerates backward.", "tokens": [51071, 759, 291, 2944, 309, 2128, 11, 309, 10172, 1024, 23897, 13, 51181], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 280, "seek": 96730, "start": 983.78, "end": 984.5, "text": " It's bizarre.", "tokens": [51189, 467, 311, 18265, 13, 51225], "temperature": 0.0, "avg_logprob": -0.14262351757142602, "compression_ratio": 1.6019900497512438, "no_speech_prob": 1.6106101912230497e-12}, {"id": 281, "seek": 98450, "start": 984.5, "end": 985.04, "text": " It is.", "tokens": [50365, 467, 307, 13, 50392], "temperature": 0.0, "avg_logprob": -0.14483880996704102, "compression_ratio": 1.6359223300970873, "no_speech_prob": 1.3349651245553318e-12}, {"id": 282, "seek": 98450, "start": 985.38, "end": 990.16, "text": " If it emits radiation, instead of losing energy and slowing down, it gains energy and speeds up.", "tokens": [50409, 759, 309, 846, 1208, 12420, 11, 2602, 295, 7027, 2281, 293, 26958, 760, 11, 309, 16823, 2281, 293, 16411, 493, 13, 50648], "temperature": 0.0, "avg_logprob": -0.14483880996704102, "compression_ratio": 1.6359223300970873, "no_speech_prob": 1.3349651245553318e-12}, {"id": 283, "seek": 98450, "start": 991.0, "end": 1001.0, "text": " Furthermore, when you translate this into quantum mechanics via canonical quantization, this negative kinetic term forces the particle's quantum states to have a negative inner product.", "tokens": [50690, 23999, 11, 562, 291, 13799, 341, 666, 13018, 12939, 5766, 46491, 4426, 2144, 11, 341, 3671, 27135, 1433, 5874, 264, 12359, 311, 13018, 4368, 281, 362, 257, 3671, 7284, 1674, 13, 51190], "temperature": 0.0, "avg_logprob": -0.14483880996704102, "compression_ratio": 1.6359223300970873, "no_speech_prob": 1.3349651245553318e-12}, {"id": 284, "seek": 98450, "start": 1001.32, "end": 1003.86, "text": " It creates a state with a negative probability.", "tokens": [51206, 467, 7829, 257, 1785, 365, 257, 3671, 8482, 13, 51333], "temperature": 0.0, "avg_logprob": -0.14483880996704102, "compression_ratio": 1.6359223300970873, "no_speech_prob": 1.3349651245553318e-12}, {"id": 285, "seek": 100386, "start": 1003.86, "end": 1004.36, "text": " Yes.", "tokens": [50365, 1079, 13, 50390], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 286, "seek": 100386, "start": 1005.02, "end": 1008.54, "text": " The ghost states represent a negative probability of existence.", "tokens": [50423, 440, 8359, 4368, 2906, 257, 3671, 8482, 295, 9123, 13, 50599], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 287, "seek": 100386, "start": 1009.36, "end": 1023.42, "text": " So standard physics looked at Stel's brilliant cure for quantum gravity, saw the massive spin-to ghost with its negative probability, invoked the Hilbert assumption, and said negative probability is an observable pathology.", "tokens": [50640, 407, 3832, 10649, 2956, 412, 745, 338, 311, 10248, 13698, 337, 13018, 12110, 11, 1866, 264, 5994, 6060, 12, 1353, 8359, 365, 1080, 3671, 8482, 11, 1048, 9511, 264, 19914, 4290, 15302, 11, 293, 848, 3671, 8482, 307, 364, 9951, 712, 3100, 1793, 13, 51343], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 288, "seek": 100386, "start": 1023.84, "end": 1027.66, "text": " It is unphysical, therefore the entire theory is dead on arrival.", "tokens": [51364, 467, 307, 517, 950, 36280, 11, 4412, 264, 2302, 5261, 307, 3116, 322, 18365, 13, 51555], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 289, "seek": 100386, "start": 1027.78, "end": 1028.16, "text": " Wow.", "tokens": [51561, 3153, 13, 51580], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 290, "seek": 100386, "start": 1028.48, "end": 1032.66, "text": " And they threw quadratic gravity straight in the theoretical trash can.", "tokens": [51596, 400, 436, 11918, 37262, 12110, 2997, 294, 264, 20864, 11321, 393, 13, 51805], "temperature": 0.0, "avg_logprob": -0.14699803939973466, "compression_ratio": 1.6730769230769231, "no_speech_prob": 1.655246360983409e-12}, {"id": 291, "seek": 103266, "start": 1032.66, "end": 1037.8000000000002, "text": " They discarded the literal cure for quantum gravity because they couldn't handle the ghost in the ledger.", "tokens": [50365, 814, 45469, 264, 20411, 13698, 337, 13018, 12110, 570, 436, 2809, 380, 4813, 264, 8359, 294, 264, 4684, 1321, 13, 50622], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 292, "seek": 103266, "start": 1038.1000000000001, "end": 1041.88, "text": " They just assumed the negative math would inevitably leak into the physical world.", "tokens": [50637, 814, 445, 15895, 264, 3671, 5221, 576, 28171, 17143, 666, 264, 4001, 1002, 13, 50826], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 293, "seek": 103266, "start": 1042.44, "end": 1051.94, "text": " But Flixian's paper highlights a massive, decades-long rescue operation, right, a way to save stealth theory, spearheaded recently by physicists Neil Turok and Sam Bateman.", "tokens": [50854, 583, 3235, 970, 952, 311, 3035, 14254, 257, 5994, 11, 7878, 12, 13025, 13283, 6916, 11, 558, 11, 257, 636, 281, 3155, 25756, 5261, 11, 26993, 28409, 3938, 538, 48716, 18615, 314, 7052, 74, 293, 4832, 10066, 15023, 13, 51329], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 294, "seek": 103266, "start": 1052.1000000000001, "end": 1052.5, "text": " That's right.", "tokens": [51337, 663, 311, 558, 13, 51357], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 295, "seek": 103266, "start": 1052.76, "end": 1057.88, "text": " And their solution involves abandoning the Hilbert space entirely and moving into something called a crane space.", "tokens": [51370, 400, 641, 3827, 11626, 9072, 278, 264, 19914, 4290, 1901, 7696, 293, 2684, 666, 746, 1219, 257, 36345, 1901, 13, 51626], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 296, "seek": 103266, "start": 1058.48, "end": 1061.78, "text": " So what is a crane space mathematically, and how does it save the ghost?", "tokens": [51656, 407, 437, 307, 257, 36345, 1901, 44003, 11, 293, 577, 775, 309, 3155, 264, 8359, 30, 51821], "temperature": 0.0, "avg_logprob": -0.09124089038278174, "compression_ratio": 1.6289855072463768, "no_speech_prob": 2.307676619239807e-12}, {"id": 297, "seek": 106178, "start": 1061.78, "end": 1066.54, "text": " A crane space is a mathematical arena that explicitly rejects the Hilbert assumption.", "tokens": [50365, 316, 36345, 1901, 307, 257, 18894, 18451, 300, 20803, 8248, 82, 264, 19914, 4290, 15302, 13, 50603], "temperature": 0.0, "avg_logprob": -0.11490050757803567, "compression_ratio": 1.7155555555555555, "no_speech_prob": 1.7689034915654989e-12}, {"id": 298, "seek": 106178, "start": 1067.28, "end": 1069.44, "text": " It is an indefinite inner product space.", "tokens": [50640, 467, 307, 364, 24162, 5194, 642, 7284, 1674, 1901, 13, 50748], "temperature": 0.0, "avg_logprob": -0.11490050757803567, "compression_ratio": 1.7155555555555555, "no_speech_prob": 1.7689034915654989e-12}, {"id": 299, "seek": 106178, "start": 1070.1, "end": 1078.8999999999999, "text": " Unlike a Hilbert space, which violently demands that every single vector have a positive length and a positive probability, a crane space is completely relaxed.", "tokens": [50781, 17657, 257, 19914, 4290, 1901, 11, 597, 46728, 15107, 300, 633, 2167, 8062, 362, 257, 3353, 4641, 293, 257, 3353, 8482, 11, 257, 36345, 1901, 307, 2584, 14628, 13, 51221], "temperature": 0.0, "avg_logprob": -0.11490050757803567, "compression_ratio": 1.7155555555555555, "no_speech_prob": 1.7689034915654989e-12}, {"id": 300, "seek": 106178, "start": 1079.44, "end": 1085.16, "text": " It is perfectly happy to contain a positive norm sector and a negative norm sector simultaneously.", "tokens": [51248, 467, 307, 6239, 2055, 281, 5304, 257, 3353, 2026, 6977, 293, 257, 3671, 2026, 6977, 16561, 13, 51534], "temperature": 0.0, "avg_logprob": -0.11490050757803567, "compression_ratio": 1.7155555555555555, "no_speech_prob": 1.7689034915654989e-12}, {"id": 301, "seek": 108516, "start": 1085.16, "end": 1087.28, "text": " Okay, but how does that actually help?", "tokens": [50365, 1033, 11, 457, 577, 775, 300, 767, 854, 30, 50471], "temperature": 0.0, "avg_logprob": -0.11498903386733111, "compression_ratio": 1.543103448275862, "no_speech_prob": 1.981067436832018e-12}, {"id": 302, "seek": 108516, "start": 1087.3400000000001, "end": 1093.4, "text": " If you just mathematically allow the negative probability to exist, you haven't solved the physical absurdity.", "tokens": [50474, 759, 291, 445, 44003, 2089, 264, 3671, 8482, 281, 2514, 11, 291, 2378, 380, 13041, 264, 4001, 19774, 507, 13, 50777], "temperature": 0.0, "avg_logprob": -0.11498903386733111, "compression_ratio": 1.543103448275862, "no_speech_prob": 1.981067436832018e-12}, {"id": 303, "seek": 108516, "start": 1093.48, "end": 1094.8600000000001, "text": " You still have a negative probability.", "tokens": [50781, 509, 920, 362, 257, 3671, 8482, 13, 50850], "temperature": 0.0, "avg_logprob": -0.11498903386733111, "compression_ratio": 1.543103448275862, "no_speech_prob": 1.981067436832018e-12}, {"id": 304, "seek": 108516, "start": 1095.26, "end": 1099.3400000000001, "text": " To see the mechanics of that, we have to look at Neil Turok's brilliant analogy.", "tokens": [50870, 1407, 536, 264, 12939, 295, 300, 11, 321, 362, 281, 574, 412, 18615, 314, 7052, 74, 311, 10248, 21663, 13, 51074], "temperature": 0.0, "avg_logprob": -0.11498903386733111, "compression_ratio": 1.543103448275862, "no_speech_prob": 1.981067436832018e-12}, {"id": 305, "seek": 108516, "start": 1100.2, "end": 1104.8000000000002, "text": " Think of Winkowski spacetime, the geometric foundation of Einstein's special relativity.", "tokens": [51117, 6557, 295, 343, 475, 21866, 39404, 9764, 11, 264, 33246, 7030, 295, 23486, 311, 2121, 45675, 13, 51347], "temperature": 0.0, "avg_logprob": -0.11498903386733111, "compression_ratio": 1.543103448275862, "no_speech_prob": 1.981067436832018e-12}, {"id": 306, "seek": 110480, "start": 1104.8, "end": 1109.74, "text": " In four-dimensional spacetime, we have three dimensions of space and one dimension of time.", "tokens": [50365, 682, 1451, 12, 18759, 39404, 9764, 11, 321, 362, 1045, 12819, 295, 1901, 293, 472, 10139, 295, 565, 13, 50612], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 307, "seek": 110480, "start": 1110.3, "end": 1112.58, "text": " And crucially, they are mathematically distinct.", "tokens": [50640, 400, 5140, 1909, 11, 436, 366, 44003, 10644, 13, 50754], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 308, "seek": 110480, "start": 1113.3, "end": 1115.6399999999999, "text": " Spacelike vectors have a positive length squared.", "tokens": [50790, 1738, 326, 338, 1123, 18875, 362, 257, 3353, 4641, 8889, 13, 50907], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 309, "seek": 110480, "start": 1116.36, "end": 1118.54, "text": " Timelike vectors have a negative length squared.", "tokens": [50943, 7172, 338, 1123, 18875, 362, 257, 3671, 4641, 8889, 13, 51052], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 310, "seek": 110480, "start": 1118.76, "end": 1119.34, "text": " Oh, interesting.", "tokens": [51063, 876, 11, 1880, 13, 51092], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 311, "seek": 110480, "start": 1119.54, "end": 1123.54, "text": " So the geometry of the universe actually already uses indefinite metrics.", "tokens": [51102, 407, 264, 18426, 295, 264, 6445, 767, 1217, 4960, 24162, 5194, 642, 16367, 13, 51302], "temperature": 0.0, "avg_logprob": -0.16884419947494694, "compression_ratio": 1.6666666666666667, "no_speech_prob": 2.004893646934125e-12}, {"id": 312, "seek": 112354, "start": 1123.54, "end": 1124.3799999999999, "text": " Exactly.", "tokens": [50365, 7587, 13, 50407], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 313, "seek": 112354, "start": 1125.1, "end": 1127.86, "text": " Spacetime itself is an indefinite metric space.", "tokens": [50443, 1738, 326, 9764, 2564, 307, 364, 24162, 5194, 642, 20678, 1901, 13, 50581], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 314, "seek": 112354, "start": 1128.46, "end": 1132.6, "text": " Spacetime isn't broken just because the time direction has a negative sign in the metric.", "tokens": [50611, 1738, 326, 9764, 1943, 380, 5463, 445, 570, 264, 565, 3513, 575, 257, 3671, 1465, 294, 264, 20678, 13, 50818], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 315, "seek": 112354, "start": 1133.1399999999999, "end": 1135.56, "text": " It just means time behaves differently than space.", "tokens": [50845, 467, 445, 1355, 565, 36896, 7614, 813, 1901, 13, 50966], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 316, "seek": 112354, "start": 1136.36, "end": 1141.0, "text": " Turok and Bateman apply that exact same logic to the quantum state space.", "tokens": [51006, 314, 7052, 74, 293, 10066, 15023, 3079, 300, 1900, 912, 9952, 281, 264, 13018, 1785, 1901, 13, 51238], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 317, "seek": 112354, "start": 1141.1599999999999, "end": 1142.24, "text": " So they treat it like geometry.", "tokens": [51246, 407, 436, 2387, 309, 411, 18426, 13, 51300], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 318, "seek": 112354, "start": 1142.7, "end": 1142.94, "text": " Yes.", "tokens": [51323, 1079, 13, 51335], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 319, "seek": 112354, "start": 1143.46, "end": 1148.36, "text": " A crane space is just a quantum algebra that acknowledges time-like and space-like quantum states.", "tokens": [51361, 316, 36345, 1901, 307, 445, 257, 13018, 21989, 300, 15195, 2880, 565, 12, 4092, 293, 1901, 12, 4092, 13018, 4368, 13, 51606], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 320, "seek": 112354, "start": 1148.78, "end": 1151.06, "text": " The positive norm states are standard particles.", "tokens": [51627, 440, 3353, 2026, 4368, 366, 3832, 10007, 13, 51741], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 321, "seek": 112354, "start": 1151.18, "end": 1153.44, "text": " The negative norm states are the ghosts.", "tokens": [51747, 440, 3671, 2026, 4368, 366, 264, 21744, 13, 51860], "temperature": 0.0, "avg_logprob": -0.19359332796127077, "compression_ratio": 1.8475836431226766, "no_speech_prob": 1.8834350311996984e-12}, {"id": 322, "seek": 115354, "start": 1154.3, "end": 1159.1599999999999, "text": " And they are both perfectly valid, well-behaved coordinates internally in the mathematical space.", "tokens": [50403, 400, 436, 366, 1293, 6239, 7363, 11, 731, 12, 29437, 12865, 21056, 19501, 294, 264, 18894, 1901, 13, 50646], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 323, "seek": 115354, "start": 1159.28, "end": 1161.08, "text": " But I'm still stuck on the ATM analogy.", "tokens": [50652, 583, 286, 478, 920, 5541, 322, 264, 46455, 21663, 13, 50742], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 324, "seek": 115354, "start": 1161.52, "end": 1164.78, "text": " The accountant can use the negative numbers in the Crean space ledger.", "tokens": [50764, 440, 43898, 393, 764, 264, 3671, 3547, 294, 264, 9549, 282, 1901, 4684, 1321, 13, 50927], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 325, "seek": 115354, "start": 1165.3, "end": 1170.92, "text": " But eventually, the physicist has to calculate an observable physical event like two particles colliding in a collider.", "tokens": [50953, 583, 4728, 11, 264, 42466, 575, 281, 8873, 364, 9951, 712, 4001, 2280, 411, 732, 10007, 1263, 2819, 294, 257, 1263, 1438, 13, 51234], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 326, "seek": 115354, "start": 1171.34, "end": 1172.32, "text": " They have to go to the ATM.", "tokens": [51255, 814, 362, 281, 352, 281, 264, 46455, 13, 51304], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 327, "seek": 115354, "start": 1173.44, "end": 1178.86, "text": " If your equation spits out a negative probability state, a ghost, how does the universe just ignore it?", "tokens": [51360, 759, 428, 5367, 637, 1208, 484, 257, 3671, 8482, 1785, 11, 257, 8359, 11, 577, 775, 264, 6445, 445, 11200, 309, 30, 51631], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 328, "seek": 115354, "start": 1178.86, "end": 1182.6399999999999, "text": " How do you get a positive, sensible physical probability out of a Crean space?", "tokens": [51631, 1012, 360, 291, 483, 257, 3353, 11, 25380, 4001, 8482, 484, 295, 257, 9549, 282, 1901, 30, 51820], "temperature": 0.0, "avg_logprob": -0.14934567887653677, "compression_ratio": 1.7003154574132493, "no_speech_prob": 1.6684883726372779e-12}, {"id": 329, "seek": 118264, "start": 1182.64, "end": 1185.9, "text": " This is the crux of the entire rescue operation.", "tokens": [50365, 639, 307, 264, 5140, 87, 295, 264, 2302, 13283, 6916, 13, 50528], "temperature": 0.0, "avg_logprob": -0.20110630598224577, "compression_ratio": 1.3859649122807018, "no_speech_prob": 1.7418933049434537e-12}, {"id": 330, "seek": 118264, "start": 1186.88, "end": 1191.66, "text": " This is what Fliction formalizes as the observable admissibility theorem.", "tokens": [50577, 639, 307, 437, 3235, 4105, 9860, 5660, 382, 264, 9951, 712, 5910, 891, 2841, 20904, 13, 50816], "temperature": 0.0, "avg_logprob": -0.20110630598224577, "compression_ratio": 1.3859649122807018, "no_speech_prob": 1.7418933049434537e-12}, {"id": 331, "seek": 118264, "start": 1193.18, "end": 1200.44, "text": " Turok and Bateman realized that the physicists in the 1970s were calculating probabilities entirely wrong.", "tokens": [50892, 314, 7052, 74, 293, 10066, 15023, 5334, 300, 264, 48716, 294, 264, 14577, 82, 645, 28258, 33783, 7696, 2085, 13, 51255], "temperature": 0.0, "avg_logprob": -0.20110630598224577, "compression_ratio": 1.3859649122807018, "no_speech_prob": 1.7418933049434537e-12}, {"id": 332, "seek": 118264, "start": 1200.5800000000002, "end": 1201.26, "text": " Oh, so.", "tokens": [51262, 876, 11, 370, 13, 51296], "temperature": 0.0, "avg_logprob": -0.20110630598224577, "compression_ratio": 1.3859649122807018, "no_speech_prob": 1.7418933049434537e-12}, {"id": 333, "seek": 120126, "start": 1201.26, "end": 1204.3, "text": " In standard quantum mechanics, you use the Born rule.", "tokens": [50365, 682, 3832, 13018, 12939, 11, 291, 764, 264, 29808, 4978, 13, 50517], "temperature": 0.0, "avg_logprob": -0.1297199997720839, "compression_ratio": 1.5852534562211982, "no_speech_prob": 2.343712897368011e-12}, {"id": 334, "seek": 120126, "start": 1204.72, "end": 1210.3, "text": " You take the amplitude of a state and you square it, and you basically ignore anything that doesn't physically exist.", "tokens": [50538, 509, 747, 264, 27433, 295, 257, 1785, 293, 291, 3732, 309, 11, 293, 291, 1936, 11200, 1340, 300, 1177, 380, 9762, 2514, 13, 50817], "temperature": 0.0, "avg_logprob": -0.1297199997720839, "compression_ratio": 1.5852534562211982, "no_speech_prob": 2.343712897368011e-12}, {"id": 335, "seek": 120126, "start": 1210.92, "end": 1215.58, "text": " The 70s physicists tried to just delete the ghost states from the math before doing the calculation,", "tokens": [50848, 440, 5285, 82, 48716, 3031, 281, 445, 12097, 264, 8359, 4368, 490, 264, 5221, 949, 884, 264, 17108, 11, 51081], "temperature": 0.0, "avg_logprob": -0.1297199997720839, "compression_ratio": 1.5852534562211982, "no_speech_prob": 2.343712897368011e-12}, {"id": 336, "seek": 120126, "start": 1216.12, "end": 1219.6, "text": " trying to artificially force the Crean space back into a Hilbert space.", "tokens": [51108, 1382, 281, 39905, 2270, 3464, 264, 9549, 282, 1901, 646, 666, 257, 19914, 4290, 1901, 13, 51282], "temperature": 0.0, "avg_logprob": -0.1297199997720839, "compression_ratio": 1.5852534562211982, "no_speech_prob": 2.343712897368011e-12}, {"id": 337, "seek": 121960, "start": 1219.6, "end": 1224.12, "text": " But when you just arbitrarily delete a mathematically necessary part of the equation,", "tokens": [50365, 583, 562, 291, 445, 19071, 3289, 12097, 257, 44003, 4818, 644, 295, 264, 5367, 11, 50591], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 338, "seek": 121960, "start": 1224.3799999999999, "end": 1228.82, "text": " you break the theory's internal symmetries, and the probabilities stop adding up to 100%.", "tokens": [50604, 291, 1821, 264, 5261, 311, 6920, 14232, 302, 2244, 11, 293, 264, 33783, 1590, 5127, 493, 281, 2319, 6856, 50826], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 339, "seek": 121960, "start": 1228.82, "end": 1230.76, "text": " It ruins the unitarity of the theory.", "tokens": [50826, 467, 24747, 264, 517, 3981, 507, 295, 264, 5261, 13, 50923], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 340, "seek": 121960, "start": 1230.8799999999999, "end": 1234.06, "text": " So you can't just cross the negative numbers out of the ledger with a Sharpie.", "tokens": [50929, 407, 291, 393, 380, 445, 3278, 264, 3671, 3547, 484, 295, 264, 4684, 1321, 365, 257, 31654, 414, 13, 51088], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 341, "seek": 121960, "start": 1234.1399999999999, "end": 1235.6799999999998, "text": " The books literally won't balance.", "tokens": [51092, 440, 3642, 3736, 1582, 380, 4772, 13, 51169], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 342, "seek": 121960, "start": 1235.78, "end": 1236.0, "text": " Right.", "tokens": [51174, 1779, 13, 51185], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 343, "seek": 121960, "start": 1236.36, "end": 1238.36, "text": " So Turok and Bateman modified the approach.", "tokens": [51203, 407, 314, 7052, 74, 293, 10066, 15023, 15873, 264, 3109, 13, 51303], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 344, "seek": 121960, "start": 1238.52, "end": 1239.6599999999999, "text": " They said, leave the ghosts in.", "tokens": [51311, 814, 848, 11, 1856, 264, 21744, 294, 13, 51368], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 345, "seek": 121960, "start": 1240.04, "end": 1241.36, "text": " Trace over the entire space.", "tokens": [51387, 1765, 617, 670, 264, 2302, 1901, 13, 51453], "temperature": 0.0, "avg_logprob": -0.12560057235976396, "compression_ratio": 1.579136690647482, "no_speech_prob": 1.5134021423210409e-12}, {"id": 346, "seek": 124136, "start": 1241.36, "end": 1243.54, "text": " But, and this is the genius part,", "tokens": [50365, 583, 11, 293, 341, 307, 264, 14017, 644, 11, 50474], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 347, "seek": 124136, "start": 1243.9399999999998, "end": 1248.84, "text": " they identified a hidden mathematical symmetry in quadratic gravity called ghost parity symmetry.", "tokens": [50494, 436, 9234, 257, 7633, 18894, 25440, 294, 37262, 12110, 1219, 8359, 44747, 25440, 13, 50739], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 348, "seek": 124136, "start": 1249.1999999999998, "end": 1250.4399999999998, "text": " Ghost parity symmetry.", "tokens": [50757, 16323, 44747, 25440, 13, 50819], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 349, "seek": 124136, "start": 1251.34, "end": 1253.1799999999998, "text": " Okay, let's break down the mechanics of that.", "tokens": [50864, 1033, 11, 718, 311, 1821, 760, 264, 12939, 295, 300, 13, 50956], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 350, "seek": 124136, "start": 1253.26, "end": 1253.9599999999998, "text": " How does it work?", "tokens": [50960, 1012, 775, 309, 589, 30, 50995], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 351, "seek": 124136, "start": 1254.24, "end": 1256.4199999999998, "text": " Imagine a perfectly balanced equation,", "tokens": [51009, 11739, 257, 6239, 13902, 5367, 11, 51118], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 352, "seek": 124136, "start": 1256.82, "end": 1262.34, "text": " where every time a regular positive energy particle interacts and moves forward in time,", "tokens": [51138, 689, 633, 565, 257, 3890, 3353, 2281, 12359, 43582, 293, 6067, 2128, 294, 565, 11, 51414], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 353, "seek": 124136, "start": 1262.34, "end": 1268.1, "text": " its negative ghost counterpart mirrors that mathematical action perfectly in the background.", "tokens": [51414, 1080, 3671, 8359, 22335, 24238, 300, 18894, 3069, 6239, 294, 264, 3678, 13, 51702], "temperature": 0.0, "avg_logprob": -0.19311776412160772, "compression_ratio": 1.6628787878787878, "no_speech_prob": 2.0204280956614973e-12}, {"id": 354, "seek": 126810, "start": 1268.1, "end": 1272.6799999999998, "text": " Because they are locked in this perfectly symmetrical dance under the rules of the theory,", "tokens": [50365, 1436, 436, 366, 9376, 294, 341, 6239, 40360, 4489, 833, 264, 4474, 295, 264, 5261, 11, 50594], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 355, "seek": 126810, "start": 1273.24, "end": 1277.02, "text": " a positive state can never spontaneously mix with a negative state.", "tokens": [50622, 257, 3353, 1785, 393, 1128, 47632, 2890, 365, 257, 3671, 1785, 13, 50811], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 356, "seek": 126810, "start": 1277.82, "end": 1283.6599999999999, "text": " The symmetry acts as an impenetrable firewall between the positive norm sector and the negative norm sector.", "tokens": [50851, 440, 25440, 10672, 382, 364, 704, 268, 302, 424, 638, 36109, 1296, 264, 3353, 2026, 6977, 293, 264, 3671, 2026, 6977, 13, 51143], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 357, "seek": 126810, "start": 1284.06, "end": 1286.6, "text": " So they exist in the exact same mathematical universe,", "tokens": [51163, 407, 436, 2514, 294, 264, 1900, 912, 18894, 6445, 11, 51290], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 358, "seek": 126810, "start": 1286.74, "end": 1290.1799999999998, "text": " but they can never physically touch or convert into one another.", "tokens": [51297, 457, 436, 393, 1128, 9762, 2557, 420, 7620, 666, 472, 1071, 13, 51469], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 359, "seek": 126810, "start": 1290.32, "end": 1290.6999999999998, "text": " Exactly.", "tokens": [51476, 7587, 13, 51495], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 360, "seek": 126810, "start": 1291.26, "end": 1294.6399999999999, "text": " The time evolution of the system strictly commutes with this parity operator.", "tokens": [51523, 440, 565, 9303, 295, 264, 1185, 20792, 800, 1819, 365, 341, 44747, 12973, 13, 51692], "temperature": 0.0, "avg_logprob": -0.14972148491786078, "compression_ratio": 1.7490774907749078, "no_speech_prob": 1.868325372883506e-12}, {"id": 361, "seek": 129464, "start": 1294.64, "end": 1301.1000000000001, "text": " And because of this firewall, the observable admissibility theorem proves a stunning mathematical fact.", "tokens": [50365, 400, 570, 295, 341, 36109, 11, 264, 9951, 712, 5910, 891, 2841, 20904, 25019, 257, 18550, 18894, 1186, 13, 50688], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 362, "seek": 129464, "start": 1302.2, "end": 1305.3400000000001, "text": " If you calculate the transition probability of a physical event,", "tokens": [50743, 759, 291, 8873, 264, 6034, 8482, 295, 257, 4001, 2280, 11, 50900], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 363, "seek": 129464, "start": 1305.66, "end": 1307.9, "text": " and you leave the ghosts fully engaged in the math,", "tokens": [50916, 293, 291, 1856, 264, 21744, 4498, 8237, 294, 264, 5221, 11, 51028], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 364, "seek": 129464, "start": 1308.16, "end": 1312.94, "text": " the negative contributions of the ghosts will always perfectly cancel out any mathematical anomalies,", "tokens": [51041, 264, 3671, 15725, 295, 264, 21744, 486, 1009, 6239, 10373, 484, 604, 18894, 24769, 48872, 11, 51280], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 365, "seek": 129464, "start": 1313.24, "end": 1316.24, "text": " and the final observable probability will always be positive.", "tokens": [51295, 293, 264, 2572, 9951, 712, 8482, 486, 1009, 312, 3353, 13, 51445], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 366, "seek": 129464, "start": 1316.7800000000002, "end": 1317.7, "text": " Wait, really?", "tokens": [51472, 3802, 11, 534, 30, 51518], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 367, "seek": 129464, "start": 1317.92, "end": 1321.64, "text": " And it will always sum up perfectly to unity 100%.", "tokens": [51529, 400, 309, 486, 1009, 2408, 493, 6239, 281, 18205, 2319, 6856, 51715], "temperature": 0.0, "avg_logprob": -0.16545769662568063, "compression_ratio": 1.75390625, "no_speech_prob": 1.79002006359813e-12}, {"id": 368, "seek": 132164, "start": 1321.64, "end": 1322.7, "text": " That is beautiful.", "tokens": [50365, 663, 307, 2238, 13, 50418], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 369, "seek": 132164, "start": 1322.7, "end": 1324.98, "text": " The math processes the negative ghost,", "tokens": [50418, 440, 5221, 7555, 264, 3671, 8359, 11, 50532], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 370, "seek": 132164, "start": 1325.42, "end": 1329.2, "text": " uses it to carry the necessary information to cancel out the infinities of gravity,", "tokens": [50554, 4960, 309, 281, 3985, 264, 4818, 1589, 281, 10373, 484, 264, 7193, 1088, 295, 12110, 11, 50743], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 371, "seek": 132164, "start": 1329.5600000000002, "end": 1331.66, "text": " but because of the ghost parity firewall,", "tokens": [50761, 457, 570, 295, 264, 8359, 44747, 36109, 11, 50866], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 372, "seek": 132164, "start": 1332.2800000000002, "end": 1335.2, "text": " by the time the calculation reaches the observable output,", "tokens": [50897, 538, 264, 565, 264, 17108, 14235, 264, 9951, 712, 5598, 11, 51043], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 373, "seek": 132164, "start": 1335.6000000000001, "end": 1338.0200000000002, "text": " the negativity has perfectly washed itself out.", "tokens": [51063, 264, 39297, 575, 6239, 16300, 2564, 484, 13, 51184], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 374, "seek": 132164, "start": 1338.24, "end": 1338.5400000000002, "text": " Yes.", "tokens": [51195, 1079, 13, 51210], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 375, "seek": 132164, "start": 1338.9, "end": 1342.72, "text": " And this requires us to deeply internalize the difference between", "tokens": [51228, 400, 341, 7029, 505, 281, 8760, 6920, 1125, 264, 2649, 1296, 51419], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 376, "seek": 132164, "start": 1342.72, "end": 1347.5400000000002, "text": " what Fliction calls a coordinate pathology and an observable pathology.", "tokens": [51419, 437, 3235, 4105, 5498, 257, 15670, 3100, 1793, 293, 364, 9951, 712, 3100, 1793, 13, 51660], "temperature": 0.0, "avg_logprob": -0.19406793631759345, "compression_ratio": 1.678294573643411, "no_speech_prob": 1.7279293230629267e-12}, {"id": 377, "seek": 134754, "start": 1347.54, "end": 1350.8, "text": " A coordinate pathology is a glitch, a weird feature,", "tokens": [50365, 316, 15670, 3100, 1793, 307, 257, 23552, 11, 257, 3657, 4111, 11, 50528], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 378, "seek": 134754, "start": 1351.02, "end": 1353.78, "text": " or a negative sign in the internal mathematical map.", "tokens": [50539, 420, 257, 3671, 1465, 294, 264, 6920, 18894, 4471, 13, 50677], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 379, "seek": 134754, "start": 1353.94, "end": 1354.68, "text": " Like the ledger.", "tokens": [50685, 1743, 264, 4684, 1321, 13, 50722], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 380, "seek": 134754, "start": 1354.82, "end": 1355.46, "text": " Like the ledger.", "tokens": [50729, 1743, 264, 4684, 1321, 13, 50761], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 381, "seek": 134754, "start": 1355.78, "end": 1358.78, "text": " An observable pathology is when the physical universe actually breaks", "tokens": [50777, 1107, 9951, 712, 3100, 1793, 307, 562, 264, 4001, 6445, 767, 9857, 50927], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 382, "seek": 134754, "start": 1358.78, "end": 1361.24, "text": " like a negative probability of an event happening in a lab.", "tokens": [50927, 411, 257, 3671, 8482, 295, 364, 2280, 2737, 294, 257, 2715, 13, 51050], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 383, "seek": 134754, "start": 1361.8799999999999, "end": 1366.56, "text": " Fliction argues, conclusively, that a ghost is merely a coordinate pathology.", "tokens": [51082, 3235, 4105, 38218, 11, 18646, 3413, 11, 300, 257, 8359, 307, 17003, 257, 15670, 3100, 1793, 13, 51316], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 384, "seek": 134754, "start": 1366.96, "end": 1370.2, "text": " It is a hidden mathematical direction in the admissibility manifold.", "tokens": [51336, 467, 307, 257, 7633, 18894, 3513, 294, 264, 5910, 891, 2841, 47138, 13, 51498], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 385, "seek": 134754, "start": 1370.78, "end": 1372.24, "text": " It does the heavy lifting in the background,", "tokens": [51527, 467, 775, 264, 4676, 15798, 294, 264, 3678, 11, 51600], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 386, "seek": 134754, "start": 1372.56, "end": 1374.68, "text": " but it never bleeds into physical reality.", "tokens": [51616, 457, 309, 1128, 5408, 5147, 666, 4001, 4103, 13, 51722], "temperature": 0.0, "avg_logprob": -0.1184354963756743, "compression_ratio": 1.793594306049822, "no_speech_prob": 1.8040573375455171e-12}, {"id": 387, "seek": 137468, "start": 1374.68, "end": 1379.5600000000002, "text": " So the physicists in the 1970s threw away the literal cure for quantum gravity", "tokens": [50365, 407, 264, 48716, 294, 264, 14577, 82, 11918, 1314, 264, 20411, 13698, 337, 13018, 12110, 50609], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 388, "seek": 137468, "start": 1379.5600000000002, "end": 1383.46, "text": " because they confused a coordinate glitch for an observable catastrophe.", "tokens": [50609, 570, 436, 9019, 257, 15670, 23552, 337, 364, 9951, 712, 36043, 13, 50804], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 389, "seek": 137468, "start": 1383.8600000000001, "end": 1386.3400000000001, "text": " They looked at a negative number in the internal ledger", "tokens": [50824, 814, 2956, 412, 257, 3671, 1230, 294, 264, 6920, 4684, 1321, 50948], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 390, "seek": 137468, "start": 1386.3400000000001, "end": 1389.0800000000002, "text": " and assumed the ATM was going to start spitting out antimatter.", "tokens": [50948, 293, 15895, 264, 46455, 390, 516, 281, 722, 637, 2414, 484, 46141, 1161, 13, 51085], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 391, "seek": 137468, "start": 1389.5800000000002, "end": 1391.8600000000001, "text": " They mistook the map for the territory.", "tokens": [51110, 814, 3544, 1212, 264, 4471, 337, 264, 11360, 13, 51224], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 392, "seek": 137468, "start": 1392.18, "end": 1394.5, "text": " That is the exact argument this paper is making.", "tokens": [51240, 663, 307, 264, 1900, 6770, 341, 3035, 307, 1455, 13, 51356], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 393, "seek": 137468, "start": 1395.04, "end": 1397.28, "text": " The ghost was never a threat to reality.", "tokens": [51383, 440, 8359, 390, 1128, 257, 4734, 281, 4103, 13, 51495], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 394, "seek": 137468, "start": 1397.7, "end": 1399.8400000000001, "text": " It was just a feature of the internal math.", "tokens": [51516, 467, 390, 445, 257, 4111, 295, 264, 6920, 5221, 13, 51623], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 395, "seek": 137468, "start": 1399.92, "end": 1401.5600000000002, "text": " Okay, the math checks out for probabilities.", "tokens": [51627, 1033, 11, 264, 5221, 13834, 484, 337, 33783, 13, 51709], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 396, "seek": 137468, "start": 1401.76, "end": 1402.5600000000002, "text": " We solved the ghost.", "tokens": [51719, 492, 13041, 264, 8359, 13, 51759], "temperature": 0.0, "avg_logprob": -0.12972115713452537, "compression_ratio": 1.6699346405228759, "no_speech_prob": 1.7279197820838088e-12}, {"id": 397, "seek": 140256, "start": 1402.56, "end": 1405.8799999999999, "text": " But if I'm tracking the history of physics correctly,", "tokens": [50365, 583, 498, 286, 478, 11603, 264, 2503, 295, 10649, 8944, 11, 50531], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 398, "seek": 140256, "start": 1406.48, "end": 1409.4199999999998, "text": " negative probabilities aren't the only mathematical monster", "tokens": [50561, 3671, 33783, 3212, 380, 264, 787, 18894, 10090, 50708], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 399, "seek": 140256, "start": 1409.4199999999998, "end": 1411.28, "text": " hiding in these higher derivative theories.", "tokens": [50708, 10596, 294, 613, 2946, 13760, 13667, 13, 50801], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 400, "seek": 140256, "start": 1411.84, "end": 1413.8799999999999, "text": " Probabilities are just one part of the equation.", "tokens": [50829, 8736, 6167, 366, 445, 472, 644, 295, 264, 5367, 13, 50931], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 401, "seek": 140256, "start": 1414.3799999999999, "end": 1415.26, "text": " What about energy?", "tokens": [50956, 708, 466, 2281, 30, 51000], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 402, "seek": 140256, "start": 1415.8799999999999, "end": 1419.1599999999999, "text": " Because there is an older, much scarier mathematical theorem", "tokens": [51031, 1436, 456, 307, 364, 4906, 11, 709, 10569, 811, 18894, 20904, 51195], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 403, "seek": 140256, "start": 1419.1599999999999, "end": 1421.24, "text": " from way back in the 19th century that says", "tokens": [51195, 490, 636, 646, 294, 264, 1294, 392, 4901, 300, 1619, 51299], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 404, "seek": 140256, "start": 1421.24, "end": 1424.82, "text": " adding these squared derivatives won't just mess up your probabilities.", "tokens": [51299, 5127, 613, 8889, 33733, 1582, 380, 445, 2082, 493, 428, 33783, 13, 51478], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 405, "seek": 140256, "start": 1424.82, "end": 1428.44, "text": " It will literally rip the universe apart with infinite energy.", "tokens": [51478, 467, 486, 3736, 12782, 264, 6445, 4936, 365, 13785, 2281, 13, 51659], "temperature": 0.0, "avg_logprob": -0.1317499325825618, "compression_ratio": 1.684782608695652, "no_speech_prob": 1.4664839438280342e-12}, {"id": 406, "seek": 142844, "start": 1428.44, "end": 1431.56, "text": " Ah, yes, the Ostrogradsky instability.", "tokens": [50365, 2438, 11, 2086, 11, 264, 34140, 6675, 81, 5834, 4133, 34379, 13, 50521], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 407, "seek": 142844, "start": 1431.88, "end": 1434.44, "text": " It is the great phantom menace of theoretical physics.", "tokens": [50537, 467, 307, 264, 869, 903, 25796, 1706, 617, 295, 20864, 10649, 13, 50665], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 408, "seek": 142844, "start": 1435.3400000000001, "end": 1440.16, "text": " It has been used as a club to beat down higher derivative theories for almost 200 years.", "tokens": [50710, 467, 575, 668, 1143, 382, 257, 6482, 281, 4224, 760, 2946, 13760, 13667, 337, 1920, 2331, 924, 13, 50951], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 409, "seek": 142844, "start": 1440.56, "end": 1441.6000000000001, "text": " Let's set the stage here.", "tokens": [50971, 961, 311, 992, 264, 3233, 510, 13, 51023], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 410, "seek": 142844, "start": 1442.26, "end": 1447.38, "text": " Who was Ostrogradsky and what mathematical curse did he unleash in 1850?", "tokens": [51056, 2102, 390, 34140, 6675, 81, 5834, 4133, 293, 437, 18894, 17139, 630, 415, 49814, 294, 2443, 2803, 30, 51312], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 411, "seek": 142844, "start": 1447.8600000000001, "end": 1450.8600000000001, "text": " Mikhail Ostrogradsky was a brilliant Russian mathematician.", "tokens": [51336, 16380, 48909, 34140, 6675, 81, 5834, 4133, 390, 257, 10248, 7220, 48281, 13, 51486], "temperature": 0.0, "avg_logprob": -0.2105649988702003, "compression_ratio": 1.5223214285714286, "no_speech_prob": 1.7147387025920335e-12}, {"id": 412, "seek": 145086, "start": 1450.86, "end": 1457.26, "text": " In 1850, he proved a highly robust, mathematically unassailable theorem in classical mechanics.", "tokens": [50365, 682, 2443, 2803, 11, 415, 14617, 257, 5405, 13956, 11, 44003, 517, 640, 32699, 20904, 294, 13735, 12939, 13, 50685], "temperature": 0.0, "avg_logprob": -0.18278951644897462, "compression_ratio": 1.5294117647058822, "no_speech_prob": 1.868327541287851e-12}, {"id": 413, "seek": 145086, "start": 1457.7199999999998, "end": 1462.8799999999999, "text": " He showed that any physical system whose equations rely on irreducible higher-order derivatives,", "tokens": [50708, 634, 4712, 300, 604, 4001, 1185, 6104, 11787, 10687, 322, 16014, 769, 32128, 2946, 12, 4687, 33733, 11, 50966], "temperature": 0.0, "avg_logprob": -0.18278951644897462, "compression_ratio": 1.5294117647058822, "no_speech_prob": 1.868327541287851e-12}, {"id": 414, "seek": 145086, "start": 1463.12, "end": 1468.26, "text": " meaning derivatives higher than the first order, like acceleration or the quadratic terms", "tokens": [50978, 3620, 33733, 2946, 813, 264, 700, 1668, 11, 411, 17162, 420, 264, 37262, 2115, 51235], "temperature": 0.0, "avg_logprob": -0.18278951644897462, "compression_ratio": 1.5294117647058822, "no_speech_prob": 1.868327541287851e-12}, {"id": 415, "seek": 145086, "start": 1468.26, "end": 1473.26, "text": " in Stel's gravity, will inherently possess a Hamiltonian that is unbounded below.", "tokens": [51235, 294, 745, 338, 311, 12110, 11, 486, 27993, 17490, 257, 18484, 952, 300, 307, 517, 18767, 292, 2507, 13, 51485], "temperature": 0.0, "avg_logprob": -0.18278951644897462, "compression_ratio": 1.5294117647058822, "no_speech_prob": 1.868327541287851e-12}, {"id": 416, "seek": 147326, "start": 1473.26, "end": 1474.28, "text": " Okay, let's unpack that.", "tokens": [50365, 1033, 11, 718, 311, 26699, 300, 13, 50416], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 417, "seek": 147326, "start": 1474.3799999999999, "end": 1474.96, "text": " The Hamiltonian.", "tokens": [50421, 440, 18484, 952, 13, 50450], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 418, "seek": 147326, "start": 1475.06, "end": 1480.7, "text": " In physics, the Hamiltonian is essentially the master equation for the total energy of a system, correct?", "tokens": [50455, 682, 10649, 11, 264, 18484, 952, 307, 4476, 264, 4505, 5367, 337, 264, 3217, 2281, 295, 257, 1185, 11, 3006, 30, 50737], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 419, "seek": 147326, "start": 1480.98, "end": 1481.3799999999999, "text": " Exactly.", "tokens": [50751, 7587, 13, 50771], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 420, "seek": 147326, "start": 1481.64, "end": 1482.92, "text": " It represents the total energy.", "tokens": [50784, 467, 8855, 264, 3217, 2281, 13, 50848], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 421, "seek": 147326, "start": 1483.26, "end": 1488.06, "text": " In a normal, healthy, physical system, the Hamiltonian has a floor, a ground state.", "tokens": [50865, 682, 257, 2710, 11, 4627, 11, 4001, 1185, 11, 264, 18484, 952, 575, 257, 4123, 11, 257, 2727, 1785, 13, 51105], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 422, "seek": 147326, "start": 1488.14, "end": 1491.66, "text": " The energy can't go to low zero or at least below some minimum value.", "tokens": [51109, 440, 2281, 393, 380, 352, 281, 2295, 4018, 420, 412, 1935, 2507, 512, 7285, 2158, 13, 51285], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 423, "seek": 147326, "start": 1492.06, "end": 1494.78, "text": " But Ostrogradsky proved that if your equations have higher derivatives,", "tokens": [51305, 583, 34140, 6675, 81, 5834, 4133, 14617, 300, 498, 428, 11787, 362, 2946, 33733, 11, 51441], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 424, "seek": 147326, "start": 1495.1, "end": 1498.74, "text": " the momentum of the system becomes linearly dependent on those higher derivatives.", "tokens": [51457, 264, 11244, 295, 264, 1185, 3643, 43586, 12334, 322, 729, 2946, 33733, 13, 51639], "temperature": 0.0, "avg_logprob": -0.15023594517861644, "compression_ratio": 1.7317073170731707, "no_speech_prob": 2.3806583874380616e-12}, {"id": 425, "seek": 149874, "start": 1498.74, "end": 1503.22, "text": " And because it's a linear dependence, you can push the energy arbitrarily far into the negative.", "tokens": [50365, 400, 570, 309, 311, 257, 8213, 31704, 11, 291, 393, 2944, 264, 2281, 19071, 3289, 1400, 666, 264, 3671, 13, 50589], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 426, "seek": 149874, "start": 1503.36, "end": 1504.38, "text": " There is no bottom floor.", "tokens": [50596, 821, 307, 572, 2767, 4123, 13, 50647], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 427, "seek": 149874, "start": 1504.58, "end": 1506.32, "text": " The Hamiltonian is unbounded below.", "tokens": [50657, 440, 18484, 952, 307, 517, 18767, 292, 2507, 13, 50744], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 428, "seek": 149874, "start": 1506.88, "end": 1509.6, "text": " It can plunge infinitely toward negative infinity.", "tokens": [50772, 467, 393, 499, 27588, 36227, 7361, 3671, 13202, 13, 50908], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 429, "seek": 149874, "start": 1509.82, "end": 1514.48, "text": " And what is the actual physical consequence of an energy state with no bottom floor?", "tokens": [50919, 400, 437, 307, 264, 3539, 4001, 18326, 295, 364, 2281, 1785, 365, 572, 2767, 4123, 30, 51152], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 430, "seek": 149874, "start": 1514.68, "end": 1515.94, "text": " Well, in isolation, nothing.", "tokens": [51162, 1042, 11, 294, 16001, 11, 1825, 13, 51225], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 431, "seek": 149874, "start": 1516.5, "end": 1517.96, "text": " But the universe isn't isolated.", "tokens": [51253, 583, 264, 6445, 1943, 380, 14621, 13, 51326], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 432, "seek": 149874, "start": 1518.44, "end": 1519.22, "text": " Things interact.", "tokens": [51350, 9514, 4648, 13, 51389], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 433, "seek": 149874, "start": 1519.76, "end": 1522.1, "text": " The standard physics interpretation is catastrophic.", "tokens": [51416, 440, 3832, 10649, 14174, 307, 34915, 13, 51533], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 434, "seek": 149874, "start": 1522.8, "end": 1527.28, "text": " If you take a normal system, say, standard electromagnetic fields with positive energy,", "tokens": [51568, 759, 291, 747, 257, 2710, 1185, 11, 584, 11, 3832, 32214, 7909, 365, 3353, 2281, 11, 51792], "temperature": 0.0, "avg_logprob": -0.1444335687355917, "compression_ratio": 1.7019867549668874, "no_speech_prob": 2.2100190601170855e-12}, {"id": 435, "seek": 152728, "start": 1527.28, "end": 1531.42, "text": " and you couple it to an Ostrogradsky system like higher derivative gravity,", "tokens": [50365, 293, 291, 1916, 309, 281, 364, 34140, 6675, 81, 5834, 4133, 1185, 411, 2946, 13760, 12110, 11, 50572], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 436, "seek": 152728, "start": 1532.06, "end": 1534.5, "text": " you get a runaway infinite energy exchange.", "tokens": [50604, 291, 483, 257, 1190, 10318, 13785, 2281, 7742, 13, 50726], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 437, "seek": 152728, "start": 1534.7, "end": 1535.32, "text": " Like a cascade.", "tokens": [50736, 1743, 257, 50080, 13, 50767], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 438, "seek": 152728, "start": 1535.5, "end": 1536.76, "text": " A catastrophic cascade.", "tokens": [50776, 316, 34915, 50080, 13, 50839], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 439, "seek": 152728, "start": 1537.02, "end": 1537.2, "text": " Yeah.", "tokens": [50852, 865, 13, 50861], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 440, "seek": 152728, "start": 1537.28, "end": 1539.86, "text": " Because the Ostrogradsky system has no bottom floor,", "tokens": [50865, 1436, 264, 34140, 6675, 81, 5834, 4133, 1185, 575, 572, 2767, 4123, 11, 50994], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 441, "seek": 152728, "start": 1540.08, "end": 1542.54, "text": " it can drop infinitely downward into negative energy.", "tokens": [51005, 309, 393, 3270, 36227, 24805, 666, 3671, 2281, 13, 51128], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 442, "seek": 152728, "start": 1542.78, "end": 1547.1399999999999, "text": " And because of the strict conservation of total energy for every unit of negative energy it drops,", "tokens": [51140, 400, 570, 295, 264, 10910, 16185, 295, 3217, 2281, 337, 633, 4985, 295, 3671, 2281, 309, 11438, 11, 51358], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 443, "seek": 152728, "start": 1547.5, "end": 1551.06, "text": " it pumps a unit of positive infinite energy into the normal system.", "tokens": [51376, 309, 27648, 257, 4985, 295, 3353, 13785, 2281, 666, 264, 2710, 1185, 13, 51554], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 444, "seek": 152728, "start": 1551.42, "end": 1554.34, "text": " The higher derivative system plunges to negative infinity,", "tokens": [51572, 440, 2946, 13760, 1185, 37663, 279, 281, 3671, 13202, 11, 51718], "temperature": 0.0, "avg_logprob": -0.15289319251194472, "compression_ratio": 1.8721804511278195, "no_speech_prob": 1.4550657770687203e-12}, {"id": 445, "seek": 155434, "start": 1554.34, "end": 1556.6399999999999, "text": " the normal system shoots up to positive infinity,", "tokens": [50365, 264, 2710, 1185, 20704, 493, 281, 3353, 13202, 11, 50480], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 446, "seek": 155434, "start": 1556.9199999999998, "end": 1562.0, "text": " and the universe instantly vaporizes in a runaway explosion of infinite heat and radiation.", "tokens": [50494, 293, 264, 6445, 13518, 20358, 5660, 294, 257, 1190, 10318, 15673, 295, 13785, 3738, 293, 12420, 13, 50748], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 447, "seek": 155434, "start": 1562.3799999999999, "end": 1563.76, "text": " Well, I mean, I don't know about you,", "tokens": [50767, 1042, 11, 286, 914, 11, 286, 500, 380, 458, 466, 291, 11, 50836], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 448, "seek": 155434, "start": 1563.8, "end": 1568.8, "text": " but I feel like I would have noticed if the universe had vaporized in a cascade of infinite energy.", "tokens": [50838, 457, 286, 841, 411, 286, 576, 362, 5694, 498, 264, 6445, 632, 20358, 1602, 294, 257, 50080, 295, 13785, 2281, 13, 51088], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 449, "seek": 155434, "start": 1569.24, "end": 1571.58, "text": " That definitely sounds like an observable pathology.", "tokens": [51110, 663, 2138, 3263, 411, 364, 9951, 712, 3100, 1793, 13, 51227], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 450, "seek": 155434, "start": 1571.9399999999998, "end": 1576.36, "text": " You can't just sweep infinite explosive energy under the rug with a clever probability trick.", "tokens": [51245, 509, 393, 380, 445, 22169, 13785, 24630, 2281, 833, 264, 18329, 365, 257, 13494, 8482, 4282, 13, 51466], "temperature": 0.0, "avg_logprob": -0.128512487411499, "compression_ratio": 1.6705882352941177, "no_speech_prob": 1.610600758664149e-12}, {"id": 451, "seek": 157636, "start": 1576.36, "end": 1582.6, "text": " So how on earth does Flixian's framework survive 170-year-old mathematical proof", "tokens": [50365, 407, 577, 322, 4120, 775, 3235, 970, 952, 311, 8388, 7867, 27228, 12, 5294, 12, 2641, 18894, 8177, 50677], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 452, "seek": 157636, "start": 1582.6, "end": 1585.04, "text": " that their theory should instantly destroy the universe?", "tokens": [50677, 300, 641, 5261, 820, 13518, 5293, 264, 6445, 30, 50799], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 453, "seek": 157636, "start": 1585.56, "end": 1592.3999999999999, "text": " You survive it by applying the exact same coordinate versus observable lens that we just used for the ghosts.", "tokens": [50825, 509, 7867, 309, 538, 9275, 264, 1900, 912, 15670, 5717, 9951, 712, 6765, 300, 321, 445, 1143, 337, 264, 21744, 13, 51167], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 454, "seek": 157636, "start": 1592.6799999999998, "end": 1599.12, "text": " You have to look at what Ostrogradsky actually proved versus what physicists merely assumed he proved.", "tokens": [51181, 509, 362, 281, 574, 412, 437, 34140, 6675, 81, 5834, 4133, 767, 14617, 5717, 437, 48716, 17003, 15895, 415, 14617, 13, 51503], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 455, "seek": 157636, "start": 1599.76, "end": 1603.1, "text": " Flixian explains this through a concept he calls the trajectory shift.", "tokens": [51535, 3235, 970, 952, 13948, 341, 807, 257, 3410, 415, 5498, 264, 21512, 5513, 13, 51702], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 456, "seek": 157636, "start": 1603.28, "end": 1604.78, "text": " What's the trajectory shift?", "tokens": [51711, 708, 311, 264, 21512, 5513, 30, 51786], "temperature": 0.0, "avg_logprob": -0.14009466449033867, "compression_ratio": 1.6423357664233578, "no_speech_prob": 1.6617401898955109e-12}, {"id": 457, "seek": 160478, "start": 1604.78, "end": 1608.8999999999999, "text": " You see, Ostrogradsky made a mathematical claim about the phase space of the system.", "tokens": [50365, 509, 536, 11, 34140, 6675, 81, 5834, 4133, 1027, 257, 18894, 3932, 466, 264, 5574, 1901, 295, 264, 1185, 13, 50571], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 458, "seek": 160478, "start": 1609.58, "end": 1612.98, "text": " Phase space is the vast, multidimensional mathematical arena", "tokens": [50605, 24432, 1901, 307, 264, 8369, 11, 2120, 327, 332, 11075, 18894, 18451, 50775], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 459, "seek": 160478, "start": 1612.98, "end": 1616.2, "text": " of all potentially possible states a system could occupy,", "tokens": [50775, 295, 439, 7263, 1944, 4368, 257, 1185, 727, 30645, 11, 50936], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 460, "seek": 160478, "start": 1616.58, "end": 1618.34, "text": " regardless of the actual laws of motion.", "tokens": [50955, 10060, 295, 264, 3539, 6064, 295, 5394, 13, 51043], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 461, "seek": 160478, "start": 1618.8799999999999, "end": 1622.1, "text": " But observable physics isn't about the whole phase space.", "tokens": [51070, 583, 9951, 712, 10649, 1943, 380, 466, 264, 1379, 5574, 1901, 13, 51231], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 462, "seek": 160478, "start": 1622.46, "end": 1626.26, "text": " It is about the actual histories or trajectories that the dynamics generate over time,", "tokens": [51249, 467, 307, 466, 264, 3539, 30631, 420, 18257, 2083, 300, 264, 15679, 8460, 670, 565, 11, 51439], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 463, "seek": 160478, "start": 1626.58, "end": 1628.22, "text": " based on actual initial conditions.", "tokens": [51455, 2361, 322, 3539, 5883, 4487, 13, 51537], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 464, "seek": 160478, "start": 1628.3799999999999, "end": 1630.8, "text": " I'm going to need a strong analogy to visualize this.", "tokens": [51545, 286, 478, 516, 281, 643, 257, 2068, 21663, 281, 23273, 341, 13, 51666], "temperature": 0.0, "avg_logprob": -0.13077290852864584, "compression_ratio": 1.7292418772563176, "no_speech_prob": 2.2619441042426303e-12}, {"id": 465, "seek": 163080, "start": 1630.8, "end": 1634.08, "text": " I'm thinking about a roller coaster.", "tokens": [50365, 286, 478, 1953, 466, 257, 15948, 28442, 13, 50529], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 466, "seek": 163080, "start": 1634.28, "end": 1638.94, "text": " Let's say Ostrogradsky is a hyper-pedantic safety inspector", "tokens": [50539, 961, 311, 584, 34140, 6675, 81, 5834, 4133, 307, 257, 9848, 12, 3452, 7128, 4514, 34564, 50772], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 467, "seek": 163080, "start": 1638.94, "end": 1643.8799999999999, "text": " looking at a mathematical blueprint of a completely wild new roller coaster.", "tokens": [50772, 1237, 412, 257, 18894, 35868, 295, 257, 2584, 4868, 777, 15948, 28442, 13, 51019], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 468, "seek": 163080, "start": 1644.0, "end": 1644.68, "text": " Okay, I'm waiting.", "tokens": [51025, 1033, 11, 286, 478, 3806, 13, 51059], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 469, "seek": 163080, "start": 1644.74, "end": 1647.12, "text": " And he points the equations of the blueprint and says,", "tokens": [51062, 400, 415, 2793, 264, 11787, 295, 264, 35868, 293, 1619, 11, 51181], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 470, "seek": 163080, "start": 1647.6, "end": 1649.32, "text": " look, according to this math,", "tokens": [51205, 574, 11, 4650, 281, 341, 5221, 11, 51291], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 471, "seek": 163080, "start": 1649.3999999999999, "end": 1653.2, "text": " the track technically extends infinitely down into the bedrock of the earth.", "tokens": [51295, 264, 2837, 12120, 26448, 36227, 760, 666, 264, 2901, 17799, 295, 264, 4120, 13, 51485], "temperature": 0.0, "avg_logprob": -0.15951365166968043, "compression_ratio": 1.5594713656387664, "no_speech_prob": 1.9197206758275742e-12}, {"id": 472, "seek": 165320, "start": 1653.2, "end": 1655.32, "text": " It's an unbounded phase space.", "tokens": [50365, 467, 311, 364, 517, 18767, 292, 5574, 1901, 13, 50471], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 473, "seek": 165320, "start": 1655.8400000000001, "end": 1659.42, "text": " The cart has the mathematical potential to plunge to the center of the planet.", "tokens": [50497, 440, 5467, 575, 264, 18894, 3995, 281, 499, 27588, 281, 264, 3056, 295, 264, 5054, 13, 50676], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 474, "seek": 165320, "start": 1659.64, "end": 1664.06, "text": " But as the person actually strapped into the cart riding the roller coaster,", "tokens": [50687, 583, 382, 264, 954, 767, 2148, 3320, 666, 264, 5467, 9546, 264, 15948, 28442, 11, 50908], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 475, "seek": 165320, "start": 1664.2, "end": 1667.32, "text": " I'm sitting there saying it doesn't matter where the theoretical blueprint could go.", "tokens": [50915, 286, 478, 3798, 456, 1566, 309, 1177, 380, 1871, 689, 264, 20864, 35868, 727, 352, 13, 51071], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 476, "seek": 165320, "start": 1667.66, "end": 1671.04, "text": " The actual physical cart is locked onto a specific dynamic loop.", "tokens": [51088, 440, 3539, 4001, 5467, 307, 9376, 3911, 257, 2685, 8546, 6367, 13, 51257], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 477, "seek": 165320, "start": 1671.42, "end": 1675.5, "text": " The laws of momentum and the track design strictly dictate its trajectory.", "tokens": [51276, 440, 6064, 295, 11244, 293, 264, 2837, 1715, 20792, 36071, 1080, 21512, 13, 51480], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 478, "seek": 165320, "start": 1675.5, "end": 1678.56, "text": " It never actually accesses those downward infinite tracks.", "tokens": [51480, 467, 1128, 767, 2105, 279, 729, 24805, 13785, 10218, 13, 51633], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 479, "seek": 165320, "start": 1678.72, "end": 1679.96, "text": " Is that the trajectory shift?", "tokens": [51641, 1119, 300, 264, 21512, 5513, 30, 51703], "temperature": 0.0, "avg_logprob": -0.11286166647206182, "compression_ratio": 1.7123287671232876, "no_speech_prob": 1.451923217071771e-12}, {"id": 480, "seek": 167996, "start": 1679.96, "end": 1682.68, "text": " That is a phenomenal, perfect analogy.", "tokens": [50365, 663, 307, 257, 17778, 11, 2176, 21663, 13, 50501], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 481, "seek": 167996, "start": 1683.46, "end": 1687.26, "text": " The person riding the coaster represents the physical observable trajectory.", "tokens": [50540, 440, 954, 9546, 264, 28442, 8855, 264, 4001, 9951, 712, 21512, 13, 50730], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 482, "seek": 167996, "start": 1687.9, "end": 1691.68, "text": " Ostrogradsky is panicking about the empty mathematically possible space", "tokens": [50762, 34140, 6675, 81, 5834, 4133, 307, 2462, 10401, 466, 264, 6707, 44003, 1944, 1901, 50951], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 483, "seek": 167996, "start": 1691.68, "end": 1694.14, "text": " beneath the tracks that the cart never actually reaches.", "tokens": [50951, 17149, 264, 10218, 300, 264, 5467, 1128, 767, 14235, 13, 51074], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 484, "seek": 167996, "start": 1695.04, "end": 1698.08, "text": " The phase space has a runaway direction mathematically,", "tokens": [51119, 440, 5574, 1901, 575, 257, 1190, 10318, 3513, 44003, 11, 51271], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 485, "seek": 167996, "start": 1698.56, "end": 1701.72, "text": " but the actual dynamic trajectory is completely stable.", "tokens": [51295, 457, 264, 3539, 8546, 21512, 307, 2584, 8351, 13, 51453], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 486, "seek": 167996, "start": 1701.9, "end": 1702.96, "text": " An analogy is great,", "tokens": [51462, 1107, 21663, 307, 869, 11, 51515], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 487, "seek": 167996, "start": 1703.1000000000001, "end": 1707.02, "text": " but do we have proof that physical systems actually behave this way?", "tokens": [51522, 457, 360, 321, 362, 8177, 300, 4001, 3652, 767, 15158, 341, 636, 30, 51718], "temperature": 0.0, "avg_logprob": -0.13347313620827414, "compression_ratio": 1.735408560311284, "no_speech_prob": 1.377838164742795e-12}, {"id": 488, "seek": 170702, "start": 1707.02, "end": 1711.3, "text": " That they can have an unbounded phase space, but a perfectly stable trajectory.", "tokens": [50365, 663, 436, 393, 362, 364, 517, 18767, 292, 5574, 1901, 11, 457, 257, 6239, 8351, 21512, 13, 50579], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 489, "seek": 170702, "start": 1711.58, "end": 1712.3, "text": " You absolutely do.", "tokens": [50593, 509, 3122, 360, 13, 50629], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 490, "seek": 170702, "start": 1712.56, "end": 1716.94, "text": " The paper highlights a classic physics model called the Pius-Ullenbeck oscillator.", "tokens": [50642, 440, 3035, 14254, 257, 7230, 10649, 2316, 1219, 264, 430, 4872, 12, 52, 19191, 650, 547, 43859, 13, 50861], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 491, "seek": 170702, "start": 1717.66, "end": 1721.7, "text": " It was formulated in 1950 specifically to study this exact problem.", "tokens": [50897, 467, 390, 48936, 294, 18141, 4682, 281, 2979, 341, 1900, 1154, 13, 51099], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 492, "seek": 170702, "start": 1722.42, "end": 1726.36, "text": " It's a theoretical model of a particle governed by a fourth-order differential equation.", "tokens": [51135, 467, 311, 257, 20864, 2316, 295, 257, 12359, 35529, 538, 257, 6409, 12, 4687, 15756, 5367, 13, 51332], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 493, "seek": 170702, "start": 1726.96, "end": 1728.12, "text": " Because it has higher derivatives,", "tokens": [51362, 1436, 309, 575, 2946, 33733, 11, 51420], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 494, "seek": 170702, "start": 1728.56, "end": 1731.66, "text": " its Hamiltonian is strictly mathematically unbounded below,", "tokens": [51442, 1080, 18484, 952, 307, 20792, 44003, 517, 18767, 292, 2507, 11, 51597], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 495, "seek": 170702, "start": 1732.06, "end": 1733.6, "text": " exactly as Ostrogradsky warned.", "tokens": [51617, 2293, 382, 34140, 6675, 81, 5834, 4133, 21284, 13, 51694], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 496, "seek": 170702, "start": 1734.04, "end": 1735.5, "text": " According to the naive interpretation,", "tokens": [51716, 7328, 281, 264, 29052, 14174, 11, 51789], "temperature": 0.0, "avg_logprob": -0.19376702308654786, "compression_ratio": 1.5365853658536586, "no_speech_prob": 1.8540676806344525e-12}, {"id": 497, "seek": 173550, "start": 1735.5, "end": 1736.88, "text": " it should just explode.", "tokens": [50365, 309, 820, 445, 21411, 13, 50434], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 498, "seek": 173550, "start": 1737.0, "end": 1737.52, "text": " But it doesn't.", "tokens": [50440, 583, 309, 1177, 380, 13, 50466], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 499, "seek": 173550, "start": 1737.66, "end": 1738.46, "text": " It doesn't.", "tokens": [50473, 467, 1177, 380, 13, 50513], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 500, "seek": 173550, "start": 1738.56, "end": 1742.62, "text": " When you actually sit down and calculate the physical motion of the Pius-Ullenbeck oscillator,", "tokens": [50518, 1133, 291, 767, 1394, 760, 293, 8873, 264, 4001, 5394, 295, 264, 430, 4872, 12, 52, 19191, 650, 547, 43859, 11, 50721], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 501, "seek": 173550, "start": 1743.16, "end": 1744.6, "text": " when you map the trajectory,", "tokens": [50748, 562, 291, 4471, 264, 21512, 11, 50820], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 502, "seek": 173550, "start": 1745.52, "end": 1748.64, "text": " the fourth-order equation beautifully decomposes", "tokens": [50866, 264, 6409, 12, 4687, 5367, 16525, 22867, 4201, 51022], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 503, "seek": 173550, "start": 1748.64, "end": 1753.42, "text": " into two coupled, standard, second-order harmonic oscillators.", "tokens": [51022, 666, 732, 29482, 11, 3832, 11, 1150, 12, 4687, 32270, 18225, 3391, 13, 51261], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 504, "seek": 173550, "start": 1753.56, "end": 1754.16, "text": " Meaning what?", "tokens": [51268, 19948, 437, 30, 51298], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 505, "seek": 173550, "start": 1754.42, "end": 1757.54, "text": " It literally just becomes two pendulums swinging back and forth.", "tokens": [51311, 467, 3736, 445, 3643, 732, 12179, 425, 8099, 29500, 646, 293, 5220, 13, 51467], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 506, "seek": 173550, "start": 1757.54, "end": 1763.0, "text": " Its actual physical motion is perfectly bounded, periodic, and eternally stable.", "tokens": [51467, 6953, 3539, 4001, 5394, 307, 6239, 37498, 11, 27790, 11, 293, 10533, 379, 8351, 13, 51740], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 507, "seek": 173550, "start": 1763.6, "end": 1764.74, "text": " It never explodes.", "tokens": [51770, 467, 1128, 42610, 13, 51827], "temperature": 0.0, "avg_logprob": -0.2170308956429978, "compression_ratio": 1.6583629893238434, "no_speech_prob": 2.0201334095110157e-12}, {"id": 508, "seek": 176474, "start": 1764.74, "end": 1770.16, "text": " The runaway infinite energy directions undeniably exist in the mathematical phase space,", "tokens": [50365, 440, 1190, 10318, 13785, 2281, 11095, 674, 15711, 1188, 2514, 294, 264, 18894, 5574, 1901, 11, 50636], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 509, "seek": 176474, "start": 1770.28, "end": 1770.68, "text": " the blueprint.", "tokens": [50642, 264, 35868, 13, 50662], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 510, "seek": 176474, "start": 1771.32, "end": 1773.74, "text": " But the physical trajectory never, ever goes there.", "tokens": [50694, 583, 264, 4001, 21512, 1128, 11, 1562, 1709, 456, 13, 50815], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 511, "seek": 176474, "start": 1773.98, "end": 1779.1200000000001, "text": " So you're saying a 19th century mathematician proved a theorem that terrified physicists for a", "tokens": [50827, 407, 291, 434, 1566, 257, 1294, 392, 4901, 48281, 14617, 257, 20904, 300, 23051, 48716, 337, 257, 51084], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 512, "seek": 176474, "start": 1779.1200000000001, "end": 1782.14, "text": " century and a half, and it turns out it's mathematically true,", "tokens": [51084, 4901, 293, 257, 1922, 11, 293, 309, 4523, 484, 309, 311, 44003, 2074, 11, 51235], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 513, "seek": 176474, "start": 1782.26, "end": 1785.04, "text": " but totally physically irrelevant to the actual outcome.", "tokens": [51241, 457, 3879, 9762, 28682, 281, 264, 3539, 9700, 13, 51380], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 514, "seek": 176474, "start": 1785.28, "end": 1788.46, "text": " It is a property of the state space, not a property of the history.", "tokens": [51392, 467, 307, 257, 4707, 295, 264, 1785, 1901, 11, 406, 257, 4707, 295, 264, 2503, 13, 51551], "temperature": 0.0, "avg_logprob": -0.1746302878502572, "compression_ratio": 1.7109375, "no_speech_prob": 2.0970104992745764e-12}, {"id": 515, "seek": 178846, "start": 1788.46, "end": 1793.92, "text": " And Neil Turok, when applying this to quadratic gravity, made an even more brilliant observation.", "tokens": [50365, 400, 18615, 314, 7052, 74, 11, 562, 9275, 341, 281, 37262, 12110, 11, 1027, 364, 754, 544, 10248, 14816, 13, 50638], "temperature": 0.0, "avg_logprob": -0.17726487698762314, "compression_ratio": 1.5863874345549738, "no_speech_prob": 1.7485616904053258e-12}, {"id": 516, "seek": 178846, "start": 1794.7, "end": 1797.92, "text": " Physicists have been terrified of gravity having a negative energy instability.", "tokens": [50677, 15542, 299, 1751, 362, 668, 23051, 295, 12110, 1419, 257, 3671, 2281, 34379, 13, 50838], "temperature": 0.0, "avg_logprob": -0.17726487698762314, "compression_ratio": 1.5863874345549738, "no_speech_prob": 1.7485616904053258e-12}, {"id": 517, "seek": 178846, "start": 1798.64, "end": 1801.0, "text": " But gravity already has negative energy.", "tokens": [50874, 583, 12110, 1217, 575, 3671, 2281, 13, 50992], "temperature": 0.0, "avg_logprob": -0.17726487698762314, "compression_ratio": 1.5863874345549738, "no_speech_prob": 1.7485616904053258e-12}, {"id": 518, "seek": 178846, "start": 1801.14, "end": 1802.9, "text": " It's a fundamental feature of general relativity.", "tokens": [50999, 467, 311, 257, 8088, 4111, 295, 2674, 45675, 13, 51087], "temperature": 0.0, "avg_logprob": -0.17726487698762314, "compression_ratio": 1.5863874345549738, "no_speech_prob": 1.7485616904053258e-12}, {"id": 519, "seek": 178846, "start": 1803.1000000000001, "end": 1804.74, "text": " Wait, gravity has negative energy?", "tokens": [51097, 3802, 11, 12110, 575, 3671, 2281, 30, 51179], "temperature": 0.0, "avg_logprob": -0.17726487698762314, "compression_ratio": 1.5863874345549738, "no_speech_prob": 1.7485616904053258e-12}, {"id": 520, "seek": 180474, "start": 1804.74, "end": 1810.08, "text": " Yes, the gravitational potential energy of any bound system, like the Earth orbiting the", "tokens": [50365, 1079, 11, 264, 28538, 3995, 2281, 295, 604, 5472, 1185, 11, 411, 264, 4755, 48985, 264, 50632], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 521, "seek": 180474, "start": 1810.08, "end": 1811.68, "text": " Sun, is negative.", "tokens": [50632, 6163, 11, 307, 3671, 13, 50712], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 522, "seek": 180474, "start": 1812.46, "end": 1817.22, "text": " You have to add positive energy to the Earth like a massive rocket booster to break it out", "tokens": [50751, 509, 362, 281, 909, 3353, 2281, 281, 264, 4755, 411, 257, 5994, 13012, 29275, 281, 1821, 309, 484, 50989], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 523, "seek": 180474, "start": 1817.22, "end": 1818.4, "text": " of the negative gravity well.", "tokens": [50989, 295, 264, 3671, 12110, 731, 13, 51048], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 524, "seek": 180474, "start": 1818.52, "end": 1821.7, "text": " Okay, so negative energy isn't new, but what about the runaway cascade?", "tokens": [51054, 1033, 11, 370, 3671, 2281, 1943, 380, 777, 11, 457, 437, 466, 264, 1190, 10318, 50080, 30, 51213], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 525, "seek": 180474, "start": 1821.9, "end": 1822.82, "text": " That's the scary part.", "tokens": [51223, 663, 311, 264, 6958, 644, 13, 51269], "temperature": 0.0, "avg_logprob": -0.1350819657488567, "compression_ratio": 1.5862068965517242, "no_speech_prob": 1.782393785516867e-12}, {"id": 526, "seek": 182282, "start": 1822.82, "end": 1825.06, "text": " Look at the observable universe right now.", "tokens": [50365, 2053, 412, 264, 9951, 712, 6445, 558, 586, 13, 50477], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 527, "seek": 182282, "start": 1825.4199999999998, "end": 1830.6399999999999, "text": " Observations confirmed in the late 1990s that our universe is undergoing exponential accelerating", "tokens": [50495, 42547, 763, 11341, 294, 264, 3469, 13384, 82, 300, 527, 6445, 307, 40033, 21510, 34391, 50756], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 528, "seek": 182282, "start": 1830.6399999999999, "end": 1831.22, "text": " expansion.", "tokens": [50756, 11260, 13, 50785], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 529, "seek": 182282, "start": 1832.06, "end": 1832.76, "text": " Dark energy.", "tokens": [50827, 9563, 2281, 13, 50862], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 530, "seek": 182282, "start": 1833.54, "end": 1838.4199999999998, "text": " Out of context, if you just handed a mathematician the equations for exponential expansion, it", "tokens": [50901, 5925, 295, 4319, 11, 498, 291, 445, 16013, 257, 48281, 264, 11787, 337, 21510, 11260, 11, 309, 51145], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 531, "seek": 182282, "start": 1838.4199999999998, "end": 1840.82, "text": " looks exactly like an Ostrogrodsky runaway instability.", "tokens": [51145, 1542, 2293, 411, 364, 34140, 6675, 11452, 25810, 1190, 10318, 34379, 13, 51265], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 532, "seek": 182282, "start": 1841.1399999999999, "end": 1842.2, "text": " Wait, hang on a second.", "tokens": [51281, 3802, 11, 3967, 322, 257, 1150, 13, 51334], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 533, "seek": 182282, "start": 1842.36, "end": 1846.4199999999998, "text": " The expansion of our universe looks mathematically identical to an Ostrogrodsky instability.", "tokens": [51342, 440, 11260, 295, 527, 6445, 1542, 44003, 14800, 281, 364, 34140, 6675, 11452, 25810, 34379, 13, 51545], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 534, "seek": 182282, "start": 1846.82, "end": 1847.1799999999998, "text": " Yes.", "tokens": [51565, 1079, 13, 51583], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 535, "seek": 182282, "start": 1847.72, "end": 1852.8, "text": " If you look at the scale factor of the universe growing exponentially, the coordinate spaces", "tokens": [51610, 759, 291, 574, 412, 264, 4373, 5952, 295, 264, 6445, 4194, 37330, 11, 264, 15670, 7673, 51864], "temperature": 0.0, "avg_logprob": -0.14799669754406639, "compression_ratio": 1.8213058419243986, "no_speech_prob": 1.761992678497859e-12}, {"id": 536, "seek": 185280, "start": 1852.8, "end": 1853.94, "text": " is racing toward infinity.", "tokens": [50365, 307, 12553, 7361, 13202, 13, 50422], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 537, "seek": 185280, "start": 1854.86, "end": 1859.34, "text": " Turok points out that it sounds awfully like a catastrophic instability, but look out the", "tokens": [50468, 314, 7052, 74, 2793, 484, 300, 309, 3263, 47976, 411, 257, 34915, 34379, 11, 457, 574, 484, 264, 50692], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 538, "seek": 185280, "start": 1859.34, "end": 1859.58, "text": " window.", "tokens": [50692, 4910, 13, 50704], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 539, "seek": 185280, "start": 1860.18, "end": 1863.84, "text": " It is demonstrably a perfectly stable cosmological solution.", "tokens": [50734, 467, 307, 5516, 5305, 356, 257, 6239, 8351, 22207, 4383, 3827, 13, 50917], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 540, "seek": 185280, "start": 1864.62, "end": 1867.96, "text": " The universe isn't exploding in a cascade of localized infinite heat.", "tokens": [50956, 440, 6445, 1943, 380, 35175, 294, 257, 50080, 295, 44574, 13785, 3738, 13, 51123], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 541, "seek": 185280, "start": 1868.24, "end": 1869.74, "text": " It is just expanding smoothly.", "tokens": [51137, 467, 307, 445, 14702, 19565, 13, 51212], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 542, "seek": 185280, "start": 1870.5, "end": 1876.1599999999999, "text": " When Turok and Bateman analyzed their four-derivative quadratic gravity theory, they found that the Ostrogrodsky", "tokens": [51250, 1133, 314, 7052, 74, 293, 10066, 15023, 28181, 641, 1451, 12, 1068, 592, 1166, 37262, 12110, 5261, 11, 436, 1352, 300, 264, 34140, 6675, 11452, 25810, 51533], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 543, "seek": 185280, "start": 1876.1599999999999, "end": 1881.8799999999999, "text": " runaway direction in the extended phase space corresponds precisely to normal, perfectly stable", "tokens": [51533, 1190, 10318, 3513, 294, 264, 10913, 5574, 1901, 23249, 13402, 281, 2710, 11, 6239, 8351, 51819], "temperature": 0.0, "avg_logprob": -0.14801753500233525, "compression_ratio": 1.6282894736842106, "no_speech_prob": 2.504826641241964e-12}, {"id": 544, "seek": 188188, "start": 1881.88, "end": 1883.8200000000002, "text": " exponential cosmological expansion.", "tokens": [50365, 21510, 22207, 4383, 11260, 13, 50462], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 545, "seek": 188188, "start": 1883.8200000000002, "end": 1884.94, "text": " That is incredible.", "tokens": [50462, 663, 307, 4651, 13, 50518], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 546, "seek": 188188, "start": 1885.2, "end": 1889.48, "text": " So the terrifying mathematical instability that has been the boogeyman of quantum gravity", "tokens": [50531, 407, 264, 18106, 18894, 34379, 300, 575, 668, 264, 23113, 432, 88, 1601, 295, 13018, 12110, 50745], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 547, "seek": 188188, "start": 1889.48, "end": 1892.64, "text": " since the 1850s is just, well, it's just the universe expanding.", "tokens": [50745, 1670, 264, 2443, 2803, 82, 307, 445, 11, 731, 11, 309, 311, 445, 264, 6445, 14702, 13, 50903], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 548, "seek": 188188, "start": 1892.7600000000002, "end": 1893.18, "text": " Exactly.", "tokens": [50909, 7587, 13, 50930], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 549, "seek": 188188, "start": 1893.7, "end": 1896.14, "text": " The instability is not an observable pathology.", "tokens": [50956, 440, 34379, 307, 406, 364, 9951, 712, 3100, 1793, 13, 51078], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 550, "seek": 188188, "start": 1896.64, "end": 1901.5600000000002, "text": " It is simply a coordinate description of ordinary cosmological behavior in the admissibility", "tokens": [51103, 467, 307, 2935, 257, 15670, 3855, 295, 10547, 22207, 4383, 5223, 294, 264, 5910, 891, 2841, 51349], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 551, "seek": 188188, "start": 1901.5600000000002, "end": 1902.0, "text": " manifold.", "tokens": [51349, 47138, 13, 51371], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 552, "seek": 188188, "start": 1902.5800000000002, "end": 1905.7, "text": " The blueprint looks scary, but the rollercoaster ride is perfectly smooth.", "tokens": [51400, 440, 35868, 1542, 6958, 11, 457, 264, 15948, 1291, 1727, 5077, 307, 6239, 5508, 13, 51556], "temperature": 0.0, "avg_logprob": -0.14707987776426512, "compression_ratio": 1.6181818181818182, "no_speech_prob": 1.9813634240251066e-12}, {"id": 553, "seek": 190570, "start": 1905.7, "end": 1909.94, "text": " Okay, if this is true, it forces a massive philosophical pivot.", "tokens": [50365, 1033, 11, 498, 341, 307, 2074, 11, 309, 5874, 257, 5994, 25066, 14538, 13, 50577], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 554, "seek": 190570, "start": 1910.94, "end": 1915.56, "text": " If negative probabilities, ghosts, and infinite runaway energies can all be safely hidden away", "tokens": [50627, 759, 3671, 33783, 11, 21744, 11, 293, 13785, 1190, 10318, 25737, 393, 439, 312, 11750, 7633, 1314, 50858], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 555, "seek": 190570, "start": 1915.56, "end": 1920.98, "text": " as mathematical shadows in the internal ledger, it forces us to rethink the very mechanism", "tokens": [50858, 382, 18894, 14740, 294, 264, 6920, 4684, 1321, 11, 309, 5874, 505, 281, 34595, 264, 588, 7513, 51129], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 556, "seek": 190570, "start": 1920.98, "end": 1922.8600000000001, "text": " that casts those shadows in the first place.", "tokens": [51129, 300, 41921, 729, 14740, 294, 264, 700, 1081, 13, 51223], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 557, "seek": 190570, "start": 1923.28, "end": 1928.68, "text": " If we are only seeing the positive, bounded, stable output, what is the filter?", "tokens": [51244, 759, 321, 366, 787, 2577, 264, 3353, 11, 37498, 11, 8351, 5598, 11, 437, 307, 264, 6608, 30, 51514], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 558, "seek": 190570, "start": 1929.06, "end": 1933.0, "text": " What is the ATM machine actually doing to the math before we observe it?", "tokens": [51533, 708, 307, 264, 46455, 3479, 767, 884, 281, 264, 5221, 949, 321, 11441, 309, 30, 51730], "temperature": 0.0, "avg_logprob": -0.08371186256408691, "compression_ratio": 1.6494464944649447, "no_speech_prob": 2.297558844566172e-12}, {"id": 559, "seek": 193300, "start": 1933.0, "end": 1937.1, "text": " Which brings us to arguably the most paradigm-shifting section of Flixian's paper.", "tokens": [50365, 3013, 5607, 505, 281, 26771, 264, 881, 24709, 12, 2716, 10106, 3541, 295, 3235, 970, 952, 311, 3035, 13, 50570], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 560, "seek": 193300, "start": 1937.6, "end": 1940.92, "text": " We have to talk about how quantum probability itself is generated.", "tokens": [50595, 492, 362, 281, 751, 466, 577, 13018, 8482, 2564, 307, 10833, 13, 50761], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 561, "seek": 193300, "start": 1941.32, "end": 1944.82, "text": " We have to talk about the squaring trick and the true nature of the Bourne rule.", "tokens": [50781, 492, 362, 281, 751, 466, 264, 2339, 1921, 4282, 293, 264, 2074, 3687, 295, 264, 35866, 716, 4978, 13, 50956], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 562, "seek": 193300, "start": 1944.98, "end": 1946.36, "text": " Yes, section four of the outline.", "tokens": [50964, 1079, 11, 3541, 1451, 295, 264, 16387, 13, 51033], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 563, "seek": 193300, "start": 1946.62, "end": 1950.16, "text": " This is the part of the paper that really blew my mind because it attacks a concept I thought", "tokens": [51046, 639, 307, 264, 644, 295, 264, 3035, 300, 534, 19075, 452, 1575, 570, 309, 8122, 257, 3410, 286, 1194, 51223], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 564, "seek": 193300, "start": 1950.16, "end": 1952.26, "text": " was a completely foundational axiom of nature.", "tokens": [51223, 390, 257, 2584, 32195, 6360, 72, 298, 295, 3687, 13, 51328], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 565, "seek": 193300, "start": 1952.8, "end": 1954.06, "text": " Let's talk about the Bourne rule.", "tokens": [51355, 961, 311, 751, 466, 264, 35866, 716, 4978, 13, 51418], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 566, "seek": 193300, "start": 1954.32, "end": 1956.96, "text": " What is it and how have physicists traditionally viewed it?", "tokens": [51431, 708, 307, 309, 293, 577, 362, 48716, 19067, 19174, 309, 30, 51563], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 567, "seek": 193300, "start": 1956.96, "end": 1962.52, "text": " The Bourne rule is the fundamental bridge between the bizarre abstract math of quantum mechanics", "tokens": [51563, 440, 35866, 716, 4978, 307, 264, 8088, 7283, 1296, 264, 18265, 12649, 5221, 295, 13018, 12939, 51841], "temperature": 0.0, "avg_logprob": -0.12558210146177065, "compression_ratio": 1.7738095238095237, "no_speech_prob": 2.227903408633103e-12}, {"id": 568, "seek": 196252, "start": 1962.52, "end": 1964.24, "text": " and the tangible real world.", "tokens": [50365, 293, 264, 27094, 957, 1002, 13, 50451], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 569, "seek": 196252, "start": 1964.8799999999999, "end": 1970.34, "text": " In quantum math, a system is described by a wave function which assigns a probability amplitude", "tokens": [50483, 682, 13018, 5221, 11, 257, 1185, 307, 7619, 538, 257, 5772, 2445, 597, 6269, 82, 257, 8482, 27433, 50756], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 570, "seek": 196252, "start": 1970.34, "end": 1972.16, "text": " to every possible outcome.", "tokens": [50756, 281, 633, 1944, 9700, 13, 50847], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 571, "seek": 196252, "start": 1972.52, "end": 1974.4, "text": " But these amplitudes are not normal numbers.", "tokens": [50865, 583, 613, 9731, 16451, 366, 406, 2710, 3547, 13, 50959], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 572, "seek": 196252, "start": 1974.54, "end": 1975.6, "text": " They are complex numbers.", "tokens": [50966, 814, 366, 3997, 3547, 13, 51019], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 573, "seek": 196252, "start": 1976.02, "end": 1980.22, "text": " They have a real part and an imaginary part involving e, the square root of negative one.", "tokens": [51040, 814, 362, 257, 957, 644, 293, 364, 26164, 644, 17030, 308, 11, 264, 3732, 5593, 295, 3671, 472, 13, 51250], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 574, "seek": 196252, "start": 1980.3, "end": 1981.6399999999999, "text": " You can't observe an imaginary number.", "tokens": [51254, 509, 393, 380, 11441, 364, 26164, 1230, 13, 51321], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 575, "seek": 196252, "start": 1982.16, "end": 1984.56, "text": " So in 1926, Max Bourne proposed a rule.", "tokens": [51347, 407, 294, 1294, 10880, 11, 7402, 35866, 716, 10348, 257, 4978, 13, 51467], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 576, "seek": 196252, "start": 1984.94, "end": 1988.8799999999999, "text": " To find the actual observable probability of an event happening in the physical world,", "tokens": [51486, 1407, 915, 264, 3539, 9951, 712, 8482, 295, 364, 2280, 2737, 294, 264, 4001, 1002, 11, 51683], "temperature": 0.0, "avg_logprob": -0.1399373523259567, "compression_ratio": 1.6369863013698631, "no_speech_prob": 1.427149956371998e-12}, {"id": 577, "seek": 198888, "start": 1988.88, "end": 1993.3200000000002, "text": " you take that complex quantum amplitude and you square its absolute value.", "tokens": [50365, 291, 747, 300, 3997, 13018, 27433, 293, 291, 3732, 1080, 8236, 2158, 13, 50587], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 578, "seek": 198888, "start": 1993.48, "end": 1993.96, "text": " It's modulus.", "tokens": [50595, 467, 311, 42287, 13, 50619], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 579, "seek": 198888, "start": 1994.3200000000002, "end": 1998.18, "text": " The result is a normal positive real number between zero and one, a probability.", "tokens": [50637, 440, 1874, 307, 257, 2710, 3353, 957, 1230, 1296, 4018, 293, 472, 11, 257, 8482, 13, 50830], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 580, "seek": 198888, "start": 1998.64, "end": 2003.88, "text": " And for a century, physicists have treated that rule squaring the amplitude as an irreducible", "tokens": [50853, 400, 337, 257, 4901, 11, 48716, 362, 8668, 300, 4978, 2339, 1921, 264, 27433, 382, 364, 16014, 769, 32128, 51115], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 581, "seek": 198888, "start": 2003.88, "end": 2005.96, "text": " fundamental law of nature.", "tokens": [51115, 8088, 2101, 295, 3687, 13, 51219], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 582, "seek": 198888, "start": 2006.2600000000002, "end": 2008.0400000000002, "text": " It's just what the universe does.", "tokens": [51234, 467, 311, 445, 437, 264, 6445, 775, 13, 51323], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 583, "seek": 198888, "start": 2008.7, "end": 2011.3000000000002, "text": " But Fliction's paper argues it is not fundamental.", "tokens": [51356, 583, 3235, 4105, 311, 3035, 38218, 309, 307, 406, 8088, 13, 51486], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 584, "seek": 198888, "start": 2011.5800000000002, "end": 2016.2800000000002, "text": " It argues the Bourne rule is a derived quantity, a coarse graining theorem.", "tokens": [51500, 467, 38218, 264, 35866, 716, 4978, 307, 257, 18949, 11275, 11, 257, 39312, 1295, 1760, 20904, 13, 51735], "temperature": 0.0, "avg_logprob": -0.14464713431693413, "compression_ratio": 1.64, "no_speech_prob": 1.8042215941746487e-12}, {"id": 585, "seek": 201628, "start": 2016.28, "end": 2017.2, "text": " It's a filter.", "tokens": [50365, 467, 311, 257, 6608, 13, 50411], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 586, "seek": 201628, "start": 2018.0, "end": 2018.96, "text": " Okay, let's break this down.", "tokens": [50451, 1033, 11, 718, 311, 1821, 341, 760, 13, 50499], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 587, "seek": 201628, "start": 2019.28, "end": 2023.1, "text": " The paper introduces Tristan Needham's geometric view of complex numbers.", "tokens": [50515, 440, 3035, 31472, 1765, 7559, 16984, 4822, 311, 33246, 1910, 295, 3997, 3547, 13, 50706], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 588, "seek": 201628, "start": 2023.6, "end": 2028.42, "text": " Now, I always learned in high school math that an imaginary number, it was just a mathematical", "tokens": [50731, 823, 11, 286, 1009, 3264, 294, 1090, 1395, 5221, 300, 364, 26164, 1230, 11, 309, 390, 445, 257, 18894, 50972], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 589, "seek": 201628, "start": 2028.42, "end": 2032.42, "text": " trick, a placeholder, because you can't actually take the square root of a negative number.", "tokens": [50972, 4282, 11, 257, 1081, 20480, 11, 570, 291, 393, 380, 767, 747, 264, 3732, 5593, 295, 257, 3671, 1230, 13, 51172], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 590, "seek": 201628, "start": 2032.8, "end": 2035.3799999999999, "text": " But Needham says it's not just a quantity, it's an action.", "tokens": [51191, 583, 16984, 4822, 1619, 309, 311, 406, 445, 257, 11275, 11, 309, 311, 364, 3069, 13, 51320], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 591, "seek": 201628, "start": 2035.8, "end": 2036.36, "text": " What does that mean?", "tokens": [51341, 708, 775, 300, 914, 30, 51369], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 592, "seek": 201628, "start": 2036.8999999999999, "end": 2040.92, "text": " Tristan Needham wrote a seminal, beautiful book called Visual Complex Analysis.", "tokens": [51396, 1765, 7559, 16984, 4822, 4114, 257, 4361, 2071, 11, 2238, 1446, 1219, 23187, 41184, 38172, 13, 51597], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 593, "seek": 201628, "start": 2041.24, "end": 2043.92, "text": " His core argument is that we teach complex numbers terribly.", "tokens": [51613, 2812, 4965, 6770, 307, 300, 321, 2924, 3997, 3547, 22903, 13, 51747], "temperature": 0.0, "avg_logprob": -0.14721725236124067, "compression_ratio": 1.6355140186915889, "no_speech_prob": 1.7760887162029948e-12}, {"id": 594, "seek": 204392, "start": 2043.92, "end": 2047.54, "text": " A complex number is not just a point on a two-dimensional graph.", "tokens": [50365, 316, 3997, 1230, 307, 406, 445, 257, 935, 322, 257, 732, 12, 18759, 4295, 13, 50546], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 595, "seek": 204392, "start": 2047.66, "end": 2048.58, "text": " It is an operation.", "tokens": [50552, 467, 307, 364, 6916, 13, 50598], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 596, "seek": 204392, "start": 2049.0, "end": 2050.64, "text": " It's an active geometric command.", "tokens": [50619, 467, 311, 364, 4967, 33246, 5622, 13, 50701], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 597, "seek": 204392, "start": 2050.86, "end": 2054.86, "text": " When you multiply something by a complex number, you are doing two things simultaneously.", "tokens": [50712, 1133, 291, 12972, 746, 538, 257, 3997, 1230, 11, 291, 366, 884, 732, 721, 16561, 13, 50912], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 598, "seek": 204392, "start": 2055.38, "end": 2060.0, "text": " You are scaling its magnitude stretching or shrinking it, and you are rotating it by", "tokens": [50938, 509, 366, 21589, 1080, 15668, 19632, 420, 41684, 309, 11, 293, 291, 366, 19627, 309, 538, 51169], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 599, "seek": 204392, "start": 2060.0, "end": 2061.58, "text": " a specific angle of phase.", "tokens": [51169, 257, 2685, 5802, 295, 5574, 13, 51248], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 600, "seek": 204392, "start": 2061.7400000000002, "end": 2063.9, "text": " So the imaginary unit isn't just a fake number.", "tokens": [51256, 407, 264, 26164, 4985, 1943, 380, 445, 257, 7592, 1230, 13, 51364], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 601, "seek": 204392, "start": 2064.3, "end": 2064.54, "text": " No.", "tokens": [51384, 883, 13, 51396], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 602, "seek": 204392, "start": 2064.98, "end": 2070.9, "text": " The imaginary unit I is literally a geometric command to execute a quarter turn, a 90-degree", "tokens": [51418, 440, 26164, 4985, 286, 307, 3736, 257, 33246, 5622, 281, 14483, 257, 6555, 1261, 11, 257, 4289, 12, 34368, 51714], "temperature": 0.0, "avg_logprob": -0.12157533107659756, "compression_ratio": 1.7032967032967032, "no_speech_prob": 1.3406771352808544e-12}, {"id": 603, "seek": 207090, "start": 2070.9, "end": 2072.64, "text": " rotation in the mathematical space.", "tokens": [50365, 12447, 294, 264, 18894, 1901, 13, 50452], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 604, "seek": 207090, "start": 2073.28, "end": 2075.76, "text": " A complex number is a packet of instructions.", "tokens": [50484, 316, 3997, 1230, 307, 257, 20300, 295, 9415, 13, 50608], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 605, "seek": 207090, "start": 2076.48, "end": 2079.7200000000003, "text": " Stretch the vector by this much, and rotate it by this angle.", "tokens": [50644, 38817, 264, 8062, 538, 341, 709, 11, 293, 13121, 309, 538, 341, 5802, 13, 50806], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 606, "seek": 207090, "start": 2079.7200000000003, "end": 2085.6, "text": " Okay, so the quantum state inside the admissibility manifold is full of these complex numbers, meaning", "tokens": [50806, 1033, 11, 370, 264, 13018, 1785, 1854, 264, 5910, 891, 2841, 47138, 307, 1577, 295, 613, 3997, 3547, 11, 3620, 51100], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 607, "seek": 207090, "start": 2085.6, "end": 2089.52, "text": " it's full of dynamic geometric constructions, phases, rotations, twistings.", "tokens": [51100, 309, 311, 1577, 295, 8546, 33246, 7690, 626, 11, 18764, 11, 44796, 11, 8203, 1109, 13, 51296], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 608, "seek": 207090, "start": 2090.2400000000002, "end": 2093.9, "text": " What happens when you apply the Born rule to that geometry?", "tokens": [51332, 708, 2314, 562, 291, 3079, 264, 29808, 4978, 281, 300, 18426, 30, 51515], "temperature": 0.0, "avg_logprob": -0.16292028112725898, "compression_ratio": 1.625531914893617, "no_speech_prob": 1.3617945746752236e-12}, {"id": 609, "seek": 209390, "start": 2093.9, "end": 2097.54, "text": " What actually happens when you mathematically take the modulus squared?", "tokens": [50365, 708, 767, 2314, 562, 291, 44003, 747, 264, 42287, 8889, 30, 50547], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 610, "seek": 209390, "start": 2098.12, "end": 2101.76, "text": " Mathematically, when you take the modulus squared of a complex number, you are extracting", "tokens": [50576, 15776, 40197, 11, 562, 291, 747, 264, 42287, 8889, 295, 257, 3997, 1230, 11, 291, 366, 49844, 50758], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 611, "seek": 209390, "start": 2101.76, "end": 2106.38, "text": " the length of the vector, squaring it, and crucially, you are entirely discarding the", "tokens": [50758, 264, 4641, 295, 264, 8062, 11, 2339, 1921, 309, 11, 293, 5140, 1909, 11, 291, 366, 7696, 31597, 278, 264, 50989], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 612, "seek": 209390, "start": 2106.38, "end": 2106.6600000000003, "text": " angle.", "tokens": [50989, 5802, 13, 51003], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 613, "seek": 209390, "start": 2106.82, "end": 2109.28, "text": " You are completely throwing away the rotation, the phase.", "tokens": [51011, 509, 366, 2584, 10238, 1314, 264, 12447, 11, 264, 5574, 13, 51134], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 614, "seek": 209390, "start": 2109.38, "end": 2112.02, "text": " You are literally deleting geometric data from the unit.", "tokens": [51139, 509, 366, 3736, 48946, 33246, 1412, 490, 264, 4985, 13, 51271], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 615, "seek": 209390, "start": 2112.04, "end": 2113.2200000000003, "text": " You are deleting the geometry.", "tokens": [51272, 509, 366, 48946, 264, 18426, 13, 51331], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 616, "seek": 209390, "start": 2113.92, "end": 2116.14, "text": " The Born rule is not a fundamental act of creation.", "tokens": [51366, 440, 29808, 4978, 307, 406, 257, 8088, 605, 295, 8016, 13, 51477], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 617, "seek": 209390, "start": 2116.56, "end": 2119.02, "text": " It is an operation of discarding geometric information.", "tokens": [51498, 467, 307, 364, 6916, 295, 31597, 278, 33246, 1589, 13, 51621], "temperature": 0.0, "avg_logprob": -0.12552737381498694, "compression_ratio": 1.8814814814814815, "no_speech_prob": 1.6426264645361122e-12}, {"id": 618, "seek": 211902, "start": 2119.02, "end": 2124.2, "text": " This connects to a deeply rigorous framework developed by Harvard physicist Jacob Brandes", "tokens": [50365, 639, 16967, 281, 257, 8760, 29882, 8388, 4743, 538, 13378, 42466, 14117, 11119, 279, 50624], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 619, "seek": 211902, "start": 2124.2, "end": 2128.88, "text": " called the RSVP framework and the mathematics of in the stochastic matrices.", "tokens": [50624, 1219, 264, 25855, 53, 47, 8388, 293, 264, 18666, 295, 294, 264, 342, 8997, 2750, 32284, 13, 50858], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 620, "seek": 211902, "start": 2129.4, "end": 2131.12, "text": " Let's dig into the RSVP framework.", "tokens": [50884, 961, 311, 2528, 666, 264, 25855, 53, 47, 8388, 13, 50970], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 621, "seek": 211902, "start": 2131.44, "end": 2132.44, "text": " What is coarse graining?", "tokens": [50986, 708, 307, 39312, 1295, 1760, 30, 51036], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 622, "seek": 211902, "start": 2132.68, "end": 2137.94, "text": " Without getting bogged down in the impenetrable equations, coarse graining is a concept from statistical", "tokens": [51048, 9129, 1242, 26132, 3004, 760, 294, 264, 704, 268, 302, 424, 638, 11787, 11, 39312, 1295, 1760, 307, 257, 3410, 490, 22820, 51311], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 623, "seek": 211902, "start": 2137.94, "end": 2138.48, "text": " mechanics.", "tokens": [51311, 12939, 13, 51338], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 624, "seek": 211902, "start": 2139.2599999999998, "end": 2140.66, "text": " Think about a box of gas.", "tokens": [51377, 6557, 466, 257, 2424, 295, 4211, 13, 51447], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 625, "seek": 211902, "start": 2141.1, "end": 2146.86, "text": " You could mathematically track the exact position and velocity of all 10 trillion individual gas", "tokens": [51469, 509, 727, 44003, 2837, 264, 1900, 2535, 293, 9269, 295, 439, 1266, 18723, 2609, 4211, 51757], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 626, "seek": 211902, "start": 2146.86, "end": 2147.88, "text": " molecules inside.", "tokens": [51757, 13093, 1854, 13, 51808], "temperature": 0.0, "avg_logprob": -0.15630475405989022, "compression_ratio": 1.6262626262626263, "no_speech_prob": 2.697809857454825e-12}, {"id": 627, "seek": 214788, "start": 2147.88, "end": 2149.46, "text": " That's the fine-grained view.", "tokens": [50365, 663, 311, 264, 2489, 12, 20735, 2001, 1910, 13, 50444], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 628, "seek": 214788, "start": 2150.04, "end": 2153.56, "text": " Or you could just measure the average temperature and pressure of the box.", "tokens": [50473, 1610, 291, 727, 445, 3481, 264, 4274, 4292, 293, 3321, 295, 264, 2424, 13, 50649], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 629, "seek": 214788, "start": 2153.92, "end": 2155.52, "text": " That is the coarse-grained view.", "tokens": [50667, 663, 307, 264, 39312, 12, 20735, 2001, 1910, 13, 50747], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 630, "seek": 214788, "start": 2156.08, "end": 2161.62, "text": " You throw away the specific data of every single molecule and you integrate over them", "tokens": [50775, 509, 3507, 1314, 264, 2685, 1412, 295, 633, 2167, 15582, 293, 291, 13365, 670, 552, 51052], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 631, "seek": 214788, "start": 2161.62, "end": 2163.98, "text": " to get a simplified observable macro state.", "tokens": [51052, 281, 483, 257, 26335, 9951, 712, 18887, 1785, 13, 51170], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 632, "seek": 214788, "start": 2164.1400000000003, "end": 2165.06, "text": " You just blur your eyes.", "tokens": [51178, 509, 445, 14257, 428, 2575, 13, 51224], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 633, "seek": 214788, "start": 2165.12, "end": 2165.7200000000003, "text": " You blur your eyes.", "tokens": [51227, 509, 14257, 428, 2575, 13, 51257], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 634, "seek": 214788, "start": 2165.8, "end": 2165.96, "text": " Yeah.", "tokens": [51261, 865, 13, 51269], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 635, "seek": 214788, "start": 2166.32, "end": 2171.1600000000003, "text": " Brandes proved mathematically that quantum probability operates the exact same way.", "tokens": [51287, 11119, 279, 14617, 44003, 300, 13018, 8482, 22577, 264, 1900, 912, 636, 13, 51529], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 636, "seek": 214788, "start": 2171.8, "end": 2174.52, "text": " Probability isn't a fundamental building block of reality.", "tokens": [51561, 8736, 2310, 1943, 380, 257, 8088, 2390, 3461, 295, 4103, 13, 51697], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 637, "seek": 214788, "start": 2175.2000000000003, "end": 2176.78, "text": " Probability is an emergent property.", "tokens": [51731, 8736, 2310, 307, 364, 4345, 6930, 4707, 13, 51810], "temperature": 0.0, "avg_logprob": -0.15538433837890625, "compression_ratio": 1.7659574468085106, "no_speech_prob": 1.7693386903175345e-12}, {"id": 638, "seek": 217678, "start": 2176.78, "end": 2182.0, "text": " It is what is left over after you integrate out or coarse-grained, the unobserved internal", "tokens": [50365, 467, 307, 437, 307, 1411, 670, 934, 291, 13365, 484, 420, 39312, 12, 20735, 2001, 11, 264, 8526, 929, 6913, 6920, 50626], "temperature": 0.0, "avg_logprob": -0.1717362227263274, "compression_ratio": 1.3972602739726028, "no_speech_prob": 1.7147420636187682e-12}, {"id": 639, "seek": 217678, "start": 2182.0, "end": 2183.44, "text": " degrees of freedom of the universe.", "tokens": [50626, 5310, 295, 5645, 295, 264, 6445, 13, 50698], "temperature": 0.0, "avg_logprob": -0.1717362227263274, "compression_ratio": 1.3972602739726028, "no_speech_prob": 1.7147420636187682e-12}, {"id": 640, "seek": 217678, "start": 2183.88, "end": 2187.6200000000003, "text": " The Born rule is just the mathematical equivalent of blurring your eyes.", "tokens": [50720, 440, 29808, 4978, 307, 445, 264, 18894, 10344, 295, 14257, 2937, 428, 2575, 13, 50907], "temperature": 0.0, "avg_logprob": -0.1717362227263274, "compression_ratio": 1.3972602739726028, "no_speech_prob": 1.7147420636187682e-12}, {"id": 641, "seek": 217678, "start": 2187.82, "end": 2188.26, "text": " Wow.", "tokens": [50917, 3153, 13, 50939], "temperature": 0.0, "avg_logprob": -0.1717362227263274, "compression_ratio": 1.3972602739726028, "no_speech_prob": 1.7147420636187682e-12}, {"id": 642, "seek": 218826, "start": 2188.26, "end": 2194.28, "text": " So the universe has all this incredibly complex internal geometric data, the phases, rotations,", "tokens": [50365, 407, 264, 6445, 575, 439, 341, 6252, 3997, 6920, 33246, 1412, 11, 264, 18764, 11, 44796, 11, 50666], "temperature": 0.0, "avg_logprob": -0.19631287545868845, "compression_ratio": 1.2727272727272727, "no_speech_prob": 1.9503537240089797e-12}, {"id": 643, "seek": 218826, "start": 2194.28, "end": 2196.5200000000004, "text": " and twistings in the admissibility manifold.", "tokens": [50666, 293, 8203, 1109, 294, 264, 5910, 891, 2841, 47138, 13, 50778], "temperature": 0.0, "avg_logprob": -0.19631287545868845, "compression_ratio": 1.2727272727272727, "no_speech_prob": 1.9503537240089797e-12}, {"id": 644, "seek": 219652, "start": 2196.52, "end": 2201.86, "text": " And the Born rule, the act of squaring, is just the projection operator denoted by the Greek", "tokens": [50365, 400, 264, 29808, 4978, 11, 264, 605, 295, 2339, 1921, 11, 307, 445, 264, 22743, 12973, 1441, 23325, 538, 264, 10281, 50632], "temperature": 0.0, "avg_logprob": -0.11045137204621967, "compression_ratio": 1.6153846153846154, "no_speech_prob": 2.5630851607783e-12}, {"id": 645, "seek": 219652, "start": 2201.86, "end": 2206.9, "text": " letter pi in the paper mapping that massive internal manifold down to our limited observable", "tokens": [50632, 5063, 3895, 294, 264, 3035, 18350, 300, 5994, 6920, 47138, 760, 281, 527, 5567, 9951, 712, 50884], "temperature": 0.0, "avg_logprob": -0.11045137204621967, "compression_ratio": 1.6153846153846154, "no_speech_prob": 2.5630851607783e-12}, {"id": 646, "seek": 219652, "start": 2206.9, "end": 2207.34, "text": " manifold.", "tokens": [50884, 47138, 13, 50906], "temperature": 0.0, "avg_logprob": -0.11045137204621967, "compression_ratio": 1.6153846153846154, "no_speech_prob": 2.5630851607783e-12}, {"id": 647, "seek": 219652, "start": 2207.82, "end": 2212.94, "text": " The Born rule is literally just the universe throwing away the internal geometric data so", "tokens": [50930, 440, 29808, 4978, 307, 3736, 445, 264, 6445, 10238, 1314, 264, 6920, 33246, 1412, 370, 51186], "temperature": 0.0, "avg_logprob": -0.11045137204621967, "compression_ratio": 1.6153846153846154, "no_speech_prob": 2.5630851607783e-12}, {"id": 648, "seek": 219652, "start": 2212.94, "end": 2215.3, "text": " that we can comprehend it as a simple probability.", "tokens": [51186, 300, 321, 393, 38183, 309, 382, 257, 2199, 8482, 13, 51304], "temperature": 0.0, "avg_logprob": -0.11045137204621967, "compression_ratio": 1.6153846153846154, "no_speech_prob": 2.5630851607783e-12}, {"id": 649, "seek": 221530, "start": 2215.3, "end": 2218.1400000000003, "text": " That is exactly what the math implies.", "tokens": [50365, 663, 307, 2293, 437, 264, 5221, 18779, 13, 50507], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 650, "seek": 221530, "start": 2218.6400000000003, "end": 2223.1400000000003, "text": " And when you apply this to our Crean space from earlier, the space with the ghosts, it solves", "tokens": [50532, 400, 562, 291, 3079, 341, 281, 527, 9549, 282, 1901, 490, 3071, 11, 264, 1901, 365, 264, 21744, 11, 309, 39890, 50757], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 651, "seek": 221530, "start": 2223.1400000000003, "end": 2224.0800000000004, "text": " the puzzle perfectly.", "tokens": [50757, 264, 12805, 6239, 13, 50804], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 652, "seek": 221530, "start": 2224.7400000000002, "end": 2228.8, "text": " The ghosts in the Crean space are associated with hyperbolic rotations in the geometry.", "tokens": [50837, 440, 21744, 294, 264, 9549, 282, 1901, 366, 6615, 365, 9848, 65, 7940, 44796, 294, 264, 18426, 13, 51040], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 653, "seek": 221530, "start": 2229.52, "end": 2233.92, "text": " When you apply the projection operator pi, the squaring operation of the Born rule structurally", "tokens": [51076, 1133, 291, 3079, 264, 22743, 12973, 3895, 11, 264, 2339, 1921, 6916, 295, 264, 29808, 4978, 6594, 6512, 51296], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 654, "seek": 221530, "start": 2233.92, "end": 2236.2000000000003, "text": " throws away those specific hyperbolic rotations.", "tokens": [51296, 19251, 1314, 729, 2685, 9848, 65, 7940, 44796, 13, 51410], "temperature": 0.0, "avg_logprob": -0.1585943076921546, "compression_ratio": 1.751131221719457, "no_speech_prob": 1.6747679632000967e-12}, {"id": 655, "seek": 223620, "start": 2236.2, "end": 2240.2999999999997, "text": " The ghosts are literally just geometric rotations that get discarded in the projection.", "tokens": [50365, 440, 21744, 366, 3736, 445, 33246, 44796, 300, 483, 45469, 294, 264, 22743, 13, 50570], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 656, "seek": 223620, "start": 2240.8399999999997, "end": 2241.62, "text": " They are squared away.", "tokens": [50597, 814, 366, 8889, 1314, 13, 50636], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 657, "seek": 223620, "start": 2241.8399999999997, "end": 2246.3799999999997, "text": " I have a deep philosophical question about this then, because this is honestly unsettling.", "tokens": [50647, 286, 362, 257, 2452, 25066, 1168, 466, 341, 550, 11, 570, 341, 307, 6095, 43964, 1688, 13, 50874], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 658, "seek": 223620, "start": 2247.1, "end": 2252.04, "text": " If the Born rule isn't fundamental, if it's just a coarse graining, a throwing away of", "tokens": [50910, 759, 264, 29808, 4978, 1943, 380, 8088, 11, 498, 309, 311, 445, 257, 39312, 1295, 1760, 11, 257, 10238, 1314, 295, 51157], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 659, "seek": 223620, "start": 2252.04, "end": 2256.16, "text": " data, does that mean quantum mechanics as we experience it is an illusion?", "tokens": [51157, 1412, 11, 775, 300, 914, 13018, 12939, 382, 321, 1752, 309, 307, 364, 18854, 30, 51363], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 660, "seek": 223620, "start": 2256.7999999999997, "end": 2261.98, "text": " Is the randomness of quantum mechanics just an artifact of our inability to see the full", "tokens": [51395, 1119, 264, 4974, 1287, 295, 13018, 12939, 445, 364, 34806, 295, 527, 33162, 281, 536, 264, 1577, 51654], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 661, "seek": 223620, "start": 2261.98, "end": 2263.12, "text": " geometry of the universe?", "tokens": [51654, 18426, 295, 264, 6445, 30, 51711], "temperature": 0.0, "avg_logprob": -0.13550222570245915, "compression_ratio": 1.6426116838487972, "no_speech_prob": 1.920405891600585e-12}, {"id": 662, "seek": 226312, "start": 2263.12, "end": 2267.7799999999997, "text": " This raises a profoundly important question, and fliction leans heavily into it.", "tokens": [50365, 639, 19658, 257, 39954, 1021, 1168, 11, 293, 932, 4105, 476, 599, 10950, 666, 309, 13, 50598], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 663, "seek": 226312, "start": 2268.44, "end": 2271.94, "text": " It suggests that quantum probabilities are, essentially, shadows.", "tokens": [50631, 467, 13409, 300, 13018, 33783, 366, 11, 4476, 11, 14740, 13, 50806], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 664, "seek": 226312, "start": 2272.56, "end": 2273.9, "text": " Let's go back to Plato's cave.", "tokens": [50837, 961, 311, 352, 646, 281, 43027, 311, 11730, 13, 50904], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 665, "seek": 226312, "start": 2274.58, "end": 2280.14, "text": " In the larger internal space, the admissibility manifold, the universe might be entirely deterministic,", "tokens": [50938, 682, 264, 4833, 6920, 1901, 11, 264, 5910, 891, 2841, 47138, 11, 264, 6445, 1062, 312, 7696, 15957, 3142, 11, 51216], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 666, "seek": 226312, "start": 2280.2999999999997, "end": 2284.46, "text": " entirely governed by smooth, complex geometric flows without any randomness at all.", "tokens": [51224, 7696, 35529, 538, 5508, 11, 3997, 33246, 12867, 1553, 604, 4974, 1287, 412, 439, 13, 51432], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 667, "seek": 226312, "start": 2284.5, "end": 2285.54, "text": " But we can't see it.", "tokens": [51434, 583, 321, 393, 380, 536, 309, 13, 51486], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 668, "seek": 226312, "start": 2285.68, "end": 2285.9, "text": " Right.", "tokens": [51493, 1779, 13, 51504], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 669, "seek": 226312, "start": 2286.22, "end": 2290.7999999999997, "text": " Because we humans and our physical measuring instruments only exist in the observable manifold.", "tokens": [51520, 1436, 321, 6255, 293, 527, 4001, 13389, 12190, 787, 2514, 294, 264, 9951, 712, 47138, 13, 51749], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 670, "seek": 226312, "start": 2290.7999999999997, "end": 2292.24, "text": " You're fundamentally restricted.", "tokens": [51749, 509, 434, 17879, 20608, 13, 51821], "temperature": 0.0, "avg_logprob": -0.17969183488325638, "compression_ratio": 1.5770392749244713, "no_speech_prob": 1.7900172446724816e-12}, {"id": 671, "seek": 229224, "start": 2292.24, "end": 2296.58, "text": " We only perceive the flattened, squared, un-shorcastic probabilities.", "tokens": [50365, 492, 787, 20281, 264, 24183, 292, 11, 8889, 11, 517, 12, 82, 2335, 66, 2750, 33783, 13, 50582], "temperature": 0.0, "avg_logprob": -0.21422618144267314, "compression_ratio": 1.5172413793103448, "no_speech_prob": 1.5796931904926703e-12}, {"id": 672, "seek": 229224, "start": 2297.3799999999997, "end": 2299.12, "text": " We see the blurry shadow on the cave wall.", "tokens": [50622, 492, 536, 264, 37644, 8576, 322, 264, 11730, 2929, 13, 50709], "temperature": 0.0, "avg_logprob": -0.21422618144267314, "compression_ratio": 1.5172413793103448, "no_speech_prob": 1.5796931904926703e-12}, {"id": 673, "seek": 229224, "start": 2299.5, "end": 2303.74, "text": " And because we can't predict exactly where the shadow will move next, we invent quantum", "tokens": [50728, 400, 570, 321, 393, 380, 6069, 2293, 689, 264, 8576, 486, 1286, 958, 11, 321, 7962, 13018, 50940], "temperature": 0.0, "avg_logprob": -0.21422618144267314, "compression_ratio": 1.5172413793103448, "no_speech_prob": 1.5796931904926703e-12}, {"id": 674, "seek": 229224, "start": 2303.74, "end": 2304.18, "text": " uncertainty.", "tokens": [50940, 15697, 13, 50962], "temperature": 0.0, "avg_logprob": -0.21422618144267314, "compression_ratio": 1.5172413793103448, "no_speech_prob": 1.5796931904926703e-12}, {"id": 675, "seek": 229224, "start": 2304.52, "end": 2310.3599999999997, "text": " But the object casting the shadow is a perfectly definite, highly complex geometric structure.", "tokens": [50979, 583, 264, 2657, 17301, 264, 8576, 307, 257, 6239, 25131, 11, 5405, 3997, 33246, 3877, 13, 51271], "temperature": 0.0, "avg_logprob": -0.21422618144267314, "compression_ratio": 1.5172413793103448, "no_speech_prob": 1.5796931904926703e-12}, {"id": 676, "seek": 231036, "start": 2310.36, "end": 2314.1800000000003, "text": " We are literally living in the shadow of the admissibility manifold.", "tokens": [50365, 492, 366, 3736, 2647, 294, 264, 8576, 295, 264, 5910, 891, 2841, 47138, 13, 50556], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 677, "seek": 231036, "start": 2314.82, "end": 2319.86, "text": " We are mistaking the blurry limitation of our vision for a fundamental law of physics.", "tokens": [50588, 492, 366, 3544, 2456, 264, 37644, 27432, 295, 527, 5201, 337, 257, 8088, 2101, 295, 10649, 13, 50840], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 678, "seek": 231036, "start": 2320.32, "end": 2325.54, "text": " And if we are fundamentally misunderstanding how quantum probability works, if we've mistaken", "tokens": [50863, 400, 498, 321, 366, 17879, 29227, 577, 13018, 8482, 1985, 11, 498, 321, 600, 21333, 51124], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 679, "seek": 231036, "start": 2325.54, "end": 2329.88, "text": " the shadow for the object, then we might be completely wrong about our ultimate theories", "tokens": [51124, 264, 8576, 337, 264, 2657, 11, 550, 321, 1062, 312, 2584, 2085, 466, 527, 9705, 13667, 51341], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 680, "seek": 231036, "start": 2329.88, "end": 2330.5, "text": " of everything.", "tokens": [51341, 295, 1203, 13, 51372], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 681, "seek": 231036, "start": 2330.5, "end": 2334.92, "text": " Which brings us directly to the implications for the biggest theoretical game in town for", "tokens": [51372, 3013, 5607, 505, 3838, 281, 264, 16602, 337, 264, 3880, 20864, 1216, 294, 3954, 337, 51593], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 682, "seek": 231036, "start": 2334.92, "end": 2335.86, "text": " the last 50 years.", "tokens": [51593, 264, 1036, 2625, 924, 13, 51640], "temperature": 0.0, "avg_logprob": -0.11730612386571299, "compression_ratio": 1.7047970479704797, "no_speech_prob": 2.3337178543803017e-12}, {"id": 683, "seek": 233586, "start": 2335.86, "end": 2338.84, "text": " Yes, the consequences for string theory.", "tokens": [50365, 1079, 11, 264, 10098, 337, 6798, 5261, 13, 50514], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 684, "seek": 233586, "start": 2338.84, "end": 2342.2200000000003, "text": " Let's explore Fliction's derived interface conjecture.", "tokens": [50514, 961, 311, 6839, 3235, 4105, 311, 18949, 9226, 416, 1020, 540, 13, 50683], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 685, "seek": 233586, "start": 2342.7400000000002, "end": 2347.6400000000003, "text": " If quantum mechanics and general relativity are just shadows, what are they shadows of?", "tokens": [50709, 759, 13018, 12939, 293, 2674, 45675, 366, 445, 14740, 11, 437, 366, 436, 14740, 295, 30, 50954], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 686, "seek": 233586, "start": 2347.7200000000003, "end": 2348.96, "text": " What is an interface theory?", "tokens": [50958, 708, 307, 364, 9226, 5261, 30, 51020], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 687, "seek": 233586, "start": 2349.38, "end": 2354.2400000000002, "text": " The conjecture states that observable space-time theories are not fundamental descriptions of", "tokens": [51041, 440, 416, 1020, 540, 4368, 300, 9951, 712, 1901, 12, 3766, 13667, 366, 406, 8088, 24406, 295, 51284], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 688, "seek": 233586, "start": 2354.2400000000002, "end": 2354.6800000000003, "text": " reality.", "tokens": [51284, 4103, 13, 51306], "temperature": 0.0, "avg_logprob": -0.22763150533040363, "compression_ratio": 1.507177033492823, "no_speech_prob": 1.432726008145091e-12}, {"id": 689, "seek": 235468, "start": 2354.68, "end": 2357.98, "text": " They are effective interfaces generated by projection.", "tokens": [50365, 814, 366, 4942, 28416, 10833, 538, 22743, 13, 50530], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 690, "seek": 235468, "start": 2358.58, "end": 2359.8199999999997, "text": " Think of a computer interface.", "tokens": [50560, 6557, 295, 257, 3820, 9226, 13, 50622], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 691, "seek": 235468, "start": 2360.2599999999998, "end": 2363.3399999999997, "text": " When you use your laptop, you click on a folder icon on your desktop.", "tokens": [50644, 1133, 291, 764, 428, 10732, 11, 291, 2052, 322, 257, 10820, 6528, 322, 428, 14502, 13, 50798], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 692, "seek": 235468, "start": 2363.8399999999997, "end": 2365.3799999999997, "text": " That folder icon isn't real.", "tokens": [50823, 663, 10820, 6528, 1943, 380, 957, 13, 50900], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 693, "seek": 235468, "start": 2365.74, "end": 2372.6, "text": " The actual reality of the computer is billions of microscopic silicon transistors firing electrical", "tokens": [50918, 440, 3539, 4103, 295, 264, 3820, 307, 17375, 295, 47897, 22848, 1145, 46976, 16045, 12147, 51261], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 694, "seek": 235468, "start": 2372.6, "end": 2374.54, "text": " voltages on and off inside the CPU.", "tokens": [51261, 49614, 322, 293, 766, 1854, 264, 13199, 13, 51358], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 695, "seek": 235468, "start": 2375.44, "end": 2379.3799999999997, "text": " But you couldn't possibly comprehend or interact with a billion voltages a second.", "tokens": [51403, 583, 291, 2809, 380, 6264, 38183, 420, 4648, 365, 257, 5218, 49614, 257, 1150, 13, 51600], "temperature": 0.0, "avg_logprob": -0.17167769421587933, "compression_ratio": 1.6584362139917694, "no_speech_prob": 1.898265182195824e-12}, {"id": 696, "seek": 237938, "start": 2379.38, "end": 2385.36, "text": " So the operating system projects a simplified, coarse-grained interface, a desktop, that allows", "tokens": [50365, 407, 264, 7447, 1185, 4455, 257, 26335, 11, 39312, 12, 20735, 2001, 9226, 11, 257, 14502, 11, 300, 4045, 50664], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 697, "seek": 237938, "start": 2385.36, "end": 2387.78, "text": " you to interact with the underlying system efficiently.", "tokens": [50664, 291, 281, 4648, 365, 264, 14217, 1185, 19621, 13, 50785], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 698, "seek": 237938, "start": 2388.38, "end": 2392.82, "text": " So you're saying Einstein's general relativity, the crowning achievement of 20th century physics,", "tokens": [50815, 407, 291, 434, 1566, 23486, 311, 2674, 45675, 11, 264, 11841, 278, 15838, 295, 945, 392, 4901, 10649, 11, 51037], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 699, "seek": 237938, "start": 2393.1, "end": 2394.96, "text": " is just the desktop icon?", "tokens": [51051, 307, 445, 264, 14502, 6528, 30, 51144], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 700, "seek": 237938, "start": 2395.52, "end": 2396.76, "text": " In this framework, yes.", "tokens": [51172, 682, 341, 8388, 11, 2086, 13, 51234], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 701, "seek": 237938, "start": 2397.44, "end": 2399.32, "text": " General relativity is the first-order interface.", "tokens": [51268, 6996, 45675, 307, 264, 700, 12, 4687, 9226, 13, 51362], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 702, "seek": 237938, "start": 2399.7000000000003, "end": 2402.46, "text": " It's the simplest, lowest-resolution description of the projection.", "tokens": [51381, 467, 311, 264, 22811, 11, 12437, 12, 495, 3386, 3855, 295, 264, 22743, 13, 51519], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 703, "seek": 237938, "start": 2403.2000000000003, "end": 2407.34, "text": " Quadratic gravity-stellars theory with the extra-squared terms is the second-order interface.", "tokens": [51556, 29619, 25198, 12110, 12, 17816, 685, 5261, 365, 264, 2857, 12, 33292, 1642, 2115, 307, 264, 1150, 12, 4687, 9226, 13, 51763], "temperature": 0.0, "avg_logprob": -0.1896947908007409, "compression_ratio": 1.6943521594684385, "no_speech_prob": 1.4725771600374027e-12}, {"id": 704, "seek": 240734, "start": 2407.34, "end": 2410.5, "text": " It's a slightly higher-resolution look at the underlying code.", "tokens": [50365, 467, 311, 257, 4748, 2946, 12, 495, 3386, 574, 412, 264, 14217, 3089, 13, 50523], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 705, "seek": 240734, "start": 2410.92, "end": 2415.2000000000003, "text": " And spacetime curvature itself, the bending of space that we feel is gravity, is not a", "tokens": [50544, 400, 39404, 9764, 37638, 2564, 11, 264, 22487, 295, 1901, 300, 321, 841, 307, 12110, 11, 307, 406, 257, 50758], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 706, "seek": 240734, "start": 2415.2000000000003, "end": 2415.94, "text": " fundamental field.", "tokens": [50758, 8088, 2519, 13, 50795], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 707, "seek": 240734, "start": 2416.36, "end": 2420.04, "text": " It is just the shadow of the projection pi feeling to be perfectly flat.", "tokens": [50816, 467, 307, 445, 264, 8576, 295, 264, 22743, 3895, 2633, 281, 312, 6239, 4962, 13, 51000], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 708, "seek": 240734, "start": 2420.78, "end": 2425.2400000000002, "text": " Curvature is the physical manifestation of the geometric obstruction between the complex", "tokens": [51037, 7907, 85, 1503, 307, 264, 4001, 29550, 295, 264, 33246, 49711, 1296, 264, 3997, 51260], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 709, "seek": 240734, "start": 2425.2400000000002, "end": 2428.56, "text": " internal manifold and our limited observable reality.", "tokens": [51260, 6920, 47138, 293, 527, 5567, 9951, 712, 4103, 13, 51426], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 710, "seek": 240734, "start": 2428.84, "end": 2433.46, "text": " Okay, if this interface theory is true, what does this mean for string theory?", "tokens": [51440, 1033, 11, 498, 341, 9226, 5261, 307, 2074, 11, 437, 775, 341, 914, 337, 6798, 5261, 30, 51671], "temperature": 0.0, "avg_logprob": -0.13844687025123667, "compression_ratio": 1.6535714285714285, "no_speech_prob": 1.5489105224114619e-12}, {"id": 711, "seek": 243346, "start": 2433.46, "end": 2439.16, "text": " Because physicists have spent half a century telling the public that to unite quantum mechanics", "tokens": [50365, 1436, 48716, 362, 4418, 1922, 257, 4901, 3585, 264, 1908, 300, 281, 29320, 13018, 12939, 50650], "temperature": 0.0, "avg_logprob": -0.09046383758089435, "compression_ratio": 1.4752475247524752, "no_speech_prob": 1.9659363113128103e-12}, {"id": 712, "seek": 243346, "start": 2439.16, "end": 2445.78, "text": " and gravity, we must abandon point particles, embrace tiny vibrating strings, and accept that", "tokens": [50650, 293, 12110, 11, 321, 1633, 9072, 935, 10007, 11, 14038, 5870, 47748, 13985, 11, 293, 3241, 300, 50981], "temperature": 0.0, "avg_logprob": -0.09046383758089435, "compression_ratio": 1.4752475247524752, "no_speech_prob": 1.9659363113128103e-12}, {"id": 713, "seek": 243346, "start": 2445.78, "end": 2452.42, "text": " the universe secretly has 10, or maybe 26, spatial dimensions that are curled up so small", "tokens": [50981, 264, 6445, 22611, 575, 1266, 11, 420, 1310, 7551, 11, 23598, 12819, 300, 366, 1262, 1493, 493, 370, 1359, 51313], "temperature": 0.0, "avg_logprob": -0.09046383758089435, "compression_ratio": 1.4752475247524752, "no_speech_prob": 1.9659363113128103e-12}, {"id": 714, "seek": 243346, "start": 2452.42, "end": 2453.26, "text": " we can't see them.", "tokens": [51313, 321, 393, 380, 536, 552, 13, 51355], "temperature": 0.0, "avg_logprob": -0.09046383758089435, "compression_ratio": 1.4752475247524752, "no_speech_prob": 1.9659363113128103e-12}, {"id": 715, "seek": 245326, "start": 2453.26, "end": 2457.7200000000003, "text": " This is where Turok's critique becomes utterly devastating to the orthodoxy.", "tokens": [50365, 639, 307, 689, 314, 7052, 74, 311, 25673, 3643, 30251, 21280, 281, 264, 19052, 22189, 88, 13, 50588], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 716, "seek": 245326, "start": 2458.44, "end": 2461.86, "text": " Why did string theory need 10 or 26 dimensions in the first place?", "tokens": [50624, 1545, 630, 6798, 5261, 643, 1266, 420, 7551, 12819, 294, 264, 700, 1081, 30, 50795], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 717, "seek": 245326, "start": 2462.1800000000003, "end": 2464.6000000000004, "text": " Have you ever wondered why they picked those specific numbers?", "tokens": [50811, 3560, 291, 1562, 17055, 983, 436, 6183, 729, 2685, 3547, 30, 50932], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 718, "seek": 245326, "start": 2464.84, "end": 2469.0400000000004, "text": " I mean, I always assumed it was just where the math naturally led them to solve gravity.", "tokens": [50944, 286, 914, 11, 286, 1009, 15895, 309, 390, 445, 689, 264, 5221, 8195, 4684, 552, 281, 5039, 12110, 13, 51154], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 719, "seek": 245326, "start": 2469.2200000000003, "end": 2471.7200000000003, "text": " It was where the math led them, because of the Hilbert assumption.", "tokens": [51163, 467, 390, 689, 264, 5221, 4684, 552, 11, 570, 295, 264, 19914, 4290, 15302, 13, 51288], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 720, "seek": 245326, "start": 2472.26, "end": 2476.2400000000002, "text": " When string theorists in the 70s and 80s tried to quantize the relativistic string,", "tokens": [51315, 1133, 6798, 27423, 1751, 294, 264, 5285, 82, 293, 4688, 82, 3031, 281, 4426, 1125, 264, 21960, 3142, 6798, 11, 51514], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 721, "seek": 245326, "start": 2476.6200000000003, "end": 2480.1400000000003, "text": " they found that mathematical anomalies, specifically the conformal anomaly,", "tokens": [51533, 436, 1352, 300, 18894, 24769, 48872, 11, 4682, 264, 18975, 304, 42737, 11, 51709], "temperature": 0.0, "avg_logprob": -0.10929553985595702, "compression_ratio": 1.6893203883495145, "no_speech_prob": 1.4327257913046565e-12}, {"id": 722, "seek": 248014, "start": 2480.14, "end": 2483.44, "text": " kept generating negative norm states, ghosts.", "tokens": [50365, 4305, 17746, 3671, 2026, 4368, 11, 21744, 13, 50530], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 723, "seek": 248014, "start": 2484.16, "end": 2488.06, "text": " The internal mathematical space was naturally trying to be a Kreen space.", "tokens": [50566, 440, 6920, 18894, 1901, 390, 8195, 1382, 281, 312, 257, 591, 1492, 1901, 13, 50761], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 724, "seek": 248014, "start": 2488.2, "end": 2488.8199999999997, "text": " Oh, wow.", "tokens": [50768, 876, 11, 6076, 13, 50799], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 725, "seek": 248014, "start": 2488.92, "end": 2489.18, "text": " Right.", "tokens": [50804, 1779, 13, 50817], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 726, "seek": 248014, "start": 2489.48, "end": 2494.08, "text": " But because the physicists were philosophically terrified of negative probabilities,", "tokens": [50832, 583, 570, 264, 48716, 645, 14529, 984, 23051, 295, 3671, 33783, 11, 51062], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 727, "seek": 248014, "start": 2494.6, "end": 2497.68, "text": " they demanded a mathematical trick to kill the ghosts.", "tokens": [51088, 436, 28276, 257, 18894, 4282, 281, 1961, 264, 21744, 13, 51242], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 728, "seek": 248014, "start": 2498.18, "end": 2503.06, "text": " They discovered that if you artificially force the universe to have exactly 26 dimensions", "tokens": [51267, 814, 6941, 300, 498, 291, 39905, 2270, 3464, 264, 6445, 281, 362, 2293, 7551, 12819, 51511], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 729, "seek": 248014, "start": 2503.06, "end": 2507.18, "text": " for bosonic strings, or exactly 10 dimensions if you add supersymmetry,", "tokens": [51511, 337, 30641, 11630, 13985, 11, 420, 2293, 1266, 12819, 498, 291, 909, 37906, 32497, 9889, 11, 51717], "temperature": 0.0, "avg_logprob": -0.22035959031846789, "compression_ratio": 1.6367041198501873, "no_speech_prob": 2.236410926240162e-12}, {"id": 730, "seek": 250718, "start": 2507.18, "end": 2513.18, "text": " the math perfectly cancels the conformal anomaly and completely deletes the negative norm states.", "tokens": [50365, 264, 5221, 6239, 393, 66, 1625, 264, 18975, 304, 42737, 293, 2584, 1103, 37996, 264, 3671, 2026, 4368, 13, 50665], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 731, "seek": 250718, "start": 2513.3199999999997, "end": 2513.8399999999997, "text": " Wait, wait, wait.", "tokens": [50672, 3802, 11, 1699, 11, 1699, 13, 50698], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 732, "seek": 250718, "start": 2514.14, "end": 2515.56, "text": " Let me get this absolutely straight.", "tokens": [50713, 961, 385, 483, 341, 3122, 2997, 13, 50784], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 733, "seek": 250718, "start": 2515.7999999999997, "end": 2519.94, "text": " Are you telling me we spent 50 years looking for 11 dimensions because we simply refused", "tokens": [50796, 2014, 291, 3585, 385, 321, 4418, 2625, 924, 1237, 337, 2975, 12819, 570, 321, 2935, 14654, 51003], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 734, "seek": 250718, "start": 2519.94, "end": 2522.14, "text": " to let our math have negative numbers in the internal ledger?", "tokens": [51003, 281, 718, 527, 5221, 362, 3671, 3547, 294, 264, 6920, 4684, 1321, 30, 51113], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 735, "seek": 250718, "start": 2522.2799999999997, "end": 2528.2799999999997, "text": " We built a massive, untestable theoretical multiverse just to satisfy a philosophical accounting preference.", "tokens": [51120, 492, 3094, 257, 5994, 11, 1701, 377, 712, 20864, 2120, 5376, 445, 281, 19319, 257, 25066, 19163, 17502, 13, 51420], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 736, "seek": 250718, "start": 2528.7, "end": 2530.72, "text": " That is exactly what this paper is alleging.", "tokens": [51441, 663, 307, 2293, 437, 341, 3035, 307, 10364, 278, 13, 51542], "temperature": 0.0, "avg_logprob": -0.1237845240898852, "compression_ratio": 1.6091549295774648, "no_speech_prob": 1.714887671970533e-12}, {"id": 737, "seek": 253072, "start": 2530.72, "end": 2535.8399999999997, "text": " The entire foundational necessity of string theory was built on the absolute demand", "tokens": [50365, 440, 2302, 32195, 24217, 295, 6798, 5261, 390, 3094, 322, 264, 8236, 4733, 50621], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 738, "seek": 253072, "start": 2535.8399999999997, "end": 2538.56, "text": " to maintain a stripped Hilbert space internally.", "tokens": [50621, 281, 6909, 257, 33221, 19914, 4290, 1901, 19501, 13, 50757], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 739, "seek": 253072, "start": 2539.2599999999998, "end": 2543.68, "text": " If you drop the Hilbert assumption, if you allow the internal ledger to be a Kreen space", "tokens": [50792, 759, 291, 3270, 264, 19914, 4290, 15302, 11, 498, 291, 2089, 264, 6920, 4684, 1321, 281, 312, 257, 591, 1492, 1901, 51013], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 740, "seek": 253072, "start": 2543.68, "end": 2546.8399999999997, "text": " and trust the projection operator to balance the books at the ATM,", "tokens": [51013, 293, 3361, 264, 22743, 12973, 281, 4772, 264, 3642, 412, 264, 46455, 11, 51171], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 741, "seek": 253072, "start": 2547.2799999999997, "end": 2549.74, "text": " the necessity for extra dimensions simply vanishes.", "tokens": [51193, 264, 24217, 337, 2857, 12819, 2935, 3161, 16423, 13, 51316], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 742, "seek": 253072, "start": 2550.58, "end": 2554.2, "text": " You no longer need 10 dimensions to make quantum gravity mathematically consistent.", "tokens": [51358, 509, 572, 2854, 643, 1266, 12819, 281, 652, 13018, 12110, 44003, 8398, 13, 51539], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 743, "seek": 253072, "start": 2554.64, "end": 2557.22, "text": " Quadratic gravity, acting as an interface theory,", "tokens": [51561, 29619, 25198, 12110, 11, 6577, 382, 364, 9226, 5261, 11, 51690], "temperature": 0.0, "avg_logprob": -0.12275656370016244, "compression_ratio": 1.6690140845070423, "no_speech_prob": 2.0442631962214186e-12}, {"id": 744, "seek": 255722, "start": 2557.22, "end": 2560.3399999999997, "text": " can do it in our standard observable four dimensions.", "tokens": [50365, 393, 360, 309, 294, 527, 3832, 9951, 712, 1451, 12819, 13, 50521], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 745, "seek": 255722, "start": 2560.9599999999996, "end": 2561.4399999999996, "text": " But how?", "tokens": [50552, 583, 577, 30, 50576], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 746, "seek": 255722, "start": 2561.72, "end": 2565.56, "text": " The whole point of string theory was to smear out the point-like nature of particles", "tokens": [50590, 440, 1379, 935, 295, 6798, 5261, 390, 281, 899, 14881, 484, 264, 935, 12, 4092, 3687, 295, 10007, 50782], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 747, "seek": 255722, "start": 2565.56, "end": 2569.8599999999997, "text": " to stop the high-energy interactions from becoming infinitely strong at the Planck scale.", "tokens": [50782, 281, 1590, 264, 1090, 12, 49016, 13280, 490, 5617, 36227, 2068, 412, 264, 8112, 547, 4373, 13, 50997], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 748, "seek": 255722, "start": 2570.2599999999998, "end": 2575.08, "text": " How does quadratic gravity actually work in four dimensions without breaking down when you zoom in?", "tokens": [51017, 1012, 775, 37262, 12110, 767, 589, 294, 1451, 12819, 1553, 7697, 760, 562, 291, 8863, 294, 30, 51258], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 749, "seek": 255722, "start": 2575.3799999999997, "end": 2577.7599999999998, "text": " Because of a property called asymptotic freedom.", "tokens": [51273, 1436, 295, 257, 4707, 1219, 35114, 9411, 5645, 13, 51392], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 750, "seek": 255722, "start": 2578.4199999999996, "end": 2580.54, "text": " This is a well-understood phenomenon in physics.", "tokens": [51425, 639, 307, 257, 731, 12, 6617, 6431, 14029, 294, 10649, 13, 51531], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 751, "seek": 255722, "start": 2581.2, "end": 2583.48, "text": " It behaves very much like the strong nuclear force,", "tokens": [51564, 467, 36896, 588, 709, 411, 264, 2068, 8179, 3464, 11, 51678], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 752, "seek": 255722, "start": 2583.66, "end": 2585.3999999999996, "text": " quantum chromodynamics, or QCD.", "tokens": [51687, 13018, 16209, 35483, 11, 420, 1249, 16508, 13, 51774], "temperature": 0.0, "avg_logprob": -0.16947792422386906, "compression_ratio": 1.5920245398773005, "no_speech_prob": 1.973641736152665e-12}, {"id": 753, "seek": 258540, "start": 2585.4, "end": 2590.84, "text": " In QCD, quarks are bound tightly together at low energies inside protons.", "tokens": [50365, 682, 1249, 16508, 11, 421, 20851, 366, 5472, 21952, 1214, 412, 2295, 25737, 1854, 40270, 13, 50637], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 754, "seek": 258540, "start": 2591.26, "end": 2593.54, "text": " If you try to pull them apart, the force gets stronger.", "tokens": [50658, 759, 291, 853, 281, 2235, 552, 4936, 11, 264, 3464, 2170, 7249, 13, 50772], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 755, "seek": 258540, "start": 2594.1600000000003, "end": 2596.6, "text": " But if you smash them together at ultra-high energies,", "tokens": [50803, 583, 498, 291, 17960, 552, 1214, 412, 14808, 12, 21454, 25737, 11, 50925], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 756, "seek": 258540, "start": 2596.88, "end": 2598.42, "text": " the interaction actually gets weaker.", "tokens": [50939, 264, 9285, 767, 2170, 24286, 13, 51016], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 757, "seek": 258540, "start": 2598.86, "end": 2599.76, "text": " The force shuts down.", "tokens": [51038, 440, 3464, 48590, 760, 13, 51083], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 758, "seek": 258540, "start": 2600.2200000000003, "end": 2601.7400000000002, "text": " The particles act as if they are free.", "tokens": [51106, 440, 10007, 605, 382, 498, 436, 366, 1737, 13, 51182], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 759, "seek": 258540, "start": 2602.2400000000002, "end": 2605.2400000000002, "text": " This is asymptotic freedom, and it won a Nobel Prize.", "tokens": [51207, 639, 307, 35114, 9411, 5645, 11, 293, 309, 1582, 257, 24611, 22604, 13, 51357], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 760, "seek": 258540, "start": 2605.4, "end": 2606.9, "text": " Okay, and gravity does this.", "tokens": [51365, 1033, 11, 293, 12110, 775, 341, 13, 51440], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 761, "seek": 258540, "start": 2607.2000000000003, "end": 2610.3, "text": " A mathematician named Avramidi proved in the 1980s", "tokens": [51455, 316, 48281, 4926, 11667, 2356, 12716, 14617, 294, 264, 13626, 82, 51610], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 762, "seek": 258540, "start": 2610.3, "end": 2613.02, "text": " that quadratic gravity has this exact same property.", "tokens": [51610, 300, 37262, 12110, 575, 341, 1900, 912, 4707, 13, 51746], "temperature": 0.0, "avg_logprob": -0.15973934700818565, "compression_ratio": 1.6262975778546713, "no_speech_prob": 2.028353830382801e-12}, {"id": 763, "seek": 261302, "start": 2613.02, "end": 2615.74, "text": " At everyday energies, gravity is attractive.", "tokens": [50365, 1711, 7429, 25737, 11, 12110, 307, 12609, 13, 50501], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 764, "seek": 261302, "start": 2616.34, "end": 2619.24, "text": " But at ultra-high energies, as you approach the Planck scale,", "tokens": [50531, 583, 412, 14808, 12, 21454, 25737, 11, 382, 291, 3109, 264, 8112, 547, 4373, 11, 50676], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 765, "seek": 261302, "start": 2619.66, "end": 2622.12, "text": " the realm of the Big Bang or the center of a black hole,", "tokens": [50697, 264, 15355, 295, 264, 5429, 11538, 420, 264, 3056, 295, 257, 2211, 5458, 11, 50820], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 766, "seek": 261302, "start": 2622.6, "end": 2624.44, "text": " the gravitational interactions fade away.", "tokens": [50844, 264, 28538, 13280, 21626, 1314, 13, 50936], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 767, "seek": 261302, "start": 2625.0, "end": 2627.22, "text": " The theory becomes arbitrarily weakly coupled.", "tokens": [50964, 440, 5261, 3643, 19071, 3289, 5336, 356, 29482, 13, 51075], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 768, "seek": 261302, "start": 2627.7599999999998, "end": 2631.74, "text": " It becomes UV-complete, meaning mathematically safe at the highest possible energies,", "tokens": [51102, 467, 3643, 17887, 12, 1112, 17220, 11, 3620, 44003, 3273, 412, 264, 6343, 1944, 25737, 11, 51301], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 769, "seek": 261302, "start": 2632.12, "end": 2633.18, "text": " in just four dimensions.", "tokens": [51320, 294, 445, 1451, 12819, 13, 51373], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 770, "seek": 261302, "start": 2633.72, "end": 2636.12, "text": " It doesn't need strings to smear out the infinities,", "tokens": [51400, 467, 1177, 380, 643, 13985, 281, 899, 14881, 484, 264, 7193, 1088, 11, 51520], "temperature": 0.0, "avg_logprob": -0.1667140263777513, "compression_ratio": 1.6124031007751938, "no_speech_prob": 1.314550139748516e-12}, {"id": 771, "seek": 263612, "start": 2636.12, "end": 2638.48, "text": " because the force itself dynamically shuts down.", "tokens": [50365, 570, 264, 3464, 2564, 43492, 48590, 760, 13, 50483], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 772, "seek": 263612, "start": 2638.9, "end": 2639.64, "text": " That is staggering.", "tokens": [50504, 663, 307, 42974, 13, 50541], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 773, "seek": 263612, "start": 2640.08, "end": 2644.2999999999997, "text": " It solves gravity using math we already know works for the strong nuclear force.", "tokens": [50563, 467, 39890, 12110, 1228, 5221, 321, 1217, 458, 1985, 337, 264, 2068, 8179, 3464, 13, 50774], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 774, "seek": 263612, "start": 2644.94, "end": 2648.18, "text": " And does this framework solve any other big problems in the standard model?", "tokens": [50806, 400, 775, 341, 8388, 5039, 604, 661, 955, 2740, 294, 264, 3832, 2316, 30, 50968], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 775, "seek": 263612, "start": 2648.48, "end": 2650.3599999999997, "text": " What about the mass of the Higgs boson?", "tokens": [50983, 708, 466, 264, 2758, 295, 264, 389, 32555, 30641, 266, 30, 51077], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 776, "seek": 263612, "start": 2650.58, "end": 2653.8599999999997, "text": " One of the biggest mysteries right now is the hierarchy problem.", "tokens": [51088, 1485, 295, 264, 3880, 30785, 558, 586, 307, 264, 22333, 1154, 13, 51252], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 777, "seek": 263612, "start": 2654.24, "end": 2658.42, "text": " The fact that the Higgs is billions of times lighter than the math suggests it should be.", "tokens": [51271, 440, 1186, 300, 264, 389, 32555, 307, 17375, 295, 1413, 11546, 813, 264, 5221, 13409, 309, 820, 312, 13, 51480], "temperature": 0.0, "avg_logprob": -0.14344208649914675, "compression_ratio": 1.6216216216216217, "no_speech_prob": 1.6426223445678567e-12}, {"id": 778, "seek": 265842, "start": 2658.42, "end": 2664.16, "text": " Yes. The hierarchy problem is why physicists invented the idea of a multiverse,", "tokens": [50365, 1079, 13, 440, 22333, 1154, 307, 983, 48716, 14479, 264, 1558, 295, 257, 2120, 5376, 11, 50652], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 779, "seek": 265842, "start": 2664.64, "end": 2667.44, "text": " suggesting our universe is just a random, fine-tuned bubble.", "tokens": [50676, 18094, 527, 6445, 307, 445, 257, 4974, 11, 2489, 12, 83, 43703, 12212, 13, 50816], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 780, "seek": 265842, "start": 2667.58, "end": 2667.8, "text": " Yeah.", "tokens": [50823, 865, 13, 50834], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 781, "seek": 265842, "start": 2668.12, "end": 2671.6, "text": " But quadratic gravity addresses the Higgs mass naturally", "tokens": [50850, 583, 37262, 12110, 16862, 264, 389, 32555, 2758, 8195, 51024], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 782, "seek": 265842, "start": 2671.6, "end": 2674.42, "text": " through a mechanism called dimensional transmutation.", "tokens": [51024, 807, 257, 7513, 1219, 18795, 7715, 11380, 13, 51165], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 783, "seek": 265842, "start": 2674.7400000000002, "end": 2676.6, "text": " Okay, explain dimensional transmutation.", "tokens": [51181, 1033, 11, 2903, 18795, 7715, 11380, 13, 51274], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 784, "seek": 265842, "start": 2676.8, "end": 2678.7400000000002, "text": " How do you just generate mass out of thin air?", "tokens": [51284, 1012, 360, 291, 445, 8460, 2758, 484, 295, 5862, 1988, 30, 51381], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 785, "seek": 265842, "start": 2678.96, "end": 2680.8, "text": " In an asymptotically free theory,", "tokens": [51392, 682, 364, 35114, 310, 984, 1737, 5261, 11, 51484], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 786, "seek": 265842, "start": 2681.2000000000003, "end": 2683.86, "text": " you start with a force that has no inherent mass scale.", "tokens": [51504, 291, 722, 365, 257, 3464, 300, 575, 572, 26387, 2758, 4373, 13, 51637], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 787, "seek": 265842, "start": 2684.46, "end": 2687.32, "text": " The coupling constant is dimensionless at the Planck energy.", "tokens": [51667, 440, 37447, 5754, 307, 10139, 1832, 412, 264, 8112, 547, 2281, 13, 51810], "temperature": 0.0, "avg_logprob": -0.15915389888542741, "compression_ratio": 1.6209150326797386, "no_speech_prob": 1.876095633013275e-12}, {"id": 788, "seek": 268732, "start": 2687.32, "end": 2690.32, "text": " But as the universe cools and energy drops,", "tokens": [50365, 583, 382, 264, 6445, 42883, 293, 2281, 11438, 11, 50515], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 789, "seek": 268732, "start": 2690.76, "end": 2694.44, "text": " the quantum interactions cause that coupling strength to change to run.", "tokens": [50537, 264, 13018, 13280, 3082, 300, 37447, 3800, 281, 1319, 281, 1190, 13, 50721], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 790, "seek": 268732, "start": 2695.06, "end": 2696.6400000000003, "text": " Eventually, at a much lower energy,", "tokens": [50752, 17586, 11, 412, 257, 709, 3126, 2281, 11, 50831], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 791, "seek": 268732, "start": 2696.92, "end": 2698.6800000000003, "text": " the interaction becomes strongly coupled", "tokens": [50845, 264, 9285, 3643, 10613, 29482, 50933], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 792, "seek": 268732, "start": 2698.6800000000003, "end": 2702.32, "text": " and essentially freezes out, generating a physical mass scale.", "tokens": [50933, 293, 4476, 1737, 12214, 484, 11, 17746, 257, 4001, 2758, 4373, 13, 51115], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 793, "seek": 268732, "start": 2702.44, "end": 2705.98, "text": " This is exactly how the mass of the proton is generated in QCD.", "tokens": [51121, 639, 307, 2293, 577, 264, 2758, 295, 264, 31728, 307, 10833, 294, 1249, 16508, 13, 51298], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 794, "seek": 268732, "start": 2706.44, "end": 2708.1800000000003, "text": " The mass comes from the binding energy.", "tokens": [51321, 440, 2758, 1487, 490, 264, 17359, 2281, 13, 51408], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 795, "seek": 268732, "start": 2708.92, "end": 2711.38, "text": " Quadratic gravity does the exact same thing.", "tokens": [51445, 29619, 25198, 12110, 775, 264, 1900, 912, 551, 13, 51568], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 796, "seek": 268732, "start": 2711.92, "end": 2715.2200000000003, "text": " A weakly coupled interaction at the incredibly high Planck scale", "tokens": [51595, 316, 5336, 356, 29482, 9285, 412, 264, 6252, 1090, 8112, 547, 4373, 51760], "temperature": 0.0, "avg_logprob": -0.1400096806612882, "compression_ratio": 1.7179487179487178, "no_speech_prob": 1.8042222446959522e-12}, {"id": 797, "seek": 271522, "start": 2715.22, "end": 2718.68, "text": " will dynamically generate a strongly coupled mass scale", "tokens": [50365, 486, 43492, 8460, 257, 10613, 29482, 2758, 4373, 50538], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 798, "seek": 271522, "start": 2718.68, "end": 2720.16, "text": " exponentially lower down.", "tokens": [50538, 37330, 3126, 760, 13, 50612], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 799, "seek": 271522, "start": 2720.64, "end": 2724.08, "text": " If the Higgs boson is a composite particle in this framework,", "tokens": [50636, 759, 264, 389, 32555, 30641, 266, 307, 257, 25557, 12359, 294, 341, 8388, 11, 50808], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 800, "seek": 271522, "start": 2724.48, "end": 2727.7999999999997, "text": " its mass is naturally set by this dynamically generated scale,", "tokens": [50828, 1080, 2758, 307, 8195, 992, 538, 341, 43492, 10833, 4373, 11, 50994], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 801, "seek": 271522, "start": 2728.2999999999997, "end": 2729.72, "text": " entirely without fine-tuning.", "tokens": [51019, 7696, 1553, 2489, 12, 83, 37726, 13, 51090], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 802, "seek": 271522, "start": 2730.1, "end": 2732.66, "text": " It elegantly explains why the weak nuclear force", "tokens": [51109, 467, 14459, 3627, 13948, 983, 264, 5336, 8179, 3464, 51237], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 803, "seek": 271522, "start": 2732.66, "end": 2734.2799999999997, "text": " is so much weaker than gravity.", "tokens": [51237, 307, 370, 709, 24286, 813, 12110, 13, 51318], "temperature": 0.0, "avg_logprob": -0.18959503424795052, "compression_ratio": 1.592964824120603, "no_speech_prob": 1.7007739617699857e-12}, {"id": 804, "seek": 273428, "start": 2734.28, "end": 2736.76, "text": " Okay, I have to step in here and play the heavy skeptic", "tokens": [50365, 1033, 11, 286, 362, 281, 1823, 294, 510, 293, 862, 264, 4676, 19128, 299, 50489], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 805, "seek": 273428, "start": 2736.76, "end": 2738.94, "text": " because this sounds way too good to be true.", "tokens": [50489, 570, 341, 3263, 636, 886, 665, 281, 312, 2074, 13, 50598], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 806, "seek": 273428, "start": 2739.34, "end": 2741.42, "text": " You're telling me we drop one single assumption", "tokens": [50618, 509, 434, 3585, 385, 321, 3270, 472, 2167, 15302, 50722], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 807, "seek": 273428, "start": 2741.42, "end": 2742.7400000000002, "text": " about positive inner products", "tokens": [50722, 466, 3353, 7284, 3383, 50788], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 808, "seek": 273428, "start": 2742.7400000000002, "end": 2744.46, "text": " and suddenly we don't need 11 dimensions,", "tokens": [50788, 293, 5800, 321, 500, 380, 643, 2975, 12819, 11, 50874], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 809, "seek": 273428, "start": 2744.76, "end": 2746.78, "text": " we solve quantum gravity in four dimensions,", "tokens": [50889, 321, 5039, 13018, 12110, 294, 1451, 12819, 11, 50990], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 810, "seek": 273428, "start": 2747.2400000000002, "end": 2748.6600000000003, "text": " we explain asymptotic freedom,", "tokens": [51013, 321, 2903, 35114, 9411, 5645, 11, 51084], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 811, "seek": 273428, "start": 2748.88, "end": 2750.6600000000003, "text": " and we solve the Higgs hierarchy problem.", "tokens": [51095, 293, 321, 5039, 264, 389, 32555, 22333, 1154, 13, 51184], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 812, "seek": 273428, "start": 2751.32, "end": 2752.0600000000004, "text": " As a journalist,", "tokens": [51217, 1018, 257, 17277, 11, 51254], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 813, "seek": 273428, "start": 2752.26, "end": 2754.34, "text": " whenever a theorist presents a perfect solution", "tokens": [51264, 5699, 257, 27423, 468, 13533, 257, 2176, 3827, 51368], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 814, "seek": 273428, "start": 2754.34, "end": 2755.96, "text": " that overturns 50 years of work,", "tokens": [51368, 300, 42865, 82, 2625, 924, 295, 589, 11, 51449], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 815, "seek": 273428, "start": 2756.3, "end": 2758.36, "text": " my immediate instinct is to look for the catch.", "tokens": [51466, 452, 11629, 16556, 307, 281, 574, 337, 264, 3745, 13, 51569], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 816, "seek": 273428, "start": 2758.5400000000004, "end": 2759.0600000000004, "text": " As you should.", "tokens": [51578, 1018, 291, 820, 13, 51604], "temperature": 0.0, "avg_logprob": -0.15361110308698114, "compression_ratio": 1.5993589743589745, "no_speech_prob": 2.159157618322749e-12}, {"id": 817, "seek": 275906, "start": 2759.06, "end": 2762.0, "text": " How do we know this new ghost parody firewall idea", "tokens": [50365, 1012, 360, 321, 458, 341, 777, 8359, 43386, 36109, 1558, 50512], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 818, "seek": 275906, "start": 2762.0, "end": 2763.94, "text": " isn't just another mathematical fiction?", "tokens": [50512, 1943, 380, 445, 1071, 18894, 13266, 30, 50609], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 819, "seek": 275906, "start": 2764.64, "end": 2766.5, "text": " How do we know Fliction and Turok", "tokens": [50644, 1012, 360, 321, 458, 3235, 4105, 293, 314, 7052, 74, 50737], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 820, "seek": 275906, "start": 2766.5, "end": 2768.7599999999998, "text": " aren't just inventing a new math trick", "tokens": [50737, 3212, 380, 445, 7962, 278, 257, 777, 5221, 4282, 50850], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 821, "seek": 275906, "start": 2768.7599999999998, "end": 2770.84, "text": " that is equally disconnected from reality", "tokens": [50850, 300, 307, 12309, 29426, 490, 4103, 50954], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 822, "seek": 275906, "start": 2770.84, "end": 2772.46, "text": " as a 10-dimensional string?", "tokens": [50954, 382, 257, 1266, 12, 18759, 6798, 30, 51035], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 823, "seek": 275906, "start": 2772.64, "end": 2774.94, "text": " That is the critical essential question.", "tokens": [51044, 663, 307, 264, 4924, 7115, 1168, 13, 51159], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 824, "seek": 275906, "start": 2775.56, "end": 2776.64, "text": " And to Fliction's credit,", "tokens": [51190, 400, 281, 3235, 4105, 311, 5397, 11, 51244], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 825, "seek": 275906, "start": 2777.14, "end": 2779.7799999999997, "text": " the paper is very upfront about falsifiability.", "tokens": [51269, 264, 3035, 307, 588, 30264, 466, 16720, 17638, 2310, 13, 51401], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 826, "seek": 275906, "start": 2780.5, "end": 2783.5, "text": " The derived interface conjecture must be testable.", "tokens": [51437, 440, 18949, 9226, 416, 1020, 540, 1633, 312, 1500, 712, 13, 51587], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 827, "seek": 275906, "start": 2783.7799999999997, "end": 2785.6, "text": " It cannot be a just-so story.", "tokens": [51601, 467, 2644, 312, 257, 445, 12, 539, 1657, 13, 51692], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 828, "seek": 275906, "start": 2786.12, "end": 2787.68, "text": " Right now, Turok and Bateman", "tokens": [51718, 1779, 586, 11, 314, 7052, 74, 293, 10066, 15023, 51796], "temperature": 0.0, "avg_logprob": -0.14494657516479492, "compression_ratio": 1.588235294117647, "no_speech_prob": 2.55426756134991e-12}, {"id": 829, "seek": 278768, "start": 2787.68, "end": 2788.8799999999997, "text": " have rigorously proven", "tokens": [50365, 362, 42191, 5098, 12785, 50425], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 830, "seek": 278768, "start": 2788.8799999999997, "end": 2790.68, "text": " that this ghost parody symmetry", "tokens": [50425, 300, 341, 8359, 43386, 25440, 50515], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 831, "seek": 278768, "start": 2790.68, "end": 2792.74, "text": " perfectly cancels the ghosts", "tokens": [50515, 6239, 393, 66, 1625, 264, 21744, 50618], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 832, "seek": 278768, "start": 2792.74, "end": 2795.68, "text": " in what is called the scalar conformal sector.", "tokens": [50618, 294, 437, 307, 1219, 264, 39684, 18975, 304, 6977, 13, 50765], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 833, "seek": 278768, "start": 2796.0, "end": 2796.62, "text": " Let me guess.", "tokens": [50781, 961, 385, 2041, 13, 50812], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 834, "seek": 278768, "start": 2796.74, "end": 2798.06, "text": " The scalar conformal sector", "tokens": [50818, 440, 39684, 18975, 304, 6977, 50884], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 835, "seek": 278768, "start": 2798.06, "end": 2800.44, "text": " is a highly simplified mathematical sandbox", "tokens": [50884, 307, 257, 5405, 26335, 18894, 42115, 51003], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 836, "seek": 278768, "start": 2800.44, "end": 2802.2799999999997, "text": " that doesn't fully represent", "tokens": [51003, 300, 1177, 380, 4498, 2906, 51095], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 837, "seek": 278768, "start": 2802.2799999999997, "end": 2803.8999999999996, "text": " the messy reality of the universe.", "tokens": [51095, 264, 16191, 4103, 295, 264, 6445, 13, 51176], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 838, "seek": 278768, "start": 2804.06, "end": 2804.54, "text": " You note it.", "tokens": [51184, 509, 3637, 309, 13, 51208], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 839, "seek": 278768, "start": 2805.06, "end": 2806.8999999999996, "text": " It is essentially a simplified toy model.", "tokens": [51234, 467, 307, 4476, 257, 26335, 12058, 2316, 13, 51326], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 840, "seek": 278768, "start": 2807.5, "end": 2808.8199999999997, "text": " It represents the part of gravity", "tokens": [51356, 467, 8855, 264, 644, 295, 12110, 51422], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 841, "seek": 278768, "start": 2808.8199999999997, "end": 2810.3399999999997, "text": " that deals with conformal stretching,", "tokens": [51422, 300, 11215, 365, 18975, 304, 19632, 11, 51498], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 842, "seek": 278768, "start": 2810.3399999999997, "end": 2812.08, "text": " but it entirely ignores", "tokens": [51498, 457, 309, 7696, 5335, 2706, 51585], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 843, "seek": 278768, "start": 2812.08, "end": 2814.3999999999996, "text": " the complex tensor twistings of space-time.", "tokens": [51585, 264, 3997, 40863, 8203, 1109, 295, 1901, 12, 3766, 13, 51701], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 844, "seek": 278768, "start": 2815.14, "end": 2815.8799999999997, "text": " In the toy model,", "tokens": [51738, 682, 264, 12058, 2316, 11, 51775], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 845, "seek": 278768, "start": 2816.12, "end": 2817.4199999999996, "text": " the firewall holds perfectly.", "tokens": [51787, 264, 36109, 9190, 6239, 13, 51852], "temperature": 0.0, "avg_logprob": -0.14871016732097542, "compression_ratio": 1.7910958904109588, "no_speech_prob": 2.149952741878347e-12}, {"id": 846, "seek": 281768, "start": 2817.68, "end": 2818.98, "text": " The ghost never escapes.", "tokens": [50365, 440, 8359, 1128, 43769, 13, 50430], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 847, "seek": 281768, "start": 2819.1, "end": 2820.98, "text": " But the real universe isn't a toy model.", "tokens": [50436, 583, 264, 957, 6445, 1943, 380, 257, 12058, 2316, 13, 50530], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 848, "seek": 281768, "start": 2821.2, "end": 2822.3999999999996, "text": " What happens when you apply it", "tokens": [50541, 708, 2314, 562, 291, 3079, 309, 50601], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 849, "seek": 281768, "start": 2822.3999999999996, "end": 2823.94, "text": " to the full complexity of gravity?", "tokens": [50601, 281, 264, 1577, 14024, 295, 12110, 30, 50678], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 850, "seek": 281768, "start": 2824.2999999999997, "end": 2827.18, "text": " That is the multi-million dollar open question", "tokens": [50696, 663, 307, 264, 4825, 12, 40388, 7241, 1269, 1168, 50840], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 851, "seek": 281768, "start": 2827.18, "end": 2828.7599999999998, "text": " in theoretical physics right now.", "tokens": [50840, 294, 20864, 10649, 558, 586, 13, 50919], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 852, "seek": 281768, "start": 2829.18, "end": 2830.56, "text": " The unproven frontier", "tokens": [50940, 440, 517, 4318, 553, 35853, 51009], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 853, "seek": 281768, "start": 2830.56, "end": 2832.8799999999997, "text": " is whether this exact ghost parody symmetry", "tokens": [51009, 307, 1968, 341, 1900, 8359, 43386, 25440, 51125], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 854, "seek": 281768, "start": 2832.8799999999997, "end": 2836.02, "text": " holds true for the full spin-two tensor theory", "tokens": [51125, 9190, 2074, 337, 264, 1577, 6060, 12, 20534, 40863, 5261, 51282], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 855, "seek": 281768, "start": 2836.02, "end": 2837.08, "text": " of quadratic gravity.", "tokens": [51282, 295, 37262, 12110, 13, 51335], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 856, "seek": 281768, "start": 2837.64, "end": 2840.46, "text": " The math for that is excruciatingly complex,", "tokens": [51363, 440, 5221, 337, 300, 307, 1624, 894, 537, 990, 356, 3997, 11, 51504], "temperature": 0.0, "avg_logprob": -0.20490008762904577, "compression_ratio": 1.5934959349593496, "no_speech_prob": 2.826628904897821e-12}, {"id": 857, "seek": 284046, "start": 2840.46, "end": 2842.48, "text": " and no one has completely solved it yet.", "tokens": [50365, 293, 572, 472, 575, 2584, 13041, 309, 1939, 13, 50466], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 858, "seek": 284046, "start": 2843.06, "end": 2845.8, "text": " If physicists run the math on the full spin-two tensor", "tokens": [50495, 759, 48716, 1190, 264, 5221, 322, 264, 1577, 6060, 12, 20534, 40863, 50632], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 859, "seek": 284046, "start": 2845.8, "end": 2847.3, "text": " and they find that the positive", "tokens": [50632, 293, 436, 915, 300, 264, 3353, 50707], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 860, "seek": 284046, "start": 2847.3, "end": 2848.6, "text": " and negative sectors mix,", "tokens": [50707, 293, 3671, 18373, 2890, 11, 50772], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 861, "seek": 284046, "start": 2849.04, "end": 2850.94, "text": " if the firewall fails under the pressure", "tokens": [50794, 498, 264, 36109, 18199, 833, 264, 3321, 50889], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 862, "seek": 284046, "start": 2850.94, "end": 2852.2400000000002, "text": " of full space-time curvature,", "tokens": [50889, 295, 1577, 1901, 12, 3766, 37638, 11, 50954], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 863, "seek": 284046, "start": 2852.68, "end": 2854.66, "text": " then the ghost bleeds through the interface", "tokens": [50976, 550, 264, 8359, 5408, 5147, 807, 264, 9226, 51075], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 864, "seek": 284046, "start": 2854.66, "end": 2856.18, "text": " into the observable universe.", "tokens": [51075, 666, 264, 9951, 712, 6445, 13, 51151], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 865, "seek": 284046, "start": 2857.04, "end": 2859.42, "text": " Negative probabilities appear in real calculations,", "tokens": [51194, 43230, 33783, 4204, 294, 957, 20448, 11, 51313], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 866, "seek": 284046, "start": 2859.86, "end": 2860.86, "text": " the universe explodes,", "tokens": [51335, 264, 6445, 42610, 11, 51385], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 867, "seek": 284046, "start": 2860.98, "end": 2862.94, "text": " and this entire theory dies instantly.", "tokens": [51391, 293, 341, 2302, 5261, 2714, 13518, 13, 51489], "temperature": 0.0, "avg_logprob": -0.19317069708132276, "compression_ratio": 1.6747967479674797, "no_speech_prob": 1.943042081398172e-12}, {"id": 868, "seek": 286294, "start": 2862.94, "end": 2864.1, "text": " Oh, I love that.", "tokens": [50365, 876, 11, 286, 959, 300, 13, 50423], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 869, "seek": 286294, "start": 2864.2200000000003, "end": 2865.58, "text": " I actually deeply respect that.", "tokens": [50429, 286, 767, 8760, 3104, 300, 13, 50497], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 870, "seek": 286294, "start": 2865.66, "end": 2866.7000000000003, "text": " It is highly testable.", "tokens": [50501, 467, 307, 5405, 1500, 712, 13, 50553], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 871, "seek": 286294, "start": 2867.02, "end": 2868.6, "text": " It's not hiding in another dimension", "tokens": [50569, 467, 311, 406, 10596, 294, 1071, 10139, 50648], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 872, "seek": 286294, "start": 2868.6, "end": 2869.84, "text": " where we can never build a collider", "tokens": [50648, 689, 321, 393, 1128, 1322, 257, 1263, 1438, 50710], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 873, "seek": 286294, "start": 2869.84, "end": 2870.78, "text": " big enough to see it.", "tokens": [50710, 955, 1547, 281, 536, 309, 13, 50757], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 874, "seek": 286294, "start": 2870.86, "end": 2872.1, "text": " It's right there in the math", "tokens": [50761, 467, 311, 558, 456, 294, 264, 5221, 50823], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 875, "seek": 286294, "start": 2872.1, "end": 2873.18, "text": " waiting to be solved.", "tokens": [50823, 3806, 281, 312, 13041, 13, 50877], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 876, "seek": 286294, "start": 2873.4, "end": 2874.58, "text": " If the symmetry breaks,", "tokens": [50888, 759, 264, 25440, 9857, 11, 50947], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 877, "seek": 286294, "start": 2874.86, "end": 2875.82, "text": " the theory is dead.", "tokens": [50961, 264, 5261, 307, 3116, 13, 51009], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 878, "seek": 286294, "start": 2876.08, "end": 2876.52, "text": " Exactly.", "tokens": [51022, 7587, 13, 51044], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 879, "seek": 286294, "start": 2876.92, "end": 2878.82, "text": " It makes a definitive mathematical prediction", "tokens": [51064, 467, 1669, 257, 28152, 18894, 17630, 51159], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 880, "seek": 286294, "start": 2878.82, "end": 2880.46, "text": " that can be unequivocally proven", "tokens": [51159, 300, 393, 312, 2251, 358, 592, 905, 379, 12785, 51241], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 881, "seek": 286294, "start": 2880.46, "end": 2882.04, "text": " or disproven by calculation", "tokens": [51241, 420, 717, 4318, 553, 538, 17108, 51320], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 882, "seek": 286294, "start": 2882.04, "end": 2883.04, "text": " in the coming years.", "tokens": [51320, 294, 264, 1348, 924, 13, 51370], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 883, "seek": 286294, "start": 2883.42, "end": 2884.9, "text": " But assuming the math holds up,", "tokens": [51389, 583, 11926, 264, 5221, 9190, 493, 11, 51463], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 884, "seek": 286294, "start": 2885.1, "end": 2886.04, "text": " and given the pedigree", "tokens": [51473, 293, 2212, 264, 5670, 328, 701, 51520], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 885, "seek": 286294, "start": 2886.04, "end": 2887.58, "text": " of the physicists working on this,", "tokens": [51520, 295, 264, 48716, 1364, 322, 341, 11, 51597], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 886, "seek": 286294, "start": 2887.68, "end": 2889.1, "text": " there is a strong chance it does,", "tokens": [51602, 456, 307, 257, 2068, 2931, 309, 775, 11, 51673], "temperature": 0.0, "avg_logprob": -0.14264377666886446, "compression_ratio": 1.6948051948051948, "no_speech_prob": 2.2407824293996237e-12}, {"id": 887, "seek": 288910, "start": 2889.1, "end": 2892.46, "text": " the payoff for exploring this route is immense.", "tokens": [50365, 264, 46547, 337, 12736, 341, 7955, 307, 22920, 13, 50533], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 888, "seek": 288910, "start": 2892.8399999999997, "end": 2894.54, "text": " Because if we look at the appendices", "tokens": [50552, 1436, 498, 321, 574, 412, 264, 34116, 1473, 50637], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 889, "seek": 288910, "start": 2894.54, "end": 2895.56, "text": " of Fliction's paper,", "tokens": [50637, 295, 3235, 4105, 311, 3035, 11, 50688], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 890, "seek": 288910, "start": 2896.1, "end": 2897.24, "text": " they detail what happens", "tokens": [50715, 436, 2607, 437, 2314, 50772], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 891, "seek": 288910, "start": 2897.24, "end": 2899.2599999999998, "text": " when you apply these ideas backward in time", "tokens": [50772, 562, 291, 3079, 613, 3487, 23897, 294, 565, 50873], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 892, "seek": 288910, "start": 2899.2599999999998, "end": 2901.08, "text": " to the origin of the universe itself.", "tokens": [50873, 281, 264, 4957, 295, 264, 6445, 2564, 13, 50964], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 893, "seek": 288910, "start": 2901.4, "end": 2902.68, "text": " And it seems to solve", "tokens": [50980, 400, 309, 2544, 281, 5039, 51044], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 894, "seek": 288910, "start": 2902.68, "end": 2904.06, "text": " almost every major mystery", "tokens": [51044, 1920, 633, 2563, 11422, 51113], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 895, "seek": 288910, "start": 2904.06, "end": 2906.36, "text": " in modern cosmology in one fell swoop.", "tokens": [51113, 294, 4363, 22207, 1793, 294, 472, 5696, 13291, 404, 13, 51228], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 896, "seek": 288910, "start": 2906.48, "end": 2906.7, "text": " Yes.", "tokens": [51234, 1079, 13, 51245], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 897, "seek": 288910, "start": 2907.18, "end": 2908.8399999999997, "text": " The appendices outline the current state", "tokens": [51269, 440, 34116, 1473, 16387, 264, 2190, 1785, 51352], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 898, "seek": 288910, "start": 2908.8399999999997, "end": 2910.74, "text": " of the Boyle and Turok research program,", "tokens": [51352, 295, 264, 9486, 306, 293, 314, 7052, 74, 2132, 1461, 11, 51447], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 899, "seek": 288910, "start": 2911.2, "end": 2912.54, "text": " and the cosmological payoff", "tokens": [51470, 293, 264, 22207, 4383, 46547, 51537], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 900, "seek": 288910, "start": 2912.54, "end": 2914.12, "text": " is truly elegant.", "tokens": [51537, 307, 4908, 21117, 13, 51616], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 901, "seek": 288910, "start": 2914.52, "end": 2915.48, "text": " It is a masterpiece", "tokens": [51636, 467, 307, 257, 32208, 51684], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 902, "seek": 288910, "start": 2915.48, "end": 2916.66, "text": " of theoretical deduction.", "tokens": [51684, 295, 20864, 46385, 13, 51743], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 903, "seek": 288910, "start": 2916.7999999999997, "end": 2917.68, "text": " Let's dive into that.", "tokens": [51750, 961, 311, 9192, 666, 300, 13, 51794], "temperature": 0.0, "avg_logprob": -0.1948185237586921, "compression_ratio": 1.6480263157894737, "no_speech_prob": 2.1426048869149783e-12}, {"id": 904, "seek": 291768, "start": 2917.68, "end": 2920.2799999999997, "text": " Let's unpack the Boyle and Turok program for us.", "tokens": [50365, 961, 311, 26699, 264, 9486, 306, 293, 314, 7052, 74, 1461, 337, 505, 13, 50495], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 905, "seek": 291768, "start": 2920.5, "end": 2921.96, "text": " The paper talks about something called", "tokens": [50506, 440, 3035, 6686, 466, 746, 1219, 50579], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 906, "seek": 291768, "start": 2921.96, "end": 2923.8999999999996, "text": " a dimension zero scalar field.", "tokens": [50579, 257, 10139, 4018, 39684, 2519, 13, 50676], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 907, "seek": 291768, "start": 2924.04, "end": 2924.6, "text": " What is that?", "tokens": [50683, 708, 307, 300, 30, 50711], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 908, "seek": 291768, "start": 2924.8799999999997, "end": 2925.96, "text": " In quantum field theory,", "tokens": [50725, 682, 13018, 2519, 5261, 11, 50779], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 909, "seek": 291768, "start": 2926.24, "end": 2927.98, "text": " fields usually have a mass dimension,", "tokens": [50793, 7909, 2673, 362, 257, 2758, 10139, 11, 50880], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 910, "seek": 291768, "start": 2928.52, "end": 2930.18, "text": " which dictates how they scale", "tokens": [50907, 597, 12569, 1024, 577, 436, 4373, 50990], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 911, "seek": 291768, "start": 2930.18, "end": 2931.6, "text": " when you stretch or shrink", "tokens": [50990, 562, 291, 5985, 420, 23060, 51061], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 912, "seek": 291768, "start": 2931.6, "end": 2932.96, "text": " the geometry of space-time.", "tokens": [51061, 264, 18426, 295, 1901, 12, 3766, 13, 51129], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 913, "seek": 291768, "start": 2933.6, "end": 2935.08, "text": " An ordinary scalar field,", "tokens": [51161, 1107, 10547, 39684, 2519, 11, 51235], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 914, "seek": 291768, "start": 2935.22, "end": 2936.3399999999997, "text": " like the Higgs-Boson field,", "tokens": [51242, 411, 264, 389, 32555, 12, 33, 329, 266, 2519, 11, 51298], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 915, "seek": 291768, "start": 2936.56, "end": 2938.04, "text": " has a mass dimension of one.", "tokens": [51309, 575, 257, 2758, 10139, 295, 472, 13, 51383], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 916, "seek": 291768, "start": 2938.6, "end": 2940.5, "text": " It transforms in a specific way", "tokens": [51411, 467, 35592, 294, 257, 2685, 636, 51506], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 917, "seek": 291768, "start": 2940.5, "end": 2941.7999999999997, "text": " under Weill rescalings,", "tokens": [51506, 833, 492, 373, 9610, 304, 1109, 11, 51571], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 918, "seek": 291768, "start": 2942.14, "end": 2943.7799999999997, "text": " which is mathematical jargon", "tokens": [51588, 597, 307, 18894, 15181, 10660, 51670], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 919, "seek": 291768, "start": 2943.7799999999997, "end": 2945.52, "text": " for changing the local scale of distance.", "tokens": [51670, 337, 4473, 264, 2654, 4373, 295, 4560, 13, 51757], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 920, "seek": 291768, "start": 2946.4199999999996, "end": 2947.2999999999997, "text": " Boyle and Turok", "tokens": [51802, 9486, 306, 293, 314, 7052, 74, 51846], "temperature": 0.0, "avg_logprob": -0.19525155385335285, "compression_ratio": 1.681063122923588, "no_speech_prob": 2.3254852904441847e-12}, {"id": 921, "seek": 294730, "start": 2947.3, "end": 2949.32, "text": " introduced a new mathematical object.", "tokens": [50365, 7268, 257, 777, 18894, 2657, 13, 50466], "temperature": 0.0, "avg_logprob": -0.22621084686018464, "compression_ratio": 1.6347517730496455, "no_speech_prob": 1.405012716414189e-12}, {"id": 922, "seek": 294730, "start": 2950.0600000000004, "end": 2951.98, "text": " Dimension zero scalar fields.", "tokens": [50503, 20975, 3378, 4018, 39684, 7909, 13, 50599], "temperature": 0.0, "avg_logprob": -0.22621084686018464, "compression_ratio": 1.6347517730496455, "no_speech_prob": 1.405012716414189e-12}, {"id": 923, "seek": 294730, "start": 2952.42, "end": 2954.2200000000003, "text": " These are fields whose mathematical action", "tokens": [50621, 1981, 366, 7909, 6104, 18894, 3069, 50711], "temperature": 0.0, "avg_logprob": -0.22621084686018464, "compression_ratio": 1.6347517730496455, "no_speech_prob": 1.405012716414189e-12}, {"id": 924, "seek": 294730, "start": 2954.2200000000003, "end": 2956.1000000000004, "text": " is based on a fourth-order operator.", "tokens": [50711, 307, 2361, 322, 257, 6409, 12, 4687, 12973, 13, 50805], "temperature": 0.0, "